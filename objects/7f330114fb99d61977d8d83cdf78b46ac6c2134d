             and all(row["parseStatus"] == "JSON_OBJECT" and row["trailingLF"] for row in selected)
             and all(bindings.values()) and profile_valid, "CPU_FINISHED_REQUIRED_FILES")
        need(collection.get("profile") == finished.get("profile")
             and collection.get("routes") == stopped.get("routes") == finished.get("routes")
             and collection.get("selection") == stopped.get("selection") == finished.get("selection")
             and collection.get("points") == finished.get("points")
             and type(collection.get("cleanupFailed")) is bool
             and collection.get("cleanupFailed") == stopped.get("cleanupFailed") == finished.get("cleanupFailed")
             and collection.get("cause") == stopped.get("cause") == finished.get("cause")
             and collection.get("cause") in ("target", "window", "final")
             and collection.get("state") == finished.get("state")
             and type(finished.get("collectionWithinAccept")) is bool
             and collection.get("profileCapBytes") == CORE_CAP["profile"]
             and collection.get("collectionCapBytes") == CORE_CAP["collection"],
             "CPU_FILE_AND_POST_CLOSE_EVENT_PARITY")
        for name, event_file in (("preview-first.cpuprofile", finished.get("profile", {})),
                                 ("collection.json", finished.get("collection", {}))):
            need(event_file.get("name") == name and event_file.get("bytes") == len(raw_files[name])
                 and event_file.get("sha256") == digest(raw_files[name]), "CPU_POST_CLOSE_FILE_HASH")
            need(type(event_file.get("fsyncTenthMs")) is int
                 and type(event_file.get("closeTenthMs")) is int
                 and 0 <= event_file["fsyncTenthMs"] <= event_file["closeTenthMs"] <= 999999999,
                 "CPU_POST_CLOSE_FILE_TIMES")
            post_close_files.append(name)
        points = collection["points"]
        point_names = ["frameStart", "startEnter", "startReturn", "stopCheckpoint", "stopEnter", "stopReturn",
                       "serializeEnter", "serializeReturn", "profileWriteEnter", "profileFsync", "profileClose"]
        need(isinstance(points, dict) and set(points) == set(point_names)
             and all(type(points[name]) is int and 0 <= points[name] <= 999999999 for name in point_names)
             and all(points[left] <= points[right] for left, right in zip(point_names, point_names[1:])),
             "CPU_POINT_ORDER")
        need(all(started["points"].get(name) == points[name] for name in point_names[:3])
             and all(stopped["points"].get(name) == points[name] for name in point_names[:6])
             and points["profileFsync"] == finished["profile"]["fsyncTenthMs"]
             and points["profileClose"] == finished["profile"]["closeTenthMs"]
             and points["profileClose"] <= finished["collection"]["fsyncTenthMs"],
             "CPU_POST_CLOSE_POINT_PARITY")
        temporal_profile = points["profileClose"] - points["frameStart"] < 55000 * 10
        short = collection["cause"] == "final" and points["stopCheckpoint"] - points["frameStart"] < 50000 * 10
        expected_state = "short-completed" if short else "completed-on-time" if temporal_profile else "completed-late"
        within_accept = temporal_profile and finished["collection"]["closeTenthMs"] - points["frameStart"] < 55000 * 10
        need(collection["state"] == expected_state and finished["collectionWithinAccept"] == within_accept,
             "CPU_OBSERVED_TEMPORAL_STATE")
        need(len(nodes) == stopped.get("nodesBounded") and len(samples) == stopped.get("samplesBounded")
             and collection.get("native") == native, "CPU_NATIVE_COLLECTION_PARITY")
        capture_complete = True
    state = finished.get("state") if finished is not None else None
    profile_present, collection_present = ("preview-first.cpuprofile" in raw_files, "collection.json" in raw_files)
    presence_state = ("profile-and-collection" if profile_present and collection_present else
                      "profile-only" if profile_present else "collection-only" if collection_present else "neither")
    RECEIPT["parsers"]["cpu"] = {
        "originalFiles": selected, "presence": presence, "presenceState": presence_state,
        "markerBytes": len(marker_data["cpuRaw"]), "markerSha256": digest(marker_data["cpuRaw"]),
        "caseMembership": marker_data["cpuMemberships"], "kinds": [event["kind"] for event in events],
        "pid": CPU["pid"], "parentPid": CPU["parentPid"], "nonce": CPU["nonce"],
        "runtime": expected_runtime, "intervalUs": 5000, "targetMs": 50000, "acceptMs": 55000,
        "startedPoints": start_points, "startedUtcMs": started.get("utcMs"),
        "state": state, "captureComplete": capture_complete,
        "finishedRecordPresent": finished is not None, "postCloseFilesVerified": post_close_files,
        "selectedFileBindings": bindings, "collectionProfileBytesMatched": collection_profile_binding,
        "collectionRoutes": collection.get("routes") if collection is not None else None,
        "collectionSelection": collection.get("selection") if collection is not None else None,
        "collectionSelectionValid": collection_selection_valid,
        "profileSchemaValid": profile_valid, "native": native,
        "collectionWithinAccept": finished.get("collectionWithinAccept") if capture_complete else None,
        "limits": ["Raw existing profile/collection/launcher bytes are exported whole, including empty or malformed files.",
                   "Zero bytes is a present inventory file with the empty SHA256, not an absent-file placeholder.",
                   "A ZIP CRC/hash proves received bytes, not producer fsync/close; only a later verified finished can attest that.",
                   "Collection contents alone do not attest their own close, even when its JSON and profile hash are valid.",
                   "Malformed JSON, missing LF or missing files remains explicit negative evidence and never capture completion.",
                   "Whole-VM samples include unrelated backend work; no exclusive/async/browser/child-process cost is inferred.",
                   "No samples*5ms estimate, causal bottleneck or product qualification is inferred.",
                   "Started precedes HTTP authorization; runtime stream binding is not product admission.",
                   "Progress finished is not CPU finished; progress cannot attest profile or collection close.",
                   "Route snapshots are PID-running-window aggregates, not Request counts or completed work.",
                   "Selection closed parity is collection/stopped/finished only; later HTTP progress is not a close receipt.",
                   "Source token decisions and all-surface native copied-child pairs have distinct populations; no conservation or fallback rate is inferred.",
                   "Native pairs exclude top-level materializations and copies that threw before completion; the CPU profile may still include them.",
                   "All clocks retain their domains; no reconciliation with Playwright startTime/duration."],
    }
    checked("cpu_all_populations_inventory_optional_raw_files_and_explicit_completion")
    return raw_files

def ensure_inventory():
    if "inventory" not in RECEIPT:
        inventory = {"schema": 1, "archives": ARCHIVES, "files": FILES}
        RECEIPT["inventory"] = save_json("derived/inventory.json", inventory)
    return RECEIPT["inventory"]

def prepare_core_export(key, name, raw, mime, original, original_file=None):
    need(key in CORE_CAP and isinstance(raw, bytes) and len(raw) <= CORE_CAP[key],
         "CORE_RAW_CAP_" + key)
    if original:
        need(key in ("profile", "collection", "launcher") and type(original_file) is int
             and 0 <= original_file < len(FILES), "CORE_ORIGINAL_INVENTORY_BINDING")
        item = FILES[original_file]
        need(not item["directory"] and item["id"] == original_file
             and item["bytes"] == len(raw) and item["sha256"] == digest(raw),
             "CORE_ORIGINAL_INVENTORY_BYTES")
    else:
        need(original_file is None and len(raw) > 0, "CORE_DERIVED_NONEMPTY")
    encoded = base64.b64encode(raw).decode("ascii")
    pieces = ([encoded[i:i + CAP["chunkBytes"]] for i in range(0, len(encoded), CAP["chunkBytes"])]
              if encoded else [""])
    metadata = {"name": name, "bytes": len(raw), "sha256": digest(raw), "mime": mime,
                "original": original, "encoding": "base64", "chunks": len(pieces)}
    if original:
        metadata["file"] = original_file
    lines = []
    for index, piece in enumerate(pieces, 1):
        envelope = {"schema": 1, **metadata, "index": index}
        # Bound all metadata plus empty data and transport prefix/LF, not just one field.
        need(len(wire_line("SF613_ARTIFACT_BYTES", {**envelope, "data": ""})) <= 1024,
             "CORE_CHUNK_METADATA_CAP")
        need((0 < len(piece) <= CAP["chunkBytes"]) or
             (len(raw) == 0 and original and len(pieces) == 1 and index == 1 and piece == ""),
             "CORE_BASE64_CHUNK_CAP")
        lines.append(wire_line("SF613_ARTIFACT_BYTES", {**envelope, "data": piece}))
    return {"key": key, "metadata": metadata, "lines": lines}

def finalize_core(cpu_raw, markers_raw):
    global CORE_LINES_WRITTEN
    need(set(cpu_raw).issubset(CPU_NAMES), "CPU_CORE_SELECTION_INVALID")
    cpu = RECEIPT["parsers"]["cpu"]
    need(set(cpu_raw) == {item["name"] for item in cpu["originalFiles"]},
         "CPU_CORE_PRESENT_FILES_EXACT")
    inventory = ensure_inventory()
    inventory_raw = (ROOT / inventory["path"]).read_bytes()
    need(len(inventory_raw) == inventory["bytes"] and digest(inventory_raw) == inventory["sha256"],
         "INVENTORY_BYTES_CHANGED")
    RECEIPT["apiReads"] = API_COUNT
    RECEIPT["archiveSummary"] = {
        "archives": len(ARCHIVES), "entries": TOTAL_ENTRIES,
        "crcVerified": sum(1 for row in FILES if row.get("crcVerified")),
        "expandedBytes": TOTAL_EXPANDED,
        "allEntriesVerified": bool(FILES) and all(row.get("crcVerified") is True for row in FILES),
    }
    need(RECEIPT["archiveSummary"]["allEntriesVerified"] is True and not RECEIPT["failures"],
         "CORE_REQUIRED_VALIDATION_FAILURE")
    summary = canonical({
        "schema": 1, "kind": "e11-original-core-summary", "qualification": False,
        "source": SOURCE, "sourceTree": SOURCE_TREE, "snapshot": SNAPSHOT, "snapshotTree": SNAPSHOT_TREE,
        "run": ORIGINAL_RUN, "attempt": ORIGINAL_ATTEMPT, "artifact": RECEIPT["artifact"],
        "selection": RECEIPT["parsers"]["selection"], "runtime": RECEIPT["parsers"]["runtime"],
        "cpuMarkers": RECEIPT["parsers"]["e11Markers"], "cpu": cpu,
        "cpuPopulationInventory": RECEIPT["parsers"]["cpuPopulationInventory"],
        "pending": RECEIPT["pending"],
        "htmlArchives": RECEIPT["parsers"].get("htmlArchives", []),
        "archiveSummary": RECEIPT["archiveSummary"], "limits": RECEIPT["limits"],
    })
    write_bytes(ROOT / "derived" / "safe-summary.json", summary)
    original_by_name = {item["name"]: item for item in cpu["originalFiles"]}
    first_payloads = []
    for key, name, export_name in (
            ("profile", "preview-first.cpuprofile", "original-cpu-preview-first.cpuprofile"),
            ("cpuMarkers", None, "preview-e11-cpu-progress-markers.lf.log"),
            ("collection", "collection.json", "original-cpu-collection.json"),
            ("launcher", "launcher.json", "original-cpu-launcher.json")):
        if name is None:
            first_payloads.append((key, export_name, markers_raw, "text/plain", False, None))
        elif name in cpu_raw:
            item = original_by_name[name]
            mime = "application/json" if item["parseStatus"] == "JSON_OBJECT" else "application/octet-stream"
            first_payloads.append((key, export_name, cpu_raw[name], mime, True, item["file"]))
    first_payloads.extend([
        ("summary", "safe-summary.json", summary, "application/json", False, None),
        ("inventory", "inventory.json", inventory_raw, "application/json", False, None),
    ])
    prepared = [prepare_core_export(*item) for item in first_payloads]
    RECEIPT["coreEmission"] = {
        "state": "PLANNED_REQUIRES_SUCCESS_TERMINAL",
        "order": [item["metadata"]["name"] for item in prepared] + ["receipt.json"],
        "payloadsBeforeReceipt": [item["metadata"] for item in prepared],
        "captureComplete": cpu["captureComplete"],
        "absentFilesHaveNoExport": True,
        "zeroBytes": "One empty base64 chunk with actual inventory file ID, bytes0 and SHA256 of empty bytes.",
        "rawCaps": CORE_CAP, "beforeBytes": LOG_BYTES,
        "exactPreflight": "All actual immutable payloads and the terminal are encoded and jointly checked after this receipt is frozen, before the first core chunk.",
        "completion": "Only the later SF613_ARTIFACT_RECEIPT terminal, every complete hash-verified listed export and a successful reader job attest complete transport; this does not promote captureComplete.",
        "selfReference": "This receipt has no own hash. Its original bytes/hash are attested by the terminal.",
    }
    RECEIPT["readerExitCodePlanned"] = 0
    # Freeze once. No later mutation of this object can alter exported receipt_raw.
    receipt_raw = canonical(RECEIPT)
    prepared.append(prepare_core_export("receipt", "receipt.json", receipt_raw, "application/json", False))
    expected_keys = ([key for key, name in (("profile", "preview-first.cpuprofile"), ("cpuMarkers", None),
                                            ("collection", "collection.json"), ("launcher", "launcher.json"))
                      if name is None or name in cpu_raw] + ["summary", "inventory", "receipt"])
    need([item["key"] for item in prepared] == expected_keys and 4 <= len(prepared) <= 7,
         "CORE_EXACT_PRESENT_EXPORTS")
    core_lines = tuple(line for item in prepared for line in item["lines"])
    core_bytes = sum(len(line) for line in core_lines)
    before_bytes = LOG_BYTES
    final = {
        "schema": 1, "kind": "e11-core-terminal", "qualification": False,
        "status": RECEIPT["status"], "coreBytesComplete": True, "receiptBase64Complete": True,
        "captureComplete": cpu["captureComplete"], "cpuState": cpu["state"],
        "coreFiles": len(prepared), "coreChunks": len(core_lines),
        "corePayloadBytes": sum(item["metadata"]["bytes"] for item in prepared),
        "coreLogBytes": core_bytes, "logBytesBeforeCore": before_bytes,
        "logBytesBeforeTerminal": before_bytes + core_bytes,
        "emitterCapBytes": CAP["logBytes"], "mainLogReviewCapBytes": CAP["mainLogReviewCapBytes"],
        "receiptBytes": len(receipt_raw), "receiptSha256": digest(receipt_raw),
        "exports": [item["metadata"] for item in prepared],
        "entries": TOTAL_ENTRIES, "crcVerified": RECEIPT["archiveSummary"]["crcVerified"],
        "expandedBytes": TOTAL_EXPANDED, "pending": len(RECEIPT["pending"]),
        "failures": [], "readerExitCode": 0,
    }
    terminal_raw = wire_line("SF613_ARTIFACT_RECEIPT", final)
    total_bytes = before_bytes + core_bytes + len(terminal_raw)
    need(total_bytes <= CAP["logBytes"], "CORE_JOINT_LOG_BUDGET")
    plan = {"schema": 1, "coreFiles": len(prepared), "coreChunks": len(core_lines),
            "beforeBytes": before_bytes, "coreLogBytes": core_bytes,
            "terminalBytes": len(terminal_raw), "totalEmitterBytes": total_bytes,
            "capBytes": CAP["logBytes"], "mainLogReviewCapBytes": CAP["mainLogReviewCapBytes"],
            "terminalSha256": digest(terminal_raw), "exports": final["exports"]}
    # Disk preservation also completes before any core line can be emitted.
    write_bytes(ROOT / "receipt.json", receipt_raw)
    save_json("derived/core-emission-plan.json", plan)
    for raw in core_lines:
        write_wire(raw)
        CORE_LINES_WRITTEN += 1
    need(LOG_BYTES == before_bytes + core_bytes and CORE_LINES_WRITTEN == len(core_lines),
         "CORE_EMITTED_COUNT_MISMATCH")
    write_wire(terminal_raw)
    need(LOG_BYTES == total_bytes, "CORE_FINAL_EMITTED_BYTES_MISMATCH")

def report_failure(code, error_type=None):
    # No exception text/traceback: it could contain a signed URL. Never emit a success terminal here.
    failure = {"code": code}
    if error_type is not None:
        failure["type"] = error_type
    RECEIPT["status"] = "RECEIPT_FAILED"
    RECEIPT["failures"].append(failure)
    RECEIPT["readerExitCode"] = 1
    RECEIPT["apiReads"] = API_COUNT
    receipt_meta = None
    try:
        failure_raw = canonical(RECEIPT)
        if len(failure_raw) <= CORE_CAP["receipt"]:
            write_bytes(ROOT / "failure-receipt.json", failure_raw)
            receipt_meta = {"bytes": len(failure_raw), "sha256": digest(failure_raw)}
    except Exception:
        pass
    terminal = {
        "schema": 1, "kind": "e11-core-terminal", "qualification": False, "status": "RECEIPT_FAILED",
        "coreBytesComplete": False, "receiptBase64Complete": False, "readerExitCode": 1,
        "coreChunksWritten": CORE_LINES_WRITTEN, "logBytesBeforeTerminal": LOG_BYTES,
        "failures": [failure], "failureReceipt": receipt_meta,
        "limit": "No complete transport is accepted without every listed present payload, success terminal and successful job; capture completion is separate.",
    }
    try:
        write_wire(wire_line("SF613_ARTIFACT_RECEIPT", terminal))
    except Exception:
        # A broken stdout may prevent even a failure terminal; process exit remains nonzero.
        pass

