def storage_url_allowed(url):
    value = urllib.parse.urlsplit(url)
    host = (value.hostname or "").lower()
    suffixes = (".blob.core.windows.net", ".githubusercontent.com", ".amazonaws.com")
    return (value.scheme == "https" and not value.username and not value.password
            and value.port in (None, 443) and any(host.endswith(suffix) for suffix in suffixes))

def download_original():
    request = urllib.request.Request(
        "https://api.github.com/repos/" + REPO + "/actions/artifacts/" + str(ARTIFACT_ID) + "/zip",
        headers={"Authorization": "Bearer " + TOKEN, "Accept": "application/vnd.github+json",
                 "X-GitHub-Api-Version": "2022-11-28", "User-Agent": "sf613-original-artifact-reader"},
    )
    try:
        response = NO_REDIRECT.open(request, timeout=45)
    except urllib.error.HTTPError as error:
        need(error.code == 302, "ARTIFACT_DOWNLOAD_REDIRECT_REQUIRED")
        location = error.headers.get("Location", "")
        error.close()
    else:
        response.close()
        raise ReceiptFailure("ARTIFACT_DOWNLOAD_REDIRECT_REQUIRED")
    need(storage_url_allowed(location), "ARTIFACT_STORAGE_ORIGIN")
    # A separate request/opener receives no GitHub Authorization, cookie or referer.
    for redirect_count in range(4):
        unsigned = urllib.request.Request(location, headers={"User-Agent": "sf613-original-artifact-reader"})
        try:
            response = NO_REDIRECT.open(unsigned, timeout=120)
        except urllib.error.HTTPError as error:
            need(error.code in (301, 302, 303, 307, 308) and redirect_count < 3,
                 "ARTIFACT_STORAGE_HTTP")
            location = urllib.parse.urljoin(location, error.headers.get("Location", ""))
            error.close()
            need(storage_url_allowed(location), "ARTIFACT_STORAGE_REDIRECT_ORIGIN")
            continue
        except (urllib.error.URLError, TimeoutError):
            raise ReceiptFailure("ARTIFACT_STORAGE_TRANSPORT") from None
        with response:
            need(response.status == 200, "ARTIFACT_STORAGE_STATUS")
            hasher = hashlib.sha256()
            size = 0
            with open(ROOT / "original.zip", "xb") as output:
                while True:
                    block = response.read(1024 * 1024)
                    if not block:
                        break
                    size += len(block)
                    need(size <= ARTIFACT_BYTES, "ARTIFACT_TOO_LARGE")
                    output.write(block)
                    hasher.update(block)
            need(size == ARTIFACT_BYTES and hasher.hexdigest() == ARTIFACT_SHA,
                 "ARTIFACT_BYTES_OR_SHA256")
            RECEIPT["artifact"]["verifiedBytes"] = size
            RECEIPT["artifact"]["verifiedSha256"] = hasher.hexdigest()
            RECEIPT["artifact"]["downloadCount"] = 1
            checked("original_zip_bytes_and_sha256")
            return
    raise ReceiptFailure("ARTIFACT_REDIRECT_CAP")

# Phase 2: read archive bytes only; never use extractall, shell, imports or executable entries.
def path_parts(name, directory):
    need(isinstance(name, str) and name and "\x00" not in name and "\\" not in name
         and not name.startswith("/") and not re.match(r"^[A-Za-z]:", name),
         "ZIP_PATH_INVALID")
    pieces = name.rstrip("/").split("/") if directory else name.split("/")
    need(bool(pieces) and all(part not in ("", ".", "..") for part in pieces),
         "ZIP_PATH_TRAVERSAL")
    need(all(len(part.encode("utf-8")) <= 255 for part in pieces), "ZIP_COMPONENT_CAP")
    need(len(name.encode("utf-8")) <= 4096, "ZIP_PATH_CAP")
    return pieces

def inspect_zip(source_file, label, depth, parent_file=None):
    global TOTAL_EXPANDED, TOTAL_ENTRIES
    need(depth <= CAP["depth"] and len(ARCHIVES) < CAP["archives"], "NESTED_ZIP_CAP")
    archive_index = len(ARCHIVES)
    output_root = ROOT / "originals" / ("archive-" + str(archive_index).zfill(3))
    output_root.mkdir(mode=0o700)
    source_hasher = hashlib.sha256()
    source_size = 0
    with open(source_file, "rb") as original_zip:
        while True:
            block = original_zip.read(1024 * 1024)
            if not block:
                break
            source_hasher.update(block)
            source_size += len(block)
    archive = {"index": archive_index, "label": label, "depth": depth,
               "sourcePath": str(pathlib.Path(source_file).relative_to(ROOT)),
               "sourceBytes": source_size, "sourceSha256": source_hasher.hexdigest(),
               "parentFile": parent_file, "entries": 0, "crcVerified": 0,
               "expandedBytes": 0, "status": "STARTED"}
    ARCHIVES.append(archive)
    nested = []
    with zipfile.ZipFile(source_file, "r") as source:
        entries = source.infolist()
        need(len(entries) + TOTAL_ENTRIES <= CAP["entries"], "ZIP_ENTRY_COUNT_CAP")
        seen = set()
        for entry in entries:
            name = entry.filename
            need(entry.orig_filename == name, "ZIP_RAW_PATH_ALTERED")
            directory = entry.is_dir()
            pieces = path_parts(name, directory)
            normalized = "/".join(pieces)
            need(normalized not in seen, "ZIP_DUPLICATE_PATH")
            seen.add(normalized)
            kind = stat.S_IFMT(entry.external_attr >> 16)
            need(kind in (0, stat.S_IFDIR if directory else stat.S_IFREG),
                 "ZIP_SPECIAL_FILE_OR_SYMLINK")
            need((entry.flag_bits & 1) == 0, "ZIP_ENCRYPTED_ENTRY")
            need(entry.compress_type in (zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED),
                 "ZIP_COMPRESSION_UNSUPPORTED")
            need(0 <= entry.file_size <= CAP["entryBytes"], "ZIP_ENTRY_SIZE_CAP")
            need(TOTAL_EXPANDED + entry.file_size <= CAP["expandedBytes"], "ZIP_EXPANDED_CAP")
            destination = output_root.joinpath(*pieces)
            need(output_root == destination.parent or output_root in destination.parents,
                 "ZIP_DESTINATION_ESCAPE")
            TOTAL_ENTRIES += 1
            file_id = len(FILES)
            item = {
                "id": file_id, "archive": archive_index, "path": name, "directory": directory,
                "compressedBytes": entry.compress_size, "declaredBytes": entry.file_size,
                "expectedCrc32": format(entry.CRC, "08x"),
                "storedPath": str(destination.relative_to(ROOT)),
            }
            FILES.append(item)
            if directory:
                need(entry.file_size == 0 and entry.CRC == 0, "ZIP_DIRECTORY_PAYLOAD")
                with source.open(entry, "r") as original:
                    need(original.read(1) == b"", "ZIP_DIRECTORY_PAYLOAD")
                destination.mkdir(mode=0o700, parents=True, exist_ok=True)
                item.update({"bytes": 0, "sha256": digest(b""), "crc32": "00000000", "crcVerified": True})
            else:
                destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                hasher = hashlib.sha256()
                crc = 0
                size = 0
                # zipfile checks the local header and EOF CRC as well; calculate independently.
                with source.open(entry, "r") as original, open(destination, "xb") as target:
                    while True:
                        block = original.read(1024 * 1024)
                        if not block:
                            break
                        size += len(block)
                        TOTAL_EXPANDED += len(block)
                        need(size <= entry.file_size and size <= CAP["entryBytes"]
                             and TOTAL_EXPANDED <= CAP["expandedBytes"], "ZIP_ACTUAL_EXPANSION_CAP")
                        target.write(block)
                        hasher.update(block)
                        crc = zlib.crc32(block, crc)
                need(size == entry.file_size and (crc & 0xffffffff) == entry.CRC, "ZIP_CRC_OR_SIZE")
                item.update({"bytes": size, "sha256": hasher.hexdigest(),
                             "crc32": format(crc & 0xffffffff, "08x"), "crcVerified": True})
                with open(destination, "rb") as header:
                    magic = header.read(4)
                if name.lower().endswith(".zip") or magic in (b"PK\x03\x04", b"PK\x05\x06"):
                    nested.append((destination, "zip-entry", file_id))
            archive["entries"] += 1
            archive["crcVerified"] += 1
            archive["expandedBytes"] += entry.file_size
    archive["status"] = "CRC_VERIFIED"
    for destination, nested_label, file_id in nested:
        inspect_zip(destination, nested_label, depth + 1, file_id)
    return archive_index

def read_file(item, limit):
    need(not item["directory"] and item["bytes"] <= limit, "PARSER_INPUT_CAP")
    data = (ROOT / item["storedPath"]).read_bytes()
    need(len(data) == item["bytes"] and digest(data) == item["sha256"], "EXTRACTED_FILE_CHANGED")
    return data

def locate_suffix(suffix, outer_only=False):
    rows = [row for row in FILES if not row["directory"]
            and (not outer_only or row["archive"] == 0)
            and (row["path"] == suffix or row["path"].endswith("/" + suffix))]
    return rows

def one_original_json(suffix):
    rows = locate_suffix(suffix, outer_only=True)
    need(len(rows) == 1, "ORIGINAL_JSON_CARDINALITY_" + suffix.replace(".", "_"))
    raw = read_file(rows[0], CAP["jsonBytes"])
    try:
        data = json.loads(raw)
    except (ValueError, UnicodeError):
        raise ReceiptFailure("ORIGINAL_JSON_PARSE") from None
    return rows[0], raw, data

def unpack_html_reports():
    reports = locate_suffix("playwright-report/index.html", outer_only=True)
    if not reports:
        pending("HTML_REPORT_ABSENT")
        return
    parsed = []
    for item in reports:
        raw = read_file(item, CAP["htmlBytes"])
        text = raw.decode("utf-8")
        # Read only the embedded archive string. No HTML/JavaScript is evaluated.
        found = re.findall(r'data:application/zip;base64,([A-Za-z0-9+/=\r\n]+)', text)
        if not found:
            assignments = re.findall(r'playwrightReportBase64\s*=\s*["\x27]([A-Za-z0-9+/=\r\n]+)["\x27]', text)
            found = assignments
        need(len(found) <= 1, "HTML_REPORT_ARCHIVE_AMBIGUOUS")
        if not found:
            pending("HTML_REPORT_EMBEDDED_ARCHIVE_UNRECOGNIZED", {"file": item["id"]})
            continue
        encoded = re.sub(r"[\r\n]", "", found[0])
        need(len(encoded) <= CAP["htmlBytes"], "HTML_REPORT_BASE64_CAP")
        decoded = base64.b64decode(encoded, validate=True)
        need(len(decoded) <= CAP["htmlBytes"] and decoded.startswith(b"PK"), "HTML_REPORT_ZIP")
        filename = ROOT / "originals" / ("html-embedded-" + str(item["id"]) + ".zip")
        write_bytes(filename, decoded)
        nested_id = inspect_zip(filename, "html-report-embedded", 1, item["id"])
        parsed.append({"htmlFile": item["id"], "zipBytes": len(decoded),
                       "zipSha256": digest(decoded), "archive": nested_id})
    RECEIPT["parsers"]["htmlArchives"] = parsed

def tests_from_report(report):
    tests = []
    visited = 0
    def visit(suite, trail, depth):
        nonlocal visited
        visited += 1
        need(visited <= 10000 and depth <= 32 and isinstance(suite, dict), "REPORT_SUITE_CAP")
        for spec in suite.get("specs", []):
            need(isinstance(spec, dict), "REPORT_SPEC_SHAPE")
            for test in spec.get("tests", []):
                need(isinstance(test, dict), "REPORT_TEST_SHAPE")
                tests.append((spec, test, trail))
        for child in suite.get("suites", []):
            visit(child, trail + [suite.get("title", "")], depth + 1)
    need(isinstance(report, dict) and isinstance(report.get("suites"), list), "REPORT_ROOT_SHAPE")
    for suite in report["suites"]:
        visit(suite, [], 0)
    return tests

def report_configuration(report, tests, label):
    config = report.get("config", {})
    need(isinstance(config, dict) and config.get("workers") == 1, label + "_WORKERS")
    projects = config.get("projects")
    need(isinstance(projects, list) and bool(projects), label + "_PROJECTS")
    selected = {test.get("projectId") or test.get("projectName") for _, test, _ in tests}
    checked_projects = []
    for project in projects:
        if project.get("id") in selected or project.get("name") in selected or len(projects) == 1:
            need(project.get("retries") == 0 and project.get("repeatEach") == 1,
                 label + "_RETRY_REPEAT")
            need(project.get("id") in (None, "chromium") and project.get("name") == "chromium",
                 label + "_CHROMIUM_PROJECT")
            checked_projects.append({"id": project.get("id"), "name": project.get("name"),
                                     "retries": 0, "repeatEach": 1})
    need(bool(checked_projects), label + "_SELECTED_PROJECT")
    return {"workers": 1, "projects": checked_projects}

def error_summary(errors):
    out = []
    for error in errors:
        if not isinstance(error, dict):
            continue
        message = str(error.get("message", ""))
        stack = str(error.get("stack", ""))
        combined = message + "\n" + stack
        position = re.search(r"design-wave-five-analytics\.spec\.ts:(\d+):(\d+)", combined)
        out.append({
            "timeout60000": bool(re.search(r"Timeout\s+60000ms|60000\s*ms", combined)),
            "waitForResponse": "waitForResponse" in combined,
            "source": {"file": "design-wave-five-analytics.spec.ts",
                       "line": int(position.group(1)), "column": int(position.group(2))} if position else None,
            "messageBytes": len(message.encode("utf-8")), "messageSha256": digest(message.encode("utf-8")),
            "stackBytes": len(stack.encode("utf-8")), "stackSha256": digest(stack.encode("utf-8")),
        })
    return out

def marker_stream(results, case_ordinal):
    all_lines = []
    streams = []
    pattern = re.compile(r"^(?:\x1b\[[0-?]*[ -/]*[@-~])*"
                         r"(SF_ANALYTICS_SOURCE|SF_ANALYTICS_CAPTURE|SF_DESIGN_DIAGNOSTICS|SF_ANALYTICS_SCOPE|SF_PREVIEW_E11_CPU|SF_PREVIEW_E11_PROGRESS) (.*)$")
    for result_ordinal, result in enumerate(results, 1):
        for field in ("stdout", "stderr"):
            chunks = []
            size = 0
            for chunk in result.get(field, []):
                need(isinstance(chunk, dict), "RUNTIME_STDIO_CHUNK_SHAPE")
                if isinstance(chunk.get("text"), str) and "buffer" not in chunk:
                    raw = chunk["text"].encode("utf-8")
                elif isinstance(chunk.get("buffer"), str) and "text" not in chunk:
                    encoded = chunk["buffer"]
                    need(len(encoded) <= (CAP["jsonBytes"] * 4 // 3 + 4), "RUNTIME_STDIO_BASE64_CAP")
                    raw = base64.b64decode(encoded, validate=True)
                else:
                    raise ReceiptFailure("RUNTIME_STDIO_CHUNK_ENCODING")
                size += len(raw)
                need(size <= CAP["jsonBytes"], "RUNTIME_STDIO_STREAM_CAP")
                chunks.append(raw)
            # Decode only after concatenating one stream: a chunk may split a UTF-8 character.
            stream_raw = b"".join(chunks)
            text = stream_raw.decode("utf-8", errors="strict")
            lines = []
            for line in text.splitlines():
                match = pattern.match(line)
                if match:
                    lines.append(match.group(1) + " " + match.group(2))
            marker_raw = (("\n".join(lines) + "\n") if lines else "").encode("utf-8")
            marker_path = ("derived/runtime-case-" + str(case_ordinal) + "-result-"
                           + str(result_ordinal) + "-" + field + "-semantic-markers.lf.log")
            write_bytes(ROOT / marker_path, marker_raw)
            streams.append({"case": case_ordinal, "result": result_ordinal, "stream": field,
                            "bytes": len(stream_raw), "sha256": digest(stream_raw),
                            "markerBytes": len(marker_raw), "markerSha256": digest(marker_raw),
                            "markerPath": marker_path, "markerLines": len(lines)})
            all_lines.extend(lines)
    return {"lines": all_lines, "streams": streams}

def parse_runtime_and_selection():
    selection_item, selection_raw, selection = one_original_json("playwright-selection.json")
    runtime_item, runtime_raw, runtime = one_original_json("playwright-runtime.json")
    selected = tests_from_report(selection)
    executed = tests_from_report(runtime)
    need(len(selected) == 2 and len(executed) == 2, "ORIGINAL_TWO_TESTS")
    need([spec.get("title") for spec, _, _ in selected] == TITLES
         and [spec.get("title") for spec, _, _ in executed] == TITLES,
         "ORIGINAL_TEST_TITLES_AND_ORDER")
    selection_config = report_configuration(selection, selected, "SELECTION")
    runtime_config = report_configuration(runtime, executed, "RUNTIME")
    cases = []
    markers = []
    for index, (spec, test, _) in enumerate(executed):
        results = test.get("results")
        need(isinstance(results, list) and len(results) == 1, "ORIGINAL_SINGLE_RESULT")
        result = results[0]
        need(result.get("retry", 0) == 0 and test.get("expectedStatus", "passed") == "passed",
             "ORIGINAL_RESULT_ATTEMPT")
        worker_index = result.get("workerIndex")
        parallel_index = result.get("parallelIndex")
        need(type(worker_index) is int and worker_index >= 0
             and type(parallel_index) is int and parallel_index == 0,
             "ORIGINAL_SINGLE_PARALLEL_WORKER")
        status = result.get("status")
        need(status in EXPECTED_CASE_STATUSES[index],
             "ORIGINAL_RESULT_VERDICT")
        errors = result.get("errors", [])
        if not errors and isinstance(result.get("error"), dict):
            errors = [result["error"]]
        captured = marker_stream(results, index + 1)
        markers.extend(captured["lines"])
        cases.append({
            "title": TITLES[index], "status": status, "retry": 0,
            "workerIndex": worker_index, "parallelIndex": result.get("parallelIndex"),
            "stdioStreams": captured["streams"],
            "durationMs": result.get("duration"), "startTime": result.get("startTime"),
            "errors": error_summary(errors),
            "attachmentCount": len(result.get("attachments", [])),
        })
    if EXPECTED_FIRST_WAITER_FAILURE:
        first = cases[0]["errors"]
        need(any(error["timeout60000"] and error["waitForResponse"]
                 and error["source"] == {"file": "design-wave-five-analytics.spec.ts", "line": 72, "column": 32}
                 for error in first), "ORIGINAL_UI42_FAILURE_LOCATION")
    marker_raw = (("\n".join(markers) + "\n") if markers else "").encode("utf-8")
    write_bytes(ROOT / "derived" / "runtime-semantic-markers.lf.log", marker_raw)
    counts = {name: sum(line.startswith(name + " ") for line in markers) for name in SEMANTIC_COUNTS}
    parity = len(marker_raw) == SEMANTIC_BYTES and digest(marker_raw) == SEMANTIC_SHA and counts == SEMANTIC_COUNTS
    need(parity, "RUNTIME_MAIN_SEMANTIC_SEQUENCE_NOT_IDENTICAL")
    RECEIPT["parsers"]["selection"] = {
        "file": selection_item["id"], "bytes": len(selection_raw), "sha256": digest(selection_raw),
        "tests": 2, "titles": TITLES, "config": selection_config,
    }
    RECEIPT["parsers"]["runtime"] = {
        "file": runtime_item["id"], "bytes": len(runtime_raw), "sha256": digest(runtime_raw),
        "tests": 2, "config": runtime_config, "cases": cases,
        "verdict": {"failed": 1, "passed": 1, "UI42": "partial;6 captures before first preview response",
                    "UI43": "not reached", "UI44": "not reached",
                    "BI": "passed;40 captures and original complete UI45/UI46 scope"},
        "semanticMarkers": {"bytes": len(marker_raw), "sha256": digest(marker_raw), "counts": counts,
                            "matchesOriginalMainSequence": parity,
                            "order": "case/result order, stdout then stderr; no temporal interleaving between streams is inferred",
                            "expectedBytes": SEMANTIC_BYTES, "expectedSha256": SEMANTIC_SHA},
    }
    # Original JSON files are retained verbatim. No arbitrary report text is dumped to logs.
    RECEIPT["logExports"].extend([
        {"file": selection_item["id"], "format": "original-json",
         "status": "PENDING_ORIGINAL_JSON_LOG_EXPORT", "reason": "unclassified original strings retained in artifact"},
        {"file": runtime_item["id"], "format": "original-json",
         "status": "PENDING_ORIGINAL_JSON_LOG_EXPORT", "reason": "raw report retained in artifact; derived strict summary is logged"},
    ])
    checked("original_selection_runtime_and_current_verdict")

# Phase 3: strictly bounded, derived summaries. Raw sources stay byte-for-byte in originals/.
def safe_time(value):
    if isinstance(value, (int, float)) and not isinstance(value, bool) and value == value and abs(value) < 1e18:
        return value
    return None

def safe_failure(value):
    if isinstance(value, dict):
        value = value.get("message", "")
    if not isinstance(value, str) or not value:
        return None
    match = re.search(r"net::ERR_[A-Z0-9_]+|NS_[A-Z0-9_]+|TimeoutError", value)
    return {"present": True, "code": match.group(0) if match else None,
            "bytes": len(value.encode("utf-8")), "sha256": digest(value.encode("utf-8"))}

def network_row(record):
    snapshot = record.get("snapshot")
    if not isinstance(snapshot, dict):
        return None
    request = snapshot.get("request")
    response = snapshot.get("response")
    if not isinstance(request, dict):
        return None
    response = response if isinstance(response, dict) else {}
    try:
        url = urllib.parse.urlsplit(request.get("url", ""))
        operation = urllib.parse.parse_qs(url.query, max_num_fields=100).get("sf", [None])[0]
    except (ValueError, TypeError):
        return None
    if operation not in OPERATIONS:
        return None
    path = url.path
    need(isinstance(path, str) and len(path) <= 2048 and not any(ord(c) < 32 for c in path),
         "TRACE_TARGET_PATH_INVALID")
    method = request.get("method")
    need(method in ("GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"), "TRACE_HTTP_METHOD")
    status = response.get("status")
    if not isinstance(status, int) or not 0 <= status <= 599:
        status = None
    timestamp = snapshot.get("startedDateTime")
    if not isinstance(timestamp, str) or not re.fullmatch(r"[0-9T:.\-+Z]{10,40}", timestamp):
        timestamp = None
    failure = snapshot.get("_failureText") or response.get("_failureText") or record.get("error")
    return {
        "kind": "network", "operation": operation, "method": method, "path": path,
        "status": status, "timestamp": timestamp, "durationMs": safe_time(snapshot.get("time")),
        "monotonicTime": safe_time(snapshot.get("_monotonicTime")), "failure": safe_failure(failure),
    }

def trace_operation(record, allowed_api):
    api_name = record.get("apiName")
    if isinstance(api_name, str) and api_name in allowed_api:
        return api_name, "apiName"
    title = record.get("title")
    if isinstance(title, str) and title in allowed_api:
        return title, "title"
    owner = record.get("class")
    method = record.get("method")
    if not isinstance(owner, str) or not isinstance(method, str):
        return None, None
    known = {
        ("Page", "waitForEventInfo"): "Page.waitForEventInfo",
        ("Page", "close"): "page.close",
        ("BrowserContext", "close"): "browserContext.close",
        ("Browser", "close"): "browser.close",
        ("CDPSession", "detach"): "cdpSession.detach",
    }
    operation = known.get((owner, method))
    # A generic waitForEventInfo is kept generic; no response event is inferred from params.
    return (operation, "class/method") if operation is not None else (None, None)

def trace_rows():
    global TRACE_OBSERVED
    candidates = [item for item in FILES if not item["directory"]
                  and (item["path"].endswith(".trace") or item["path"].endswith(".network"))]
    reports = []
    allowed_api = {
        "page.waitForResponse", "page.close", "browserContext.close", "browser.close",
        "cDPSession.detach", "cdpSession.detach",
    }
    for item in candidates:
        parsed = 0
        malformed = 0
        selected = 0
        call_labels = {}
        ordinals = {}
        path = ROOT / item["storedPath"]
        with open(path, "rb") as source:
            while True:
                raw = source.readline(CAP["jsonlLineBytes"] + 1)
                if not raw:
                    break
                need(len(raw) <= CAP["jsonlLineBytes"], "TRACE_LINE_CAP")
                TRACE_OBSERVED += 1
                if TRACE_OBSERVED > CAP["traceRows"]:
                    pending("TRACE_PARSE_ROW_CAP", {"file": item["id"], "limit": CAP["traceRows"]})
                    break
                try:
                    record = json.loads(raw)
                except (ValueError, UnicodeError):
                    malformed += 1
                    continue
                if not isinstance(record, dict):
                    malformed += 1
                    continue
                parsed += 1
                row = network_row(record)
                kind = record.get("type")
                call_id = record.get("callId")
                operation, label_source = trace_operation(record, allowed_api)
                if kind == "before" and operation is not None and isinstance(call_id, str):
                    call_labels[call_id] = (operation, label_source)
                    ordinals.setdefault(call_id, len(ordinals) + 1)
                    row = {"kind": "call-before", "operation": operation,
                           "operationSource": label_source, "ordinal": ordinals[call_id],
                           "timestamp": safe_time(record.get("startTime"))}
                elif kind == "after" and isinstance(call_id, str) and call_id in call_labels:
                    operation, label_source = call_labels[call_id]
                    row = {"kind": "call-after", "operation": operation,
                           "operationSource": label_source,
                           "ordinal": ordinals[call_id], "timestamp": safe_time(record.get("endTime")),
                           "failure": safe_failure(record.get("error"))}
                if row is not None:
                    selected += 1
                    if len(TRACE_ROWS) < CAP["summaryRows"]:
                        TRACE_ROWS.append({"file": item["id"], "record": parsed, **row})
        reports.append({"file": item["id"], "parsedRecords": parsed, "malformedRecords": malformed,
                        "selectedRecords": selected})
    selected_total = sum(item["selectedRecords"] for item in reports)
    if selected_total > len(TRACE_ROWS):
        pending("TRACE_SAFE_SUMMARY_CAP", {"selected": selected_total, "retained": len(TRACE_ROWS)})
    if any(item["malformedRecords"] for item in reports):
        pending("TRACE_JSONL_MALFORMED_RECORDS", {"count": sum(item["malformedRecords"] for item in reports)})
    if not candidates:
        pending("ORIGINAL_TRACE_NETWORK_ABSENT")
    result = {"schema": 1, "qualification": False, "files": reports, "rows": TRACE_ROWS,
              "retainedRows": len(TRACE_ROWS), "selectedRows": selected_total,
              "limits": ["No headers, cookies, request/response bodies, query values other than an allowed sf operation, or full URLs.",
                         "Times and rows are original observations, not inferred causes or CPU measurements.",
                         "Per-file ordinals replace raw call identifiers; no cross-file correlation is asserted."]}
    RECEIPT["parsers"]["trace"] = save_json("derived/trace-safe.json", result)
    RECEIPT["parsers"]["trace"].update({"files": len(candidates), "selectedRows": selected_total,
                                      "retainedRows": len(TRACE_ROWS)})

def inventory_error_context_and_pngs():
    contexts = [item for item in FILES if not item["directory"] and item["path"].endswith("error-context.md")]
    RECEIPT["parsers"]["errorContexts"] = [
        {"file": item["id"], "bytes": item["bytes"], "sha256": item["sha256"],
         "rawPreserved": True, "logText": "PENDING_ORIGINAL_TEXT_EXPORT"} for item in contexts
    ]
    if not contexts:
        pending("ORIGINAL_ERROR_CONTEXT_ABSENT")
    pngs = []
    for suffix in PNG_SUFFIXES:
        matches = locate_suffix(suffix, outer_only=True)
        if len(matches) != 1:
            pending("ORIGINAL_TARGET_PNG_CARDINALITY", {"suffix": suffix, "matches": len(matches)})
            continue
        item = matches[0]
        raw = read_file(item, CAP["entryBytes"])
        need(raw.startswith(b"\x89PNG\r\n\x1a\n") and len(raw) >= 33
             and raw[12:16] == b"IHDR", "TARGET_PNG_SIGNATURE")
        width = int.from_bytes(raw[16:20], "big")
        height = int.from_bytes(raw[20:24], "big")
        need(0 < width <= 20000 and 0 < height <= 20000, "TARGET_PNG_DIMENSIONS")
        pngs.append({"file": item["id"], "suffix": suffix, "bytes": item["bytes"],
                     "sha256": item["sha256"], "width": width, "height": height,
                     "originalPng": True, "jpegPreviewSubstituted": False})
    RECEIPT["parsers"]["targetPngs"] = pngs

def e11_routes(value):
    need(isinstance(value, dict) and set(value) == {"scope", "order", "cap", "counts"}
         and value.get("scope") == "pid-running-window"
         and value.get("order") == ["sealed-read", "unfenced", "full-guard"]
         and type(value.get("cap")) is int and value["cap"] == 65535
         and isinstance(value.get("counts"), list) and len(value["counts"]) == 3
         and all(type(count) is int and 0 <= count <= 65535 for count in value["counts"]),
         "E11_ROUTES_FINITE_PROTOCOL")
    return value


def e11_selection(value):
    need(isinstance(value, dict)
         and set(value) == {"scope", "order", "cap", "sourceRequests", "nativePairs", "saturated"}
         and value.get("scope") == "pid-running-window"
         and value.get("order") == ["none", "cases", "preferences"]
         and type(value.get("cap")) is int and value["cap"] == 65535
         and isinstance(value.get("sourceRequests"), list) and len(value["sourceRequests"]) == 3
         and isinstance(value.get("nativePairs"), list) and len(value["nativePairs"]) == 9
         and all(type(count) is int and 0 <= count <= 65535
                 for count in value["sourceRequests"] + value["nativePairs"])
         and type(value.get("saturated")) is bool, "E11_SELECTION_FINITE_PROTOCOL")
    need(value["saturated"] == any(count == 65535
                                   for count in value["sourceRequests"] + value["nativePairs"]),
         "E11_SELECTION_SATURATED_CAP_REACHED")
    return value


def e11_unique_object(pairs):
    value = {}
    for key, item in pairs:
        need(key not in value, "E11_DUPLICATE_JSON_KEY")
        value[key] = item
    return value


def parse_e11_markers():
    # Each family has its own attempted sequence. Interleaving is only the original stream order.
    runtime = RECEIPT["parsers"]["runtime"]
    need(runtime["semanticMarkers"]["matchesOriginalMainSequence"] is True,
         "E11_RUNTIME_MAIN_PARITY_REQUIRED")
    analytics_lines, cpu_lines, progress_lines, wire_lines = [], [], [], []
    cpu_memberships, progress_memberships, events, progress_events = [], [], [], []
    complete_bindings, family_sequences = {}, {}
    cpu_prefix, progress_prefix = "SF_PREVIEW_E11_CPU ", "SF_PREVIEW_E11_PROGRESS "
    progress_kinds = ("body-returned", "admit-returned", "case-callback-entered")
    binding_names = ("snapshot", "runId", "attempt", "nonce")
    expected_identity = {"snapshot": SNAPSHOT, "runId": str(ORIGINAL_RUN), "attempt": "1"}
    for case in runtime["cases"]:
        for stream in case["stdioStreams"]:
            raw = (ROOT / stream["markerPath"]).read_bytes()
            need(len(raw) == stream["markerBytes"] and digest(raw) == stream["markerSha256"],
                 "E11_CASE_MARKER_SOURCE")
            lines = raw.decode("utf-8", errors="strict").splitlines()
            analytics_lines.extend(line for line in lines if line.split(" ", 1)[0] in ANALYTICS_COUNTS)
            stream_records = {"cpu": [], "progress": []}
            for ordinal, line in enumerate(lines, 1):
                family = "cpu" if line.startswith(cpu_prefix) else "progress" if line.startswith(progress_prefix) else None
                if family is None:
                    continue
                prefix, cap = (cpu_prefix, 4096) if family == "cpu" else (progress_prefix, 1024)
                encoded = (line + "\n").encode("ascii")
                need(len(encoded) <= cap and re.fullmatch(rb"[\x20-\x7e]*\n", encoded) is not None,
                     "E11_" + family.upper() + "_MARKER_LINE_BOUND")
                event = json.loads(line[len(prefix):], object_pairs_hook=e11_unique_object)
                need(isinstance(event, dict)
                     and event.get("schema") == "sf-preview-causal-e11-" + family + "-v1"
                     and event.get("source") == SOURCE and event.get("sourceTree") == SOURCE_TREE
                     and event.get("qualification") is False
                     and type(event.get("request")) is int and event["request"] == 1
                     and type(event.get("pid")) is int and 0 <= event["pid"] <= 999999999,
                     "E11_MARKER_SOURCE_BINDING")
                need(type(event.get("sequence")) is int and 1 <= event["sequence"] <= 3,
                     "E11_MARKER_SEQUENCE_BOUND")
                e11_routes(event.get("routes"))
                e11_selection(event.get("selection"))
                for name, expected in expected_identity.items():
                    if name in event:
                        need(type(event[name]) is str and event[name] == expected,
                             "E11_MARKER_PRESENT_IDENTITY_CONTRADICTION_" + name)
                if "nonce" in event:
                    need(isinstance(event["nonce"], str)
                         and re.fullmatch(r"sf613-e11-cpu-[A-Za-z0-9]{6}", event["nonce"]) is not None
                         and (CPU["nonce"] is None or event["nonce"] == CPU["nonce"]), "E11_MARKER_PRESENT_NONCE_CONTRADICTION")
                bound = all(name in event for name in binding_names)
                if family == "cpu":
                    need(event.get("kind") in ("started", "stopped", "finished", "unavailable"),
                         "E11_CPU_MARKER_KIND")
                    if event["kind"] != "unavailable":
                        need(bound, "E11_CPU_CAPTURE_RECORD_BINDING_REQUIRED")
                    cpu_lines.append(line)
                    events.append(event)
                else:
                    allowed = {"schema", "source", "sourceTree", "qualification", "pid", "request",
                               "sequence", "kind", "elapsedTenthMs", "cpuPhase", "routes", "selection", *binding_names}
                    need(set(event).issubset(allowed) and event.get("kind") in progress_kinds
                         and "elapsedTenthMs" in event
                         and (event["elapsedTenthMs"] is None or
                              type(event["elapsedTenthMs"]) is int and 0 <= event["elapsedTenthMs"] <= 999999999)
                         and event.get("cpuPhase") in ("running", "stopping", "finished", "failed", "unavailable"),
                         "E11_PROGRESS_FINITE_PROTOCOL")
                    if event["cpuPhase"] != "unavailable":
                        need(bound, "E11_PROGRESS_CAPTURE_BINDING_REQUIRED")
                    progress_lines.append(line)
                    progress_events.append(event)
                key = (family, event["pid"])
                seen = family_sequences.setdefault(key, {"last": 0, "kinds": set(), "stream": (
                    stream["case"], stream["result"], stream["stream"])})
                need(seen["stream"] == (stream["case"], stream["result"], stream["stream"])
                     and event["sequence"] > seen["last"] and event["kind"] not in seen["kinds"],
                     "E11_FAMILY_SEQUENCE_OR_MEMBERSHIP_CONTRADICTION")
                seen["last"] = event["sequence"]
                seen["kinds"].add(event["kind"])
                if bound:
                    identity = (event["snapshot"], event["runId"], event["attempt"], event["nonce"], event["pid"])
                    complete_bindings[identity] = {name: event[name] for name in (*binding_names, "pid")}
                stream_records[family].append({
                    "ordinal": ordinal, "pid": event["pid"], "sequence": event["sequence"],
                    "kind": event["kind"], "bindingComplete": bound, "literal": line + "\n"})
                wire_lines.append(line)
            for family, memberships in (("cpu", cpu_memberships), ("progress", progress_memberships)):
                records = stream_records[family]
                if records:
                    memberships.append({
                        "case": stream["case"], "result": stream["result"], "stream": stream["stream"],
                        "sourceBytes": stream["bytes"], "sourceSha256": stream["sha256"],
                        "markerBytes": stream["markerBytes"], "markerSha256": stream["markerSha256"],
                        "lines": len(records), "records": records,
                    })
    analytics_raw = (("\n".join(analytics_lines) + "\n") if analytics_lines else "").encode("utf-8")
    cpu_raw = (("\n".join(cpu_lines) + "\n") if cpu_lines else "").encode("utf-8")
    progress_raw = (("\n".join(progress_lines) + "\n") if progress_lines else "").encode("utf-8")
    wire_raw = (("\n".join(wire_lines) + "\n") if wire_lines else "").encode("utf-8")
    need(0 < len(wire_raw) <= CORE_CAP["cpuMarkers"], "E11_COMBINED_WIRE_SLOT_CAP")
    analytics_counts = {name: sum(line.startswith(name + " ") for line in analytics_lines)
                        for name in ANALYTICS_COUNTS}
    cpu_counts = {name: sum(line.startswith(name + " ") for line in cpu_lines) for name in CPU_COUNTS}
    progress_counts = {name: sum(line.startswith(name + " ") for line in progress_lines) for name in PROGRESS_COUNTS}
    need(len(analytics_raw) == ANALYTICS_BYTES and digest(analytics_raw) == ANALYTICS_SHA
         and analytics_counts == ANALYTICS_COUNTS, "ANALYTICS_MAIN_PARITY_REQUIRED")
    need(len(cpu_raw) == CPU["markerBytes"] and digest(cpu_raw) == CPU["markerSha256"]
         and cpu_counts == CPU_COUNTS, "E11_CPU_MAIN_PARITY_REQUIRED")
    need(len(progress_raw) == PROGRESS["markerBytes"] and digest(progress_raw) == PROGRESS["markerSha256"]
         and progress_counts == PROGRESS_COUNTS, "E11_PROGRESS_MAIN_PARITY_REQUIRED")
    need(len(complete_bindings) <= 1, "E11_COMPLETE_CAPTURE_BINDING_AMBIGUOUS")
    selected_binding = next(iter(complete_bindings.values())) if complete_bindings else None
    need((selected_binding is None and CPU["nonce"] is None and CPU["pid"] is None)
         or (selected_binding is not None and selected_binding["nonce"] == CPU["nonce"]
             and selected_binding["pid"] == CPU["pid"]), "E11_SELECTED_CAPTURE_BINDING")
    if selected_binding is None:
        pending("E11_COMPLETE_CAPTURE_BINDING_ABSENT")
    path = "derived/preview-e11-cpu-progress-markers.lf.log"
    write_bytes(ROOT / path, wire_raw)
    parities = {
        "analytics": {"bytes": len(analytics_raw), "sha256": digest(analytics_raw),
                      "counts": analytics_counts, "expectedBytes": ANALYTICS_BYTES,
                      "expectedSha256": ANALYTICS_SHA, "matchesOriginalMainSequence": True},
        "cpu": {"bytes": len(cpu_raw), "sha256": digest(cpu_raw), "counts": cpu_counts,
                "expectedBytes": CPU["markerBytes"], "expectedSha256": CPU["markerSha256"],
                "matchesOriginalMainSequence": True},
        "progress": {"bytes": len(progress_raw), "sha256": digest(progress_raw), "counts": progress_counts,
                     "expectedBytes": PROGRESS["markerBytes"], "expectedSha256": PROGRESS["markerSha256"],
                     "matchesOriginalMainSequence": True},
        "union": runtime["semanticMarkers"],
        "allFour": True,
    }
    runtime["e11CpuRecords"] = cpu_memberships
    runtime["e11ProgressRecords"] = progress_memberships
    runtime["parities"] = parities
    RECEIPT["parsers"]["e11Markers"] = {
        "path": path, "bytes": len(wire_raw), "sha256": digest(wire_raw), "lines": len(wire_lines),
        "cpuCounts": cpu_counts, "progressCounts": progress_counts, "parities": parities,
        "cpuMemberships": cpu_memberships, "progressMemberships": progress_memberships,
        "selectedBinding": selected_binding,
        "limits": ["Every literal record and ordinal belongs to one original case/result/stdio stream.",
                   "Ordinal counts all six recognized families in that stream; no cross-stream temporal interleaving is inferred.",
                   "Analytics, CPU, progress and complete-union parities are separate hard requirements.",
                   "CPU and progress sequences are independent attempted writes; gaps are not fabricated or replayed.",
                   "Progress may continue after CPU completion until the HTTP finally; it never attests file close.",
                   "Unavailable progress may lack a complete tuple; missing fields remain missing and do not select a nonce.",
                   "A complete tuple selects an artifact namespace, not sampler ownership or capture completion.",
                   "Routes count already selected branches in this PID only while sampling runs; they are not Request totals.",
                   "A route count at65535 is saturated. No conservation, exclusive time or authority result is inferred.",
                   "Selection has Source3 token decisions and native9 copied-child pairs, row=requested and column=materialized.",
                   "Native pairs include all copied child surfaces and non-C08 callers, before callback; none/none is not a C08 fallback rate.",
                   "Source and native populations are distinct; no pairing, conservation, positivity or cross-family monotonicity is required.",
                   "Selection.saturated reports cap reached among its twelve slots only, not the three routes or events above the cap.",
                   "Body/admit returned and case callback entered are boundaries, not result validity, admission or producer success.",
                   "Playwright workerIndex is not a PID; native identity is read only from literal authenticated records."],
    }
    checked("e11_four_hard_parities_independent_sequences_and_case_stream_membership")
    return {"raw": wire_raw, "cpuRaw": cpu_raw, "events": events, "progressEvents": progress_events,
            "cpuMemberships": cpu_memberships, "progressMemberships": progress_memberships,
            "selectedBinding": selected_binding}


def cpu_json_object(raw):
    if not raw:
        return None, "EMPTY_BYTES"
    try:
        value = json.loads(raw.decode("utf-8", errors="strict"))
    except (ValueError, UnicodeError, RecursionError):
        return None, "MALFORMED_JSON"
    if not isinstance(value, dict):
        return None, "JSON_NON_OBJECT"
    return value, "JSON_OBJECT"


def cpu_present_fields(value, expected, code):
    # Missing fields remain partial. A supplied contradictory identity is a hard failure.
    if value is None:
        return False
    need(isinstance(value, dict), code + "_OBJECT")
    for name, expected_value in expected.items():
        if name in value:
            need(type(value[name]) is type(expected_value) and value[name] == expected_value,
                 code + "_" + name)
    return all(name in value for name in expected)


def parse_cpu_originals(marker_data):
    # Current E11 main provides the complete selected tuple and started marker; never choose first/latest directory.
    binding = marker_data["selectedBinding"]
    need(binding is not None and binding["nonce"] == CPU["nonce"] and binding["pid"] == CPU["pid"],
         "E11_CURRENT_COMPLETE_CAPTURE_BINDING")
    events = marker_data["events"]
    started = next((event for event in events if event["kind"] == "started"), None)
    stopped = next((event for event in events if event["kind"] == "stopped"), None)
    finished = next((event for event in events if event["kind"] == "finished"), None)
    need(started is not None and started["kind"] == "started"
         and re.fullmatch(r"sf613-e11-cpu-[A-Za-z0-9]{6}", CPU["nonce"]) is not None,
         "CPU_SELECTED_STARTED_NONCE")
    expected_runtime = ["1.3.14", "0d9b296af33f2b851fcbf4df3e9ec89751734ba4"]
    need(started.get("runtime") == expected_runtime and started.get("parentPid") == CPU["parentPid"]
         and started.get("intervalUs") == 5000 and started.get("targetMs") == 50000
         and started.get("acceptMs") == 55000, "CPU_RUNTIME_AND_SAMPLING_BINDING")
    start_points = started.get("points")
    start_names = ["frameStart", "startEnter", "startReturn"]
    need(isinstance(start_points, dict) and set(start_points) == set(start_names)
         and all(type(start_points[name]) is int and 0 <= start_points[name] <= 999999999 for name in start_names)
         and start_points["frameStart"] <= start_points["startEnter"] <= start_points["startReturn"],
         "CPU_STARTED_POINTS")
    groups = {}
    for item in FILES:
        if item["directory"] or item["archive"] != 0:
            continue
        pieces = item["path"].split("/")
        positions = [index for index in range(len(pieces) - 2)
                     if pieces[index] == "test-ci-evidence"
                     and pieces[index + 1].startswith("sf613-e11-cpu-")]
        if not positions:
            continue
        need(len(positions) == 1, "CPU_NAMESPACE_AMBIGUOUS")
        index = positions[0]
        nonce, relative = pieces[index + 1], pieces[index + 2:]
        directory = "/".join(pieces[:index + 2])
        name = relative[-1]
        kind = ("profile" if name.lower().endswith(".cpuprofile") else
                "collection" if name.lower() == "collection.json" else
                "launcher" if name.lower() == "launcher.json" else "unclassified")
        group = groups.setdefault(directory, {"directory": directory, "nonce": nonce,
                                              "profile": [], "collection": [], "launcher": [],
                                              "unclassified": []})
        group[kind].append({"file": item["id"], "name": "/".join(relative),
                            "bytes": item["bytes"], "sha256": item["sha256"]})
        if kind != "unclassified":
            need(re.fullmatch(r"sf613-e11-cpu-[A-Za-z0-9]{6}", nonce) is not None
                 and len(relative) == 1 and name in CPU_NAMES, "CPU_NAMESPACE_MEMBER_SHAPE")
    selected_groups = [group for group in groups.values() if group["nonce"] == CPU["nonce"]]
    need(len(selected_groups) <= 1, "CPU_SELECTED_DIRECTORY_AMBIGUOUS")
    selected_directory = selected_groups[0]["directory"] if selected_groups else None
    populations = [group for group in groups.values() if group["profile"] or group["collection"]]
    population_inventory = {
        "scope": "all outer archive E11 nonce directories", "directories": list(groups.values()),
        "populationCount": len(populations), "selectedNonce": CPU["nonce"],
        "selectedDirectory": selected_directory, "extraLauncherFiles": [],
        "launcherLimit": "Launcher preparation is not Request/start/profile/close proof; absent files are not fabricated.",
    }
    RECEIPT["parsers"]["cpuPopulationInventory"] = population_inventory
    for group in groups.values():
        need(not group["unclassified"], "CPU_NAMESPACE_UNCLASSIFIED_MEMBER")
        need(all(len(group[kind]) <= 1 for kind in ("profile", "collection", "launcher")),
             "CPU_POPULATION_MEMBER_AMBIGUOUS")
        if group["nonce"] == CPU["nonce"]:
            continue
        need(not group["profile"] and not group["collection"], "CPU_UNSELECTED_CAPTURE_POPULATION")
        for item in group["launcher"]:
            raw = read_file(FILES[item["file"]], CORE_CAP["launcher"])
            value, parse_status = cpu_json_object(raw)
            binding = cpu_present_fields(value, {
                "schema": "sf-preview-e11-cpu-launch-v1", "source": SOURCE, "sourceTree": SOURCE_TREE,
                "snapshot": SNAPSHOT, "runId": str(ORIGINAL_RUN), "attempt": "1", "nonce": group["nonce"],
                "relativeDirectory": "test-ci-evidence/" + group["nonce"],
                "state": "prepared", "qualification": False, "processRole": "native-cli",
                "entry": "apps/cli/src/index.ts", "command": "serve",
                "profileName": "preview-first.cpuprofile",
            }, "CPU_EXTRA_LAUNCHER_CONTRADICTION")
            if not binding:
                pending("CPU_EXTRA_LAUNCHER_UNVERIFIED", {"file": item["file"], "parseStatus": parse_status})
            population_inventory["extraLauncherFiles"].append({
                **item, "nonce": group["nonce"], "parseStatus": parse_status,
                "preparedBindingVerified": binding, "stateObserved": "prepared" if binding else None,
                "trailingLF": raw.endswith(b"\n"),
                "limit": "No profile/collection in this directory; no case/PID/Request/start/stop/completion is inferred."})
    selected, raw_files, parsed, parents = [], {}, {}, set()
    presence = {}
    RECEIPT["parsers"]["cpuFiles"] = selected
    file_caps = {"preview-first.cpuprofile": CORE_CAP["profile"],
                 "collection.json": CORE_CAP["collection"], "launcher.json": CORE_CAP["launcher"]}
    for name in CPU_NAMES:
        suffix = "test-ci-evidence/" + CPU["nonce"] + "/" + name
        matches = locate_suffix(suffix, outer_only=True)
        need(len(matches) <= 1, "CPU_ORIGINAL_CARDINALITY_" + name.replace(".", "_"))
        if not matches:
            presence[name] = {"present": False}
            continue
        item = matches[0]
        raw = read_file(item, file_caps[name])
        value, parse_status = cpu_json_object(raw)
        row = {"file": item["id"], "name": name, "suffix": suffix, "present": True,
               "bytes": len(raw), "sha256": digest(raw), "original": True,
               "parseStatus": parse_status, "trailingLF": raw.endswith(b"\n")}
        selected.append(row)
        presence[name] = row
        raw_files[name], parsed[name] = raw, value
        parents.add(item["path"].rsplit("/", 1)[0])
        if parse_status != "JSON_OBJECT" or not row["trailingLF"]:
            pending("CPU_ORIGINAL_FILE_INCOMPLETE", {"file": item["id"], "parseStatus": parse_status,
                                                   "trailingLF": row["trailingLF"]})
    need(len(parents) <= 1 and (not parents or selected_directory in parents),
         "CPU_ORIGINAL_COMMON_DIRECTORY")
    missing = [name for name in CPU_NAMES if name not in raw_files]
    if missing:
        pending("CPU_SELECTED_FILES_ABSENT", {"names": missing})
    launcher, collection, profile = (parsed.get(name) for name in
                                     ("launcher.json", "collection.json", "preview-first.cpuprofile"))
    bindings = {}
    for name, value in (("launcher.json", launcher), ("collection.json", collection)):
        expected = {"source": SOURCE, "sourceTree": SOURCE_TREE, "snapshot": SNAPSHOT,
                    "runId": str(ORIGINAL_RUN), "attempt": "1", "nonce": CPU["nonce"],
                    "qualification": False}
        if name == "launcher.json":
            expected.update({"schema": "sf-preview-e11-cpu-launch-v1", "processRole": "native-cli",
                             "state": "prepared", "entry": "apps/cli/src/index.ts", "command": "serve",
                             "relativeDirectory": "test-ci-evidence/" + CPU["nonce"],
                             "profileName": "preview-first.cpuprofile"})
        else:
            expected.update({"schema": "sf-preview-causal-e11-cpu-v1", "pid": CPU["pid"],
                             "parentPid": CPU["parentPid"], "request": 1, "runtime": expected_runtime,
                             "intervalUs": 5000, "targetMs": 50000, "acceptMs": 55000,
                             "profileCapBytes": CORE_CAP["profile"], "collectionCapBytes": CORE_CAP["collection"]})
        valid = cpu_present_fields(value, expected, "CPU_SELECTED_FILE_CONTRADICTION")
        bindings[name] = valid
        if name in raw_files and not valid:
            pending("CPU_SELECTED_FILE_BINDING_UNVERIFIED", {"file": presence[name]["file"]})
    if collection is not None and "routes" in collection:
        e11_routes(collection["routes"])
    collection_selection_valid = collection is not None and "selection" in collection
    if collection_selection_valid:
        e11_selection(collection["selection"])
    # Missing originals or JSON fields remain pending. Every present contradiction is rejected.
    collection_close_fields = False
    if finished is not None:
        for name, field in (("preview-first.cpuprofile", "profile"), ("collection.json", "collection")):
            if field in finished:
                expected_file = {"name": name}
                if name in raw_files:
                    expected_file.update({"bytes": len(raw_files[name]), "sha256": digest(raw_files[name])})
                cpu_present_fields(finished[field], expected_file, "CPU_FINISHED_PRESENT_FILE_CONTRADICTION")
        if collection is not None:
            expected_collection = {name: finished[name] for name in ("state", "cause", "cleanupFailed", "routes", "selection")
                                   if name in finished}
            collection_close_fields = cpu_present_fields(collection, expected_collection,
                                                         "CPU_COLLECTION_PRESENT_CLOSE_CONTRADICTION")
            for name in ("profile", "points"):
