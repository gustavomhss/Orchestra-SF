    elif (set(raw_files) != set(CPU_NAMES)
          or not all(row["parseStatus"] == "JSON_OBJECT" and row["trailingLF"] for row in selected)
          or not all(bindings.values()) or not profile_valid or not collection_close_fields
          or collection is None or "native" not in collection or not collection_selection_valid):
