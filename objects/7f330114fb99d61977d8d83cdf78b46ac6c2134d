                                            "CPU_COLLECTION_PROFILE_CONTRADICTION")
        collection_profile_binding = fields_present and "preview-first.cpuprofile" in raw_files

    nodes = profile.get("nodes") if profile is not None else None
    samples = profile.get("samples") if profile is not None else None
