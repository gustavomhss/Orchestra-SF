test("E10 CPU observer records stop failure without cleanup replay or changed rejection", () => control(
  "E10 CPU observer records stop failure without cleanup replay or changed rejection", "stop-failure", (f) => {
    const handle = required(f.api.startSfE10CpuObservation(f.request))
    let threw = false, received: unknown = "not-thrown"
    f.setTime(51_000)
    f.setProgressOutput("throw")
    try {
      try { throw undefined }
      finally {
        f.api.markSfE10HttpProgress(handle, f.request, "body-returned")
        f.api.markSfE10HttpProgress(handle, f.request, "body-returned")
        f.api.finishSfE10CpuObservation(handle, f.request)
      }
    } catch (error) { threw = true; received = error }
    expect(threw).toBe(true)
    expect(received).toBeUndefined()
    f.api.finishSfE10CpuObservation(handle, f.request)
    f.pulse(61_000)
    expect(f.records().map((entry) => entry.kind)).toEqual(["started", "finished"])
    expect(f.latest()).toMatchObject({ state: "incomplete", reason: "stop", stopReturned: false, cause: "target" })
    expect(f.progressRecords()).toEqual([])
    expect(f.progressAttempts()).toBe(1)
    expect(f.progressFailures()).toBe(1)
    expect(f.events.indexOf("progress-write")).toBeLessThan(f.events.indexOf("Profiler.stop"))
    f.api.pumpSfE10CpuObservation()
    f.api.markSfE10CpuRoute(0)
    expect(f.calls.filter((call) => call === "Profiler.stop")).toHaveLength(1)
    expect(f.calls.filter((call) => call === "disconnect")).toHaveLength(0)
    expect(f.samplerLive()).toBe(true)
    expect(f.fileNames()).toEqual(["launcher.json"])
    expect(f.clearedTimers()).toBe(1)
  }), 15_000)

