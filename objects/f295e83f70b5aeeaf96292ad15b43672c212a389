  process.stdout.write(JSON.stringify({ loadingControlManifest: {
    source, sourceTree, captureCases: 26, originalCanonicalCases: 2,
    modes: ["clean", "object-tojson", "array-tojson", "stateful-map", "stateful-keys",
      "copy-descriptors", "reflection-descriptor", "proxy-checker", "stateful-hasher",
      "bootstrap-api-absent", "bootstrap-api-accessor"],
    receiptOwner: "apps/cli/test/fixture/sucafina-captured-context-loading.ts",
    assertions: "distinct child PID; canonical before hook before helper; one own Omni spawn; zero delegations; intact output; positive and cold negative comparisons",
    outerOmniDoesNotCountLoadingChildren: true,
  } }) + "\n")
  const snapshot = process.env.GITHUB_SHA
  if (typeof snapshot !== "string" || snapshot === source)
    throw new Error("The actual driver SHA must remain distinct from the literal source checkout")
  yield* runCommand("fetch driver parent", "git", [
    "fetch", "--no-tags", "--depth=2", "origin", snapshot,
  ], repository, 60_000)
  const candidate = yield* runCommand("literal source identity", "git", [
    "show", "-s", "--format=%H%n%T", "HEAD",
