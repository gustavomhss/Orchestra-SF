checks.live("existing English copy is byte-preserved and new keys have explicit pt-BR", () => Effect.gen(function* () {
  requireHostedCandidate()
  expectSpawn(import.meta.path)
  for (const name of ["sf-u23", "sf-u25", "sf-u32", "sf-u33", "sf-u38", "sf-u44"]) {
    const file = "packages/app-shell/src/i18n/orchestra-chapters/" + name + ".ts"
    const original = yield* runCommand("read pinned English source " + name, "git", [
      "show", dev + ":" + file,
    ], repository, 30_000, false)
    const current = yield* Effect.promise(() => readFile(path.join(repository, file), "utf8"))
    const [before] = copyLiterals(original)
    const [english, portuguese] = copyLiterals(current)
    if (!before || !english || !portuguese || Object.keys(before).length < 1)
      throw new Error("No bilingual source keys decoded")
    for (const [key, literal] of Object.entries(before)) expect(english[key], name + " / " + key).toBe(literal)
    const added = Object.keys(english).filter((key) => !(key in before))
    for (const key of added) {
      expect(portuguese[key], name + " / " + key).toBeDefined()
      expect(portuguese[key], name + " / " + key).not.toBe(english[key])
    }
    expect(Object.keys(portuguese).toSorted()).toEqual(Object.keys(english).toSorted())
    process.stdout.write(JSON.stringify({ gate: "bilingual parity", file, preserved: Object.keys(before).length, added: added.length }) + "\n")
  }
}), 300_000)

