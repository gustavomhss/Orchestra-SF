  expect(candidate.trim().split("\n")).toEqual([source, sourceTree])
  const driver = yield* runCommand("driver identity and sole parent", "git", [
    "show", "-s", "--format=%H%n%P", snapshot,
  ], repository, 30_000)
  expect(driver.trim().split("\n")).toEqual([snapshot, source])
}), 180_000)

