+    offset, chunks, idat, ended = 8, 0, 0, False
+    while offset < len(raw):
+        need(offset + 12 <= len(raw), "UI_PNG_CHUNK_HEADER")
+        length = int.from_bytes(raw[offset:offset + 4], "big")
