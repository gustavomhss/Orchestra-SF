name: sf613-final-qualification

# D30 parametric draft, not a frozen candidate. D adds only this workflow and the wrapper; checkout remains literal C613.
# This workflow has no repository-write permission and retains D for audit after intake.
on:
  push:
    branches:
      - sf613-final-ci

permissions:
  contents: read
  actions: read

jobs:
  qualification:
    name: technical qualification
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    defaults:
      run:
        shell: bash
    steps:
      - name: Initialize external evidence
        id: evidence
        run: |
          node --input-type=module <<'SF613_NODE'
          import fs from "node:fs"
          import path from "node:path"
          const run = process.env.GITHUB_RUN_ID, attempt = process.env.GITHUB_RUN_ATTEMPT
          if (!/^[1-9]\d*$/.test(run ?? "") || !/^[1-9]\d*$/.test(attempt ?? "")) throw new Error("Invalid run/attempt")
          const base = fs.realpathSync(process.env.RUNNER_TEMP)
          const target = path.join(base, "sf613-final-" + run + "-" + attempt)
          if (process.env.SF613_EVIDENCE !== undefined || /[\r\n]/.test(target)) throw new Error("Unexpected inherited evidence path")
          const workspace = path.resolve(process.env.GITHUB_WORKSPACE)
          if (target === workspace || target.startsWith(workspace + path.sep)) throw new Error("Evidence is inside checkout")
          fs.mkdirSync(target, { mode: 0o700 })
          const info = fs.lstatSync(target)
          if (!info.isDirectory() || info.isSymbolicLink() || (info.mode & 0o777) !== 0o700) throw new Error("Unsafe evidence directory")
          fs.writeFileSync(path.join(target, "bootstrap.json"), JSON.stringify({
            schema: "sf613-final-evidence-bootstrap-v1", status: "NOT_EXECUTED",
            driver: process.env.GITHUB_SHA, run, attempt, createdAt: new Date().toISOString(),
            goLiveAcceptance: false
          }, null, 2) + "\n", { flag: "wx", mode: 0o600 })
          fs.appendFileSync(process.env.GITHUB_ENV, "SF613_EVIDENCE=" + target + "\n")
          SF613_NODE

      - name: Setup Node 24.15
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: "24.15"

      - name: Checkout literal source C613
        id: checkout
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          ref: __SF613_SOURCE_SHA__
          fetch-depth: 1
          persist-credentials: false

      - name: Setup Bun from C613
        uses: ./.github/actions/setup-bun
        with:
          reuse-node: "true"
          save: "false"

      - name: ripgrep
        uses: ./.github/actions/ripgrep

      - name: Linux sandbox dependencies
        run: |
          # Hosted ubuntu-24.04 sometimes cannot resolve azure.archive.ubuntu.com. apt reads that
          # name from apt-mirrors.txt. Fall back to archive.ubuntu.com only after the fetch fails.
          install_sandbox() {
            sudo apt-get update -qq
            sudo apt-get install -y -qq bubblewrap socat
          }
          if ! install_sandbox; then
            for file in /etc/apt/apt-mirrors.txt /etc/apt/sources.list /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list; do
              [ -f "$file" ] || continue
              sudo sed -i 's|azure.archive.ubuntu.com|archive.ubuntu.com|g' "$file"
            done
            install_sandbox
          fi
          # Ubuntu 24.04 blocks unprivileged user namespaces through AppArmor; bubblewrap needs them.
          sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0

      - name: Configure git identity
        run: |
          git config --global user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git config --global user.name "github-actions[bot]"

      - name: omni binaries
        uses: ./.github/actions/omni-binaries

      - name: Run source-bound technical qualification
        id: technical
        timeout-minutes: 40
        env:
          SF613_API_TOKEN: ${{ github.token }}
          # Derived transport digest: regenerate after substituting the four reviewed pins.
          SF613_ENVELOPE_SHA256: "f07e4cd7a85ed29a2f8498fa767ba69c386e432e3c88bb8ad0915b5ed819e45b"
          SF613_ENVELOPE_SOURCE: |
            import fs from "node:fs"
            import * as fsp from "node:fs/promises"
            import path from "node:path"
            import { createHash, randomBytes } from "node:crypto"
            import { spawn } from "node:child_process"
            import { Transform, Writable } from "node:stream"
            import { pipeline } from "node:stream/promises"
            import { pathToFileURL } from "node:url"
            
            const SOURCE = "__SF613_SOURCE_SHA__"
            const TREE = "__SF613_SOURCE_TREE__"
            const WRAPPER_BLOB = "__SF613_WRAPPER_BLOB__"
            const WRAPPER_SHA256 = "__SF613_WRAPPER_SHA256__"
            const REPOSITORY = "gustavomhss/Orchestra-SF"
            const BRANCH = "sf613-final-ci"
            const WORKFLOW = ".github/workflows/sf613-final-qualification.yml"
            const SLOT = "apps/cli/test/sf613-final-verification.test.ts"
            const PRELOAD = "script/test-omni-control.ts"
            const PRELOAD_BLOB = "643ad90a4606c2afd6c6c9aee389ca6389ab54e9"
            const CLI_BUNFIG_BLOB = "b63db7a054a18092d613327093aaec2acba606b2"
            const UI_BYTES = 390
            const UI_SHA256 = "7361e2eb04f385dd34977c8b599ea62fb5d52103f8655603426b1a20b8b6dbe2"
            const TEST_TIMEOUT_MS = 35 * 60 * 1000
            const COMMAND_TERM_GRACE_MS = 5000
            const COMMAND_KILL_GRACE_MS = 5000
            const STDIO_DRAIN_MS = 10000
            const OPEN_EXCLUSIVE = fs.constants.O_CREAT | fs.constants.O_EXCL | fs.constants.O_NOFOLLOW | fs.constants.O_RDWR
            const NOFOLLOW_READ = fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW
            const started = performance.now()
            const errors = []
            const recordedErrors = new WeakSet()
            const receipt = {
              schema: "sf613-final-technical-literal-c-d26-r1",
              status: "FAIL", technicalQualification: false, goLiveAcceptance: false,
              source: SOURCE, sourceTree: TREE, driver: process.env.GITHUB_SHA,
              run: process.env.GITHUB_RUN_ID, attempt: process.env.GITHUB_RUN_ATTEMPT,
              requestUiChanged: null, sourceTreeChanged: null,
              branchCleanup: { policy: "preserve D for audit; later removal requires an available authorized capability", performed: false },
              commands: [], errors, startedAt: new Date().toISOString()
            }
            let evidence, checkout, testDirectory, testDirectoryFd, slotFd, slotIdentity, wrapperBytes
            let baseline, rootDirectories, interrupted = false, activeStop
            let commandSequence = 0
            const sha256 = bytes => createHash("sha256").update(bytes).digest("hex")
            const gitBlob = bytes => createHash("sha1").update("blob " + bytes.length + "\0").update(bytes).digest("hex")
            const need = (condition, message) => { if (!condition) throw new Error(message) }
            const sleep = ms => new Promise(resolve => setTimeout(resolve, ms))
            async function within(promise, milliseconds) {
              let timer
              try { return await Promise.race([promise, new Promise(resolve => { timer = setTimeout(() => resolve(null), milliseconds) })]) }
              finally { clearTimeout(timer) }
            }
            const statIdentity = stat => ({
              dev: String(stat.dev), ino: String(stat.ino), nlink: String(stat.nlink),
              mode: Number(stat.mode & 0o7777n), uid: String(stat.uid), size: String(stat.size)
            })
            const sameInode = (left, right) => left.dev === right.dev && left.ino === right.ino
            function problem(stage, error) {
              if (error && typeof error === "object") {
                if (recordedErrors.has(error)) return
                recordedErrors.add(error)
              }
              const value = { stage, message: error instanceof Error ? error.message : String(error) }
              if (error && typeof error.code === "string") value.code = error.code
              errors.push(value)
              return value
            }
            function captureSignal(signal) {
              if (!interrupted) problem("signal", new Error("Envelope received " + signal))
              interrupted = true
              activeStop?.("envelope-" + signal)
            }
            process.on("SIGTERM", () => captureSignal("SIGTERM"))
            process.on("SIGINT", () => captureSignal("SIGINT"))
            
            function exclusiveFile(relative, bytes) {
              need(evidence && !path.isAbsolute(relative) && !relative.split("/").includes(".."), "Invalid evidence path")
              const target = path.join(evidence, relative)
              const descriptor = fs.openSync(target, OPEN_EXCLUSIVE, 0o600)
              try {
                const st = fs.fstatSync(descriptor, { bigint: true })
                need(st.isFile() && st.nlink === 1n && (st.mode & 0o777n) === 0o600n, "Evidence file identity mismatch")
                fs.writeFileSync(descriptor, bytes)
                fs.fsyncSync(descriptor)
              } finally { fs.closeSync(descriptor) }
              return { path: relative, bytes: bytes.length, sha256: sha256(bytes) }
            }
            function jsonFile(relative, value) {
              return exclusiveFile(relative, Buffer.from(JSON.stringify(value, null, 2) + "\n"))
            }
            function absent(target) {
              try { fs.lstatSync(target); return false }
              catch (error) { if (error.code === "ENOENT") return true; throw error }
            }
            function directoryChain(target) {
              const absolute = path.resolve(target)
              const result = []
              let current = path.parse(absolute).root
              const components = absolute.slice(current.length).split(path.sep).filter(Boolean)
              for (const part of ["", ...components]) {
                if (part) current = path.join(current, part)
                const st = fs.lstatSync(current, { bigint: true })
                need(st.isDirectory() && !st.isSymbolicLink(), "Non-directory or symlink ancestor: " + current)
                need(fs.realpathSync(current) === current, "Nonliteral directory ancestor: " + current)
                result.push({ path: current, ...statIdentity(st) })
              }
              return result
            }
            function compareDirectories(original) {
              const current = directoryChain(original.at(-1).path)
              need(current.length === original.length && current.every((entry, index) =>
                entry.path === original[index].path && sameInode(entry, original[index])),
                "Checkout/slot directory identity drift")
              return current
            }
            function readRegular(target, expectedSize) {
              const descriptor = fs.openSync(target, NOFOLLOW_READ)
              try {
                const before = fs.fstatSync(descriptor, { bigint: true })
                need(before.isFile() && before.nlink === 1n, "Non-regular or multiply linked file: " + target)
                if (expectedSize !== undefined) need(before.size === BigInt(expectedSize), "Unexpected file size: " + target)
                const bytes = fs.readFileSync(descriptor)
                const after = fs.fstatSync(descriptor, { bigint: true })
                need(sameInode(before, after) && before.size === after.size && BigInt(bytes.length) === after.size,
                  "File changed while reading: " + target)
                return { bytes, stat: statIdentity(after) }
              } finally { fs.closeSync(descriptor) }
            }
            function groupAlive(pid) {
              if (!Number.isInteger(pid) || pid <= 0) return false
              try { process.kill(-pid, 0); return true }
              catch (error) { if (error.code === "ESRCH") return false; throw error }
            }
            async function waitGroupGone(pid, milliseconds) {
              const until = performance.now() + milliseconds
              while (groupAlive(pid) && performance.now() < until) await sleep(50)
              return !groupAlive(pid)
            }
            function processBirth(pid) {
              try {
                const stat = fs.readFileSync("/proc/" + pid + "/stat", "utf8")
                const tail = stat.slice(stat.lastIndexOf(")") + 2).trim().split(/\s+/)
                return { pid, group: Number(tail[2]), session: Number(tail[3]), starttime: tail[19],
                  bootId: fs.readFileSync("/proc/sys/kernel/random/boot_id", "utf8").trim() }
              } catch (error) { if (error.code === "ENOENT" || error.code === "ESRCH") return null; throw error }
            }
            async function fileDigest(filename) {
              const hash = createHash("sha256")
              let bytes = 0
              for await (const chunk of fs.createReadStream(filename)) { bytes += chunk.length; hash.update(chunk) }
              return { bytes, sha256: hash.digest("hex") }
            }
            async function captured(label, executable, args, options = {}) {
              need(!interrupted, "Envelope interrupted before " + label)
              const serial = String(++commandSequence).padStart(3, "0")
              const prefix = serial + "-" + label.replace(/[^a-z0-9-]/gi, "-").toLowerCase()
              const outName = prefix + ".stdout.bin", errName = prefix + ".stderr.bin"
              const outFile = path.join(evidence, outName), errFile = path.join(evidence, errName)
              const handles = []
              const record = { label, executable, args, cwd: options.cwd ?? checkout, startedAt: new Date().toISOString(),
                timeoutMs: options.timeoutMs ?? 30000, stopReasons: [], signals: [], captureErrors: [] }
              receipt.commands.push(record)
              let child, timeoutTimer, killTimer, exited = false, closed = false, stopRequested = false
              const begin = performance.now()
              const send = signal => {
                if (!child?.pid) return
                try {
                  if (!groupAlive(child.pid)) return
                  const current = processBirth(child.pid), expected = record.birth
                  if (!current || !expected || current.pid !== expected.pid || current.group !== expected.group ||
                    current.session !== expected.session || current.starttime !== expected.starttime || current.bootId !== expected.bootId) {
                    record.captureErrors.push("Refused " + signal + " without the original process-birth identity")
                    return
                  }
                  process.kill(-child.pid, signal); record.signals.push(signal)
                } catch (error) { if (error.code !== "ESRCH") record.captureErrors.push("signal " + signal + ": " + error.message) }
              }
              const stop = reason => {
                record.stopReasons.push(reason)
                if (stopRequested) return
                stopRequested = true
                send("SIGTERM")
                killTimer = setTimeout(() => send("SIGKILL"), COMMAND_TERM_GRACE_MS)
              }
              const pump = async (stream, handle, streamName) => {
                const hash = createHash("sha256")
                let bytes = 0
                const tap = new Transform({ transform(chunk, encoding, callback) {
                  bytes += chunk.length; hash.update(chunk); callback(null, chunk)
                } })
                let pending = Promise.resolve()
                const sink = new Writable({
                  write(chunk, encoding, callback) {
                    pending = (async () => {
                      let offset = 0
                      while (offset < chunk.length) {
                        const result = await handle.write(chunk, offset, chunk.length - offset, null)
                        need(result.bytesWritten > 0, "Zero-byte evidence write")
                        offset += result.bytesWritten
                      }
                    })()
                    pending.then(() => callback(), callback)
                  },
                  final(callback) {
                    pending = handle.sync()
                    pending.then(() => callback(), callback)
                  },
                  destroy(error, callback) {
                    // This stream never owns/closes the descriptor; finish outstanding I/O first.
                    pending.then(() => callback(error), writeError => callback(error ?? writeError))
                  }
                })
                try {
                  await pipeline(stream, tap, sink)
                  return { bytes, sha256: hash.digest("hex"), complete: true }
                } catch (error) {
                  record.captureErrors.push(streamName + ": " + error.message)
                  problem(label + ":" + streamName, error)
                  stop("capture-error")
                  return { bytes, sha256: hash.digest("hex"), complete: false }
                }
              }
              try {
                handles.push(await fsp.open(outFile, OPEN_EXCLUSIVE, 0o600))
                handles.push(await fsp.open(errFile, OPEN_EXCLUSIVE, 0o600))
                const childEnv = { ...process.env, ...options.env }
                delete childEnv.SF613_API_TOKEN
                delete childEnv.SF613_EVIDENCE
                delete childEnv.GH_TOKEN
                delete childEnv.GITHUB_TOKEN
                child = spawn(executable, args, { cwd: record.cwd, env: childEnv, detached: true,
                  shell: false, stdio: ["ignore", "pipe", "pipe"] })
                record.pid = child.pid ?? null
                activeStop = stop
                const closePromise = new Promise(resolve => child.once("close", () => { closed = true; resolve() }))
                const exitPromise = new Promise(resolve => {
                  child.once("error", error => { record.spawnError = error.message; problem(label + ":spawn", error); exited = true; resolve() })
                  child.once("exit", (code, signal) => { record.exitCode = code; record.exitSignal = signal; exited = true; resolve() })
                })
                record.birth = child.pid ? processBirth(child.pid) : null
                if (record.birth) {
                  need(record.birth.group === child.pid && record.birth.session === child.pid, "Child does not own its new process group")
                  jsonFile(prefix + ".process-start.json", { source: SOURCE, driver: process.env.GITHUB_SHA,
                    run: process.env.GITHUB_RUN_ID, attempt: process.env.GITHUB_RUN_ATTEMPT, birth: record.birth, label })
                }
                if (options.requireBirth) need(record.birth, "Original Bun process birth could not be recorded")
                const pumps = [pump(child.stdout, handles[0], "stdout"), pump(child.stderr, handles[1], "stderr")]
                timeoutTimer = setTimeout(() => stop("timeout"), record.timeoutMs)
                await within(exitPromise, record.timeoutMs + COMMAND_TERM_GRACE_MS + COMMAND_KILL_GRACE_MS)
                if (!exited) { stop("exit-not-observed"); send("SIGKILL"); record.captureErrors.push("Process exit was not observed") }
                if (exited && !record.spawnError && (!(options.acceptedExitCodes ?? [0]).includes(record.exitCode) || record.exitSignal !== null))
                  problem(label + ":original-exit", new Error("Original process exitCode=" + record.exitCode + " signal=" + record.exitSignal))
                let drains = await within(Promise.all(pumps), STDIO_DRAIN_MS)
                if (!drains) {
                  stop("stdio-drain-timeout"); send("SIGKILL")
                  drains = await within(Promise.all(pumps), COMMAND_KILL_GRACE_MS)
                }
                if (!drains) {
                  child.stdout.destroy(new Error("Evidence drain deadline"))
                  child.stderr.destroy(new Error("Evidence drain deadline"))
                  drains = await Promise.all(pumps)
                }
                await within(closePromise, COMMAND_KILL_GRACE_MS)
                need(closed, "Original process close was not observed")
                if (groupAlive(child.pid) && !await waitGroupGone(child.pid, 1000)) {
                  stop("remaining-process-group")
                  if (!await waitGroupGone(child.pid, COMMAND_TERM_GRACE_MS)) send("SIGKILL")
                  need(await waitGroupGone(child.pid, COMMAND_KILL_GRACE_MS), "Process group did not finalize: " + label)
                }
                for (const handle of handles) await handle.sync()
                record.stdout = { path: outName, ...await fileDigest(outFile), observed: drains[0] }
                record.stderr = { path: errName, ...await fileDigest(errFile), observed: drains[1] }
                for (const stream of [record.stdout, record.stderr]) need(stream.observed.complete &&
                  stream.bytes === stream.observed.bytes && stream.sha256 === stream.observed.sha256, "Incomplete evidence capture: " + label)
                need(exited && !record.spawnError && record.captureErrors.length === 0 && record.stopReasons.length === 0,
                  "Process or capture did not complete normally: " + label)
                return record
              } catch (error) {
                problem(label, error)
                throw error
              } finally {
                clearTimeout(timeoutTimer); clearTimeout(killTimer)
                activeStop = undefined
                try {
                  if (child?.pid && groupAlive(child.pid)) {
                    send("SIGKILL")
                    if (!await waitGroupGone(child.pid, COMMAND_KILL_GRACE_MS)) problem(label + ":cleanup", new Error("Process group remains"))
                  }
                } catch (error) { problem(label + ":process-cleanup", error) }
                for (const handle of handles) {
                  try { await handle.sync() } catch (error) { problem(label + ":flush", error) }
                  try { await handle.close() } catch (error) { problem(label + ":close", error) }
                }
                record.durationMs = Math.round(performance.now() - begin)
                record.finishedAt = new Date().toISOString()
                if (evidence) {
                  try { jsonFile(prefix + ".process-finished.json", record) }
                  catch (error) { problem(label + ":process-receipt", error) }
                }
              }
            }
            async function git(label, args, accepted = [0]) {
              const record = await captured(label, "git", args, { env: { GIT_OPTIONAL_LOCKS: "0" }, acceptedExitCodes: accepted })
              need(accepted.includes(record.exitCode) && record.exitSignal === null, "Git exit status: " + label)
              return { bytes: fs.readFileSync(path.join(evidence, record.stdout.path)), record }
            }
            const asText = bytes => new TextDecoder("utf-8", { fatal: true }).decode(bytes)
            
            async function api(endpoint) {
              const token = process.env.SF613_API_TOKEN
              need(typeof token === "string" && token.length > 0, "Read-only Actions API token is unavailable")
              const response = await fetch("https://api.github.com/repos/" + REPOSITORY + endpoint, {
                headers: { Accept: "application/vnd.github+json", Authorization: "Bearer " + token,
                  "X-GitHub-Api-Version": "2022-11-28" },
                signal: AbortSignal.timeout(10000), redirect: "error"
              })
              need(response.status === 200, "GitHub read failed: " + endpoint + " HTTP " + response.status)
              return await response.json()
            }
            async function observedActions(stage) {
              const id = process.env.GITHUB_RUN_ID, attempt = process.env.GITHUB_RUN_ATTEMPT, driver = process.env.GITHUB_SHA
              const run = await api("/actions/runs/" + id + "/attempts/" + attempt)
              need(String(run.id) === id && String(run.run_attempt) === attempt && run.head_sha === driver &&
                run.head_branch === BRANCH && run.event === "push" && run.path === WORKFLOW &&
                run.repository?.full_name === REPOSITORY && run.head_repository?.full_name === REPOSITORY &&
                run.actor?.login === process.env.GITHUB_ACTOR && String(run.actor?.id) === process.env.GITHUB_ACTOR_ID &&
                run.triggering_actor?.login === process.env.GITHUB_TRIGGERING_ACTOR, "Actual Actions run does not bind D/path/event/repository/actor")
              need(run.status === "in_progress" && run.conclusion === null, "Actions run is not the active attempt")
              const workflow = await api("/actions/workflows/" + run.workflow_id)
              need(workflow.path === WORKFLOW && workflow.state === "active", "Actual Actions workflow path/state mismatch")
              const listing = await api("/actions/runs/" + id + "/attempts/" + attempt + "/jobs?per_page=100")
              need(listing.total_count === 1 && listing.jobs.length === 1, "Unexpected job inventory")
              const job = listing.jobs[0]
              need(String(job.run_id) === id && job.head_sha === driver && job.name === "technical qualification" &&
                job.status === "in_progress" && job.conclusion === null && job.runner_id > 0 &&
                job.runner_name === process.env.RUNNER_NAME &&
                Array.isArray(job.labels) && job.labels.length === 1 && job.labels[0] === "ubuntu-24.04",
                "Actual job or runner assignment mismatch")
              const current = await api("/git/ref/heads/" + BRANCH)
              need(current.ref === "refs/heads/" + BRANCH && current.object?.type === "commit" && current.object.sha === driver,
                "Current qualification ref no longer identifies D")
              const value = { stage, observedAt: new Date().toISOString(),
                run: { id: run.id, attempt: run.run_attempt, event: run.event, headSha: run.head_sha,
                  headBranch: run.head_branch, path: run.path, workflowId: run.workflow_id, status: run.status,
                  actor: { login: run.actor.login, id: run.actor.id }, triggeringActor: run.triggering_actor.login },
                job: { id: job.id, name: job.name, status: job.status, runnerId: job.runner_id,
                  runnerName: job.runner_name, runnerGroupId: job.runner_group_id, runnerGroupName: job.runner_group_name, labels: job.labels },
                currentRef: { ref: current.ref, sha: current.object.sha } }
              jsonFile("actions-" + stage + ".json", value)
              return value
            }
            async function observeCheckout(stage, expectedSlot) {
              compareDirectories(rootDirectories)
              const head = asText((await git(stage + "-head", ["rev-parse", "HEAD"])).bytes).trim()
              const tree = asText((await git(stage + "-tree", ["rev-parse", "HEAD^{tree}"])).bytes).trim()
              need(head === SOURCE && tree === TREE, "Literal checkout C/T drift")
              const symbolic = await git(stage + "-detached", ["symbolic-ref", "-q", "HEAD"], [0, 1])
              need(symbolic.record.exitCode === 1 && symbolic.bytes.length === 0, "Checkout must remain detached at C")
              const index = (await git(stage + "-whole-index", ["ls-files", "--stage", "-z"])).bytes
              const tracked = (await git(stage + "-tracked", ["diff", "--no-ext-diff", "--no-textconv", "--exit-code"])).bytes
              const staged = (await git(stage + "-staged", ["diff", "--cached", "--no-ext-diff", "--no-textconv", "--exit-code"])).bytes
              need(tracked.length === 0 && staged.length === 0, "Tracked or staged bytes changed")
              const status = (await git(stage + "-status", ["status", "--porcelain=v1", "--untracked-files=all", "-z"])).bytes
              const expected = expectedSlot ? Buffer.from("?? " + SLOT + "\0") : Buffer.alloc(0)
              need(status.equals(expected), "Unexpected tracked/untracked worktree status")
              const ui = readRegular(path.join(checkout, ".ci-run.json"), UI_BYTES)
              need(sha256(ui.bytes) === UI_SHA256, "Original UI request bytes changed")
              if (baseline) {
                need(index.equals(baseline.index), "Whole index entries changed")
                need(ui.bytes.equals(baseline.ui), "Original UI request no longer equals before")
              }
              const result = { stage, observedAt: new Date().toISOString(), head, tree,
