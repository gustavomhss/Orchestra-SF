def ui_png(raw, expected_width):
    need(raw.startswith(b"\x89PNG\r\n\x1a\n") and len(raw) >= 45
         and raw[8:12] == b"\0\0\0\r" and raw[12:16] == b"IHDR",
         "UI_PNG_SIGNATURE_IHDR")
    width = int.from_bytes(raw[16:20], "big")
    height = int.from_bytes(raw[20:24], "big")
    need(0 < width <= 20000 and 0 < height <= 20000, "UI_PNG_DIMENSIONS")
    if expected_width is not None:
        need(width == expected_width, "UI_PNG_CAPTURE_VIEWPORT_WIDTH")
    offset, chunks, idat, ended = 8, 0, 0, False
    while offset < len(raw):
        need(offset + 12 <= len(raw), "UI_PNG_CHUNK_HEADER")
        length = int.from_bytes(raw[offset:offset + 4], "big")
        kind = raw[offset + 4:offset + 8]
        end = offset + 12 + length
        need(end <= len(raw) and re.fullmatch(b"[A-Za-z]{4}", kind) is not None,
             "UI_PNG_CHUNK_BOUNDS")
        crc = zlib.crc32(raw[offset + 4:offset + 8 + length]) & 0xffffffff
        need(crc == int.from_bytes(raw[offset + 8 + length:end], "big"), "UI_PNG_CHUNK_CRC")
        need((kind == b"IHDR") == (chunks == 0), "UI_PNG_IHDR_CARDINALITY")
        need(kind not in (b"acTL", b"fcTL", b"fdAT"), "UI_PNG_STATIC_CAPTURE_REQUIRED")
        if kind == b"IDAT":
            idat += 1
        if kind == b"IEND":
            need(length == 0 and end == len(raw) and idat > 0, "UI_PNG_IEND")
            ended = True
        chunks += 1
        offset = end
    need(ended and offset == len(raw), "UI_PNG_COMPLETE_CHUNKS")
    return {"width": width, "height": height, "pngChunks": chunks, "pngChunkCrcVerified": True,
            "decodedPixelsReviewed": False}

def parse_ui_runtime_and_pngs():
    selection_item, selection_raw, selection = one_ui_json("test-ci-evidence/playwright-selection.json")
    runtime_item, runtime_raw, runtime = one_ui_json("test-ci-evidence/playwright-runtime.json")
    request_item, request_raw, evidence_request = one_ui_json("test-ci-evidence/request.json")
    need(isinstance(evidence_request, dict) and set(evidence_request) == {"request", "platform", "arch", "sha"}
         and evidence_request["sha"] == SNAPSHOT and evidence_request["platform"] == "linux"
         and evidence_request["arch"] == "x64"
         and evidence_request["request"] == RECEIPT["originalRequest"]["normalized"],
         "UI_ARTIFACT_REQUEST_CANDIDATE_BINDING")
    selected = tests_from_report(selection)
    executed = tests_from_report(runtime)
    expected = CASE_OPTIONS[:2] if UI_BINDING["selectionMode"] == "analytics-2" else CASE_OPTIONS
    need(len(selected) == len(expected) and len(executed) == len(expected), "UI_EXACT_TEST_COUNT")
    for report, tests, label in ((selection, selected, "SELECTION"), (runtime, executed, "RUNTIME")):
        need(report.get("config", {}).get("rootDir") == PRODUCER_E2E_ROOT, label + "_EXACT_ROOT")
        for index, (spec, test, _) in enumerate(tests):
            need(spec.get("title") == expected[index]["title"]
                 and ui_report_file(spec.get("file")) == expected[index]["file"],
                 label + "_EXACT_CASE_FILE_TITLE_ORDER")
    selection_config = report_configuration(selection, selected, "SELECTION")
    runtime_config = report_configuration(runtime, executed, "RUNTIME")
    cases, all_markers, results, captures = [], [], [], {}
    owners = {}
    for index, (spec, test, _) in enumerate(executed):
        result_rows = test.get("results")
        need(isinstance(result_rows, list) and len(result_rows) == 1
             and isinstance(result_rows[0], dict), "UI_SINGLE_RESULT")
        result = result_rows[0]
        need(result.get("retry", 0) == 0 and test.get("expectedStatus", "passed") == "passed",
             "UI_RESULT_ATTEMPT")
        worker_index, parallel_index = result.get("workerIndex"), result.get("parallelIndex")
        need(type(worker_index) is int and worker_index >= 0
             and type(parallel_index) is int and parallel_index == 0, "UI_SINGLE_PARALLEL_WORKER")
        need(result.get("status") == UI_BINDING["caseStatuses"][index], "UI_CURRENT_CASE_VERDICT")
        attachments = result.get("attachments", [])
        need(isinstance(attachments, list) and len(attachments) <= CAP["entries"],
             "UI_ATTACHMENTS_SHAPE")
        for attachment_index, attachment in enumerate(attachments):
            need(isinstance(attachment, dict), "UI_ATTACHMENT_SHAPE")
            if attachment.get("contentType") == "image/png":
                need("body" not in attachment, "UI_PNG_ATTACHMENT_FILE_REQUIRED")
                member = ui_attachment_member(attachment.get("path"))
                owners.setdefault(member, []).append([index + 1, 1, attachment_index + 1])
        captured = marker_stream(result_rows, index + 1)
        need(len(captured["lines"]) <= CAP["traceRows"], "UI_MARKER_ROW_CAP")
        all_markers.extend(captured["lines"])
        if index == 0:
            for line in captured["lines"]:
                need(len(line.encode("utf-8")) <= CAP["jsonlLineBytes"], "UI_MARKER_LINE_CAP")
                if line.startswith("SF_ANALYTICS_CAPTURE "):
                    value = ui_json(line[len("SF_ANALYTICS_CAPTURE "):])
                    need(isinstance(value, dict) and set(value) == {"name", "width", "surface", "stage"},
                         "UI_CAPTURE_MARKER_SHAPE")
                    name = value["name"]
                    need(isinstance(name, str) and name not in captures
                         and name in PNG_REQUIRED_NAMES + PNG_CONDITIONAL_NAMES,
                         "UI_CAPTURE_EXACT_ALLOWLIST_AND_UNIQUENESS")
                    need(type(value["width"]) is int and value["width"] in (1440, 390, 320),
                         "UI_CAPTURE_VIEWPORT")
                    expected_width = 320 if "-320-" in name else 390 if "-390-" in name else 1440
                    need(value["width"] == expected_width, "UI_CAPTURE_NAME_WIDTH")
                    for field in ("surface", "stage"):
                        need(value[field] is None or isinstance(value[field], str)
                             and len(value[field].encode("utf-8")) <= 128
                             and all(ord(c) >= 32 and ord(c) != 127 for c in value[field]),
                             "UI_CAPTURE_ATTRIBUTE_BOUND")
                    captures[name] = value
        errors = result.get("errors", [])
        if not errors and isinstance(result.get("error"), dict):
            errors = [result["error"]]
        need(isinstance(errors, list), "UI_ERRORS_SHAPE")
        cases.append({"ordinal": index + 1, "file": expected[index]["file"], "title": expected[index]["title"],
                      "status": result["status"], "retry": 0, "workerIndex": worker_index,
                      "parallelIndex": parallel_index, "durationMs": result.get("duration"),
                      "startTime": result.get("startTime"), "errors": error_summary(errors),
                      "attachmentCount": len(attachments), "stdioStreams": captured["streams"]})
        results.append(result)
    marker_raw = (("\n".join(all_markers) + "\n") if all_markers else "").encode("utf-8")
    counts = {name: sum(line.startswith(name + " ") for line in all_markers) for name in SEMANTIC_PREFIXES}
    expected_markers = UI_BINDING["analyticsMarkers"]
    need(len(marker_raw) == expected_markers["bytes"] and digest(marker_raw) == expected_markers["sha256"]
         and counts == expected_markers["counts"], "UI_RUNTIME_MAIN_SEMANTIC_PARITY")
    write_bytes(ROOT / "derived" / "runtime-semantic-markers.lf.log", marker_raw)
    RECEIPT["captureSet"] = {"required": 33, "completeNamedPngSet": False,
        "missingCaptureMarkers": [name for name in PNG_REQUIRED_NAMES if name not in captures],
        "requiredMarkersPresent": sum(name in captures for name in PNG_REQUIRED_NAMES),
        "conditionalMarkersPresent": [name for name in PNG_CONDITIONAL_NAMES if name in captures],
        "visualAcceptance": False, "qualification": False}
    need(len(PNG_REQUIRED_NAMES) == 33 and len(set(PNG_REQUIRED_NAMES)) == 33
         and not RECEIPT["captureSet"]["missingCaptureMarkers"], "UI_REQUIRED_33_CAPTURES")
    target = results[0]
    attachment_by_name = {}
    allowed = PNG_REQUIRED_NAMES + PNG_CONDITIONAL_NAMES + [PNG_FAILURE_NAME]
    for attachment_index, attachment in enumerate(target.get("attachments", [])):
        name = attachment.get("name")
        if isinstance(name, str) and name.startswith(("UI42-", "UI43-", "UI44-")):
            need(name in allowed, "UI_UNEXPECTED_TARGET_ATTACHMENT")
        if name in allowed:
            need(name not in attachment_by_name and attachment.get("contentType") == "image/png"
                 and "body" not in attachment, "UI_EXACT_PNG_ATTACHMENT")
            attachment_by_name[name] = (attachment_index + 1, attachment)
    RECEIPT["captureSet"]["missingAttachments"] = [name for name in PNG_REQUIRED_NAMES
                                                    if name not in attachment_by_name]
    need(not RECEIPT["captureSet"]["missingAttachments"], "UI_REQUIRED_33_ATTACHMENTS")
    for name in PNG_CONDITIONAL_NAMES:
        need((name in captures) == (name in attachment_by_name), "UI_CONDITIONAL_MARKER_ATTACHMENT_PARITY")
    failure_present = PNG_FAILURE_NAME in attachment_by_name
    need(not failure_present or target["status"] != "passed", "UI_FAILURE_CAPTURE_VERDICT")
    names = (PNG_REQUIRED_NAMES + [name for name in PNG_CONDITIONAL_NAMES if name in captures]
             + ([PNG_FAILURE_NAME] if failure_present else []))
    need(33 <= len(names) <= MAX_PNG_EXPORTS and set(attachment_by_name) == set(names),
         "UI_EXACT_PRESENT_CAPTURE_SET")
    pngs, seen_files = [], set()
    for name in names:
        attachment_index, attachment = attachment_by_name[name]
        member = ui_attachment_member(attachment["path"])
        need(owners.get(member) == [[1, 1, attachment_index]], "UI_ATTACHMENT_UNIQUE_RESULT_OWNER")
        matching = [item for item in FILES if item["archive"] == 0 and not item["directory"]
                    and item["path"] == member]
        need(len(matching) == 1, "UI_ATTACHMENT_EXACT_OUTER_MEMBER")
        item = matching[0]
        need(item["id"] not in seen_files and item.get("crcVerified") is True,
             "UI_PNG_DISTINCT_CRC_VERIFIED_MEMBER")
        seen_files.add(item["id"])
        raw = read_file(item, CORE_CAP["png"])
        marker = captures.get(name)
        image = ui_png(raw, marker["width"] if marker else None)
        owner = {"case": 1, "result": 1, "attachment": attachment_index, "caseFile": expected[0]["file"],
                 "caseTitle": expected[0]["title"], "captureName": name, "archive": item["archive"],
                 "member": item["path"], "file": item["id"], "mime": "image/png",
                 "bytes": item["bytes"], "sha256": item["sha256"], "zipCrc32": item["crc32"],
                 "zipCrcVerified": True, "captureMarker": marker, **image}
        pngs.append({"name": name + ".png", "file": item["id"], "raw": raw, "owner": owner})
    RECEIPT["parsers"]["selection"] = {"file": selection_item["id"], "bytes": len(selection_raw),
        "sha256": digest(selection_raw), "tests": len(selected), "config": selection_config}
    RECEIPT["parsers"]["runtime"] = {"file": runtime_item["id"], "bytes": len(runtime_raw),
        "sha256": digest(runtime_raw), "tests": len(executed), "config": runtime_config, "cases": cases,
        "semanticMarkers": {"bytes": len(marker_raw), "sha256": digest(marker_raw), "counts": counts,
                            "matchesOriginalMainSequence": True,
                            "order": "case/result order, stdout then stderr; no clock interleaving is inferred"}}
    RECEIPT["parsers"]["artifactRequest"] = {"file": request_item["id"], "bytes": len(request_raw),
        "sha256": digest(request_raw), "snapshot": SNAPSHOT, "normalizedRequestMatches": True}
    RECEIPT["parsers"]["targetPngs"] = [png["owner"] for png in pngs]
    RECEIPT["captureSet"] = {"required": 33, "requiredPresent": 33,
        "conditionalPresent": sum(name in captures for name in PNG_CONDITIONAL_NAMES),
        "failurePresent": failure_present, "pngFiles": len(pngs), "completeNamedPngSet": True,
        "decodedPixelsReviewed": False, "visualAcceptance": False, "qualification": False}
    checked("original_runtime_selection_request_and_main_semantic_parity")
    checked("all33_required_pngs_and_present_conditionals_exact_case_attachment_member_ownership")
    checked("original_pngs_zip_crc_png_chunk_crc_sha256_and_ihdr_dimensions")
    return pngs

def ensure_inventory():
    if "inventory" not in RECEIPT:
        inventory = {"schema": 1, "archives": ARCHIVES, "files": FILES}
        RECEIPT["inventory"] = save_json("derived/inventory.json", inventory)
    return RECEIPT["inventory"]

def prepare_core_export(key, name, raw, mime, original, original_file=None):
    need(key in CORE_CAP and isinstance(raw, bytes) and len(raw) <= CORE_CAP[key],
         "CORE_RAW_CAP_" + key)
    if original:
        need(key == "png" and type(original_file) is int
             and 0 <= original_file < len(FILES), "CORE_ORIGINAL_INVENTORY_BINDING")
        item = FILES[original_file]
        need(not item["directory"] and item["id"] == original_file
             and item["bytes"] == len(raw) and item["sha256"] == digest(raw),
             "CORE_ORIGINAL_INVENTORY_BYTES")
    else:
        need(original_file is None and len(raw) > 0, "CORE_DERIVED_NONEMPTY")
    encoded = base64.b64encode(raw).decode("ascii")
    pieces = ([encoded[i:i + CAP["chunkBytes"]] for i in range(0, len(encoded), CAP["chunkBytes"])]
              if encoded else [""])
    metadata = {"name": name, "bytes": len(raw), "sha256": digest(raw), "mime": mime,
                "original": original, "encoding": "base64", "chunks": len(pieces)}
    if original:
        metadata["file"] = original_file
    lines = []
    for index, piece in enumerate(pieces, 1):
        envelope = {"schema": 1, **metadata, "index": index}
        # Bound all metadata plus empty data and transport prefix/LF, not just one field.
        need(len(wire_line("SF613_ARTIFACT_BYTES", {**envelope, "data": ""})) <= 1024,
             "CORE_CHUNK_METADATA_CAP")
        need((0 < len(piece) <= CAP["chunkBytes"]) or
             (len(raw) == 0 and original and len(pieces) == 1 and index == 1 and piece == ""),
             "CORE_BASE64_CHUNK_CAP")
        lines.append(wire_line("SF613_ARTIFACT_BYTES", {**envelope, "data": piece}))
    return {"key": key, "metadata": metadata, "lines": lines}
def finalize_core(pngs):
    global CORE_LINES_WRITTEN, PNG_EMISSION_BUDGET
    need(33 <= len(pngs) <= MAX_PNG_EXPORTS and RECEIPT["captureSet"]["completeNamedPngSet"] is True,
         "PNG_CORE_COMPLETE_SET_REQUIRED")
    expected_names = (PNG_REQUIRED_NAMES + [name for name in PNG_CONDITIONAL_NAMES
                      if any(png["owner"]["captureName"] == name for png in pngs)]
                      + ([PNG_FAILURE_NAME] if RECEIPT["captureSet"]["failurePresent"] else []))
    need([png["name"] for png in pngs] == [name + ".png" for name in expected_names]
         and len({png["file"] for png in pngs}) == len(pngs), "PNG_CORE_EXACT_PRESENT_EXPORTS")
    inventory = ensure_inventory()
    inventory_raw = (ROOT / inventory["path"]).read_bytes()
    need(len(inventory_raw) == inventory["bytes"] and digest(inventory_raw) == inventory["sha256"],
         "INVENTORY_BYTES_CHANGED")
    RECEIPT["apiReads"] = API_COUNT
    RECEIPT["archiveSummary"] = {
        "archives": len(ARCHIVES), "entries": TOTAL_ENTRIES,
        "crcVerified": sum(1 for row in FILES if row.get("crcVerified")),
        "expandedBytes": TOTAL_EXPANDED,
        "allEntriesVerified": bool(FILES) and all(row.get("crcVerified") is True for row in FILES),
    }
    need(RECEIPT["archiveSummary"]["allEntriesVerified"] is True and not RECEIPT["failures"],
         "CORE_REQUIRED_VALIDATION_FAILURE")
    summary = canonical({
        "schema": 1, "kind": "ui42-44-original-png-summary", "qualification": False,
        "source": SOURCE, "sourceTree": SOURCE_TREE, "snapshot": SNAPSHOT, "snapshotTree": SNAPSHOT_TREE,
        "run": ORIGINAL_RUN, "attempt": 1, "artifact": RECEIPT["artifact"],
        "selection": RECEIPT["parsers"]["selection"], "runtime": RECEIPT["parsers"]["runtime"],
        "artifactRequest": RECEIPT["parsers"]["artifactRequest"],
        "captureSet": RECEIPT["captureSet"], "targetPngs": RECEIPT["parsers"]["targetPngs"],
        "archiveSummary": RECEIPT["archiveSummary"], "limits": RECEIPT["limits"],
    })
    write_bytes(ROOT / "derived" / "safe-summary.json", summary)
    first_payloads = [
        ("png", png["name"], png["raw"], "image/png", True, png["file"]) for png in pngs]
    first_payloads.extend([
        ("summary", "safe-summary.json", summary, "application/json", False, None),
        ("inventory", "inventory.json", inventory_raw, "application/json", False, None),
    ])
    prepared = [prepare_core_export(*item) for item in first_payloads]
    RECEIPT["coreEmission"] = {
        "state": "PLANNED_REQUIRES_SUCCESS_TERMINAL",
        "order": [item["metadata"]["name"] for item in prepared] + ["receipt.json"],
        "payloadsBeforeReceipt": [item["metadata"] for item in prepared],
        "completeNamedPngSet": True, "requiredPngs": 33, "maximumPngs": MAX_PNG_EXPORTS,
        "absentConditionalHasNoExport": True, "noRequiredCaptureMayBeDroppedToFit": True,
        "rawCaps": CORE_CAP, "beforeBytes": LOG_BYTES,
        "exactPreflight": "All immutable PNGs, metadata, inventory, frozen receipt and terminal are encoded and jointly checked before the first payload.",
        "completion": "Every ordered hash-verified export, the success terminal and successful reader/preservation steps are required. Transport does not constitute visual or product acceptance.",
        "selfReference": "This receipt has no own hash. Its exact bytes/hash are attested by the terminal.",
    }
    RECEIPT["preservation"] = {
        "originalZipPath": "original.zip", "originalBytes": ARTIFACT_BYTES, "originalSha256": ARTIFACT_SHA,
        "allOriginalsRetainedOnRunner": True, "alwaysUploadWorkflowRequired": True,
        "auditArtifactRetentionDays": 7, "auditUploadNotYetObserved": True,
        "wholeOriginalZipExportedInLog": False, "permanentRemoteRetentionClaim": False,
    }
    RECEIPT["readerExitCodePlanned"] = 0
    # Freeze once, before any payload is emitted.
    receipt_raw = canonical(RECEIPT)
    prepared.append(prepare_core_export("receipt", "receipt.json", receipt_raw, "application/json", False))
    need([item["key"] for item in prepared] == ["png"] * len(pngs) + ["summary", "inventory", "receipt"]
         and len(prepared) == len(pngs) + 3 and 36 <= len(prepared) <= MAX_CORE_EXPORTS,
         "PNG_CORE_EXACT_EXPORT_COUNT")
    core_lines = tuple(line for item in prepared for line in item["lines"])
    core_bytes = sum(len(line) for line in core_lines)
    before_bytes = LOG_BYTES
    final = {
        "schema": 1, "kind": "ui42-44-png-terminal", "qualification": False,
        "status": RECEIPT["status"], "coreBytesComplete": True, "receiptBase64Complete": True,
        "completeNamedPngSet": True, "visualAcceptance": False,
        "requiredPngs": 33, "pngFiles": len(pngs),
        "coreFiles": len(prepared), "coreChunks": len(core_lines),
        "corePayloadBytes": sum(item["metadata"]["bytes"] for item in prepared),
        "coreLogBytes": core_bytes, "logBytesBeforeCore": before_bytes,
        "logBytesBeforeTerminal": before_bytes + core_bytes,
        "emitterCapBytes": CAP["logBytes"], "mainLogReviewCapBytes": CAP["mainLogReviewCapBytes"],
        "receiptBytes": len(receipt_raw), "receiptSha256": digest(receipt_raw),
        "exports": [item["metadata"] for item in prepared],
        "entries": TOTAL_ENTRIES, "crcVerified": RECEIPT["archiveSummary"]["crcVerified"],
        "expandedBytes": TOTAL_EXPANDED, "pending": len(RECEIPT["pending"]),
        "originalZipPreservationUploadPending": True, "failures": [], "readerExitCode": 0,
    }
    terminal_raw = wire_line("SF613_ARTIFACT_RECEIPT", final)
    total_bytes = before_bytes + core_bytes + len(terminal_raw)
    PNG_EMISSION_BUDGET = {"coreFiles": len(prepared), "pngFiles": len(pngs),
        "coreChunks": len(core_lines), "beforeBytes": before_bytes, "coreLogBytes": core_bytes,
        "terminalBytes": len(terminal_raw), "totalEmitterBytes": total_bytes,
        "capBytes": CAP["logBytes"], "mainLogReviewCapBytes": CAP["mainLogReviewCapBytes"]}
    need(total_bytes <= CAP["logBytes"], "PNG_CORE_JOINT_LOG_BUDGET")
    plan = {"schema": 1, **PNG_EMISSION_BUDGET,
            "terminalSha256": digest(terminal_raw), "exports": final["exports"]}
    # Disk preservation and the exact complete preflight precede the first payload.
    write_bytes(ROOT / "receipt.json", receipt_raw)
    save_json("derived/core-emission-plan.json", plan)
    for raw in core_lines:
        write_wire(raw)
        CORE_LINES_WRITTEN += 1
    need(LOG_BYTES == before_bytes + core_bytes and CORE_LINES_WRITTEN == len(core_lines),
         "CORE_EMITTED_COUNT_MISMATCH")
    write_wire(terminal_raw)
    need(LOG_BYTES == total_bytes, "CORE_FINAL_EMITTED_BYTES_MISMATCH")

def report_failure(code, error_type=None):
    # No exception text/traceback: it could contain a signed URL. Never emit a success terminal here.
    failure = {"code": code}
    if error_type is not None:
        failure["type"] = error_type
    RECEIPT["status"] = "RECEIPT_FAILED"
    RECEIPT["failures"].append(failure)
    RECEIPT["readerExitCode"] = 1
    RECEIPT["apiReads"] = API_COUNT
    receipt_meta = None
    try:
        failure_raw = canonical(RECEIPT)
        if len(failure_raw) <= CORE_CAP["receipt"]:
            write_bytes(ROOT / "failure-receipt.json", failure_raw)
            receipt_meta = {"bytes": len(failure_raw), "sha256": digest(failure_raw)}
    except Exception:
        pass
    terminal = {
        "schema": 1, "kind": "ui42-44-png-terminal", "qualification": False, "status": "RECEIPT_FAILED",
        "coreBytesComplete": False, "receiptBase64Complete": False, "readerExitCode": 1,
        "coreChunksWritten": CORE_LINES_WRITTEN, "logBytesBeforeTerminal": LOG_BYTES,
        "failures": [failure], "failureReceipt": receipt_meta,
        "mode": MODE, "captureSet": RECEIPT.get("captureSet"),
        "emissionBudget": PNG_EMISSION_BUDGET,
        "limit": "No complete transport is accepted without every listed present payload, success terminal and successful job; capture completion is separate.",
    }
    try:
        write_wire(wire_line("SF613_ARTIFACT_RECEIPT", terminal))
    except Exception:
        # A broken stdout may prevent even a failure terminal; process exit remains nonzero.
        pass

def main():
    check_original_and_reader()
    download_original()
    inspect_zip(ROOT / "original.zip", "original-artifact", 0)
    unpack_html_reports()
    checked("all_discovered_zip_entries_crc_sha256_and_safe_paths")
    pngs = parse_ui_runtime_and_pngs()
    need(not RECEIPT["failures"], "REQUIRED_PARSER_FAILURE")
    RECEIPT["status"] = "ORIGINAL_PNG_BYTES_VERIFIED_NOT_VISUALLY_ACCEPTED"
    RECEIPT["qualification"] = False
    RECEIPT["limits"] = [
        "This reader receives one bound original ZIP. It never checks out or executes repository product, tests or observers.",
        "All33 required named PNGs must exist with exact case/result/attachment/member ownership. Missing required images fail the complete mode.",
        "The two optional scroll captures require both their same-result capture marker and attachment. The optional failure image requires that same result to be non-passed.",
        "Original ZIP entries are read to EOF and independently CRC/SHA verified. PNG chunks are CRC checked without pixel decompression or rendering.",
        "PNG signature, IHDR, CRC and hashes do not constitute visual acceptance; a reviewer must inspect the exact exported bytes.",
        "The fixed upload layout and absolute Linux attachment path must map to one exact archive0 member. No suffix, basename, first-match or latest-match fallback exists.",
        "Every selected original PNG is exported unchanged. JPEG previews, HTML rendering, resized or regenerated images are never substitutes.",
        "Raw runtime, selection, original request, HTML and error contexts remain in the preserved audit artifact; only safe summaries and selected PNGs enter the payload transport.",
        "Semantic parity binds runtime case/result stdout-then-stderr marker order to the independently received original main. It makes no cross-stream clock claim.",
        "All PNGs plus metadata, inventory, receipt and terminal must jointly fit7MiB before the first payload. No required PNG is omitted to fit.",
        "The independent receiver must authenticate the whole original reader Actions main and enforce8MiB including Actions framing.",
        "The always-upload step must preserve original.zip and receipt. Its7day retention is not permanent archival and the whole original ZIP is not exported in this log.",
        "An incomplete capture set, oversized PNG, metadata overflow, budget excess or interrupted transport yields no complete receipt or visual acceptance.",
        "The original2Analytics or6UI6 test selection, waits and fixtures are unchanged. This receipt grants no new area acceptance, merge or production authorization.",
