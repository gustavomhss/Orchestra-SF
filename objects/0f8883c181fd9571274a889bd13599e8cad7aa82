    raw = read_file(rows[0], CAP["jsonBytes"])
    try:
        data = json.loads(raw)
    except (ValueError, UnicodeError):
        raise ReceiptFailure("ORIGINAL_JSON_PARSE") from None
    return rows[0], raw, data

def unpack_html_reports():
    reports = locate_suffix("playwright-report/index.html", outer_only=True)
    if not reports:
        pending("HTML_REPORT_ABSENT")
        return
    parsed = []
    for item in reports:
        raw = read_file(item, CAP["htmlBytes"])
        text = raw.decode("utf-8")
        # Read only the embedded archive string. No HTML/JavaScript is evaluated.
        found = re.findall(r'data:application/zip;base64,([A-Za-z0-9+/=\r\n]+)', text)
        if not found:
            assignments = re.findall(r'playwrightReportBase64\s*=\s*["\x27]([A-Za-z0-9+/=\r\n]+)["\x27]', text)
            found = assignments
        need(len(found) <= 1, "HTML_REPORT_ARCHIVE_AMBIGUOUS")
        if not found:
            pending("HTML_REPORT_EMBEDDED_ARCHIVE_UNRECOGNIZED", {"file": item["id"]})
            continue
        encoded = re.sub(r"[\r\n]", "", found[0])
        need(len(encoded) <= CAP["htmlBytes"], "HTML_REPORT_BASE64_CAP")
        decoded = base64.b64decode(encoded, validate=True)
        need(len(decoded) <= CAP["htmlBytes"] and decoded.startswith(b"PK"), "HTML_REPORT_ZIP")
        filename = ROOT / "originals" / ("html-embedded-" + str(item["id"]) + ".zip")
        write_bytes(filename, decoded)
        nested_id = inspect_zip(filename, "html-report-embedded", 1, item["id"])
        parsed.append({"htmlFile": item["id"], "zipBytes": len(decoded),
                       "zipSha256": digest(decoded), "archive": nested_id})
    RECEIPT["parsers"]["htmlArchives"] = parsed

def tests_from_report(report):
    tests = []
    visited = 0
    def visit(suite, trail, depth):
        nonlocal visited
        visited += 1
        need(visited <= 10000 and depth <= 32 and isinstance(suite, dict), "REPORT_SUITE_CAP")
        for spec in suite.get("specs", []):
            need(isinstance(spec, dict), "REPORT_SPEC_SHAPE")
            for test in spec.get("tests", []):
                need(isinstance(test, dict), "REPORT_TEST_SHAPE")
                tests.append((spec, test, trail))
        for child in suite.get("suites", []):
            visit(child, trail + [suite.get("title", "")], depth + 1)
    need(isinstance(report, dict) and isinstance(report.get("suites"), list), "REPORT_ROOT_SHAPE")
    for suite in report["suites"]:
        visit(suite, [], 0)
    return tests

def report_configuration(report, tests, label):
    config = report.get("config", {})
