         and isinstance(intake["gitBlob"], str) and re.fullmatch(r"[a-f0-9]{40}", intake["gitBlob"])
         and type(intake["bytes"]) is int and 0 < intake["bytes"] <= CAP["apiBytes"]
         and isinstance(intake["sha256"], str) and re.fullmatch(r"[a-f0-9]{64}", intake["sha256"]),
