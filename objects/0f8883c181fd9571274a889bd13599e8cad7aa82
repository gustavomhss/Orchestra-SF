def error_summary(errors):
    out = []
    for error in errors:
        if not isinstance(error, dict):
            continue
        message = str(error.get("message", ""))
        stack = str(error.get("stack", ""))
        combined = message + "\n" + stack
        position = re.search(r"design-wave-five-analytics\.spec\.ts:(\d+):(\d+)", combined)
        out.append({
            "timeout60000": bool(re.search(r"Timeout\s+60000ms|60000\s*ms", combined)),
            "waitForResponse": "waitForResponse" in combined,
            "source": {"file": "design-wave-five-analytics.spec.ts",
                       "line": int(position.group(1)), "column": int(position.group(2))} if position else None,
            "messageBytes": len(message.encode("utf-8")), "messageSha256": digest(message.encode("utf-8")),
            "stackBytes": len(stack.encode("utf-8")), "stackSha256": digest(stack.encode("utf-8")),
        })
    return out

def marker_stream(results, case_ordinal):
    all_lines = []
    streams = []
    pattern = re.compile(r"^(?:\x1b\[[0-?]*[ -/]*[@-~])*"
                         r"(SF_ANALYTICS_SOURCE|SF_ANALYTICS_CAPTURE|SF_DESIGN_DIAGNOSTICS|SF_ANALYTICS_SCOPE) (.*)$")
    for result_ordinal, result in enumerate(results, 1):
        for field in ("stdout", "stderr"):
            chunks = []
            size = 0
            for chunk in result.get(field, []):
                need(isinstance(chunk, dict), "RUNTIME_STDIO_CHUNK_SHAPE")
                if isinstance(chunk.get("text"), str) and "buffer" not in chunk:
                    raw = chunk["text"].encode("utf-8")
                elif isinstance(chunk.get("buffer"), str) and "text" not in chunk:
                    encoded = chunk["buffer"]
                    need(len(encoded) <= (CAP["jsonBytes"] * 4 // 3 + 4), "RUNTIME_STDIO_BASE64_CAP")
                    raw = base64.b64decode(encoded, validate=True)
                else:
                    raise ReceiptFailure("RUNTIME_STDIO_CHUNK_ENCODING")
                size += len(raw)
                need(size <= CAP["jsonBytes"], "RUNTIME_STDIO_STREAM_CAP")
                chunks.append(raw)
            # Decode only after concatenating one stream: a chunk may split a UTF-8 character.
            stream_raw = b"".join(chunks)
            text = stream_raw.decode("utf-8", errors="strict")
            lines = []
            for line in text.splitlines():
                match = pattern.match(line)
                if match:
                    lines.append(match.group(1) + " " + match.group(2))
            marker_raw = (("\n".join(lines) + "\n") if lines else "").encode("utf-8")
            marker_path = ("derived/runtime-case-" + str(case_ordinal) + "-result-"
                           + str(result_ordinal) + "-" + field + "-semantic-markers.lf.log")
            write_bytes(ROOT / marker_path, marker_raw)
            streams.append({"case": case_ordinal, "result": result_ordinal, "stream": field,
                            "bytes": len(stream_raw), "sha256": digest(stream_raw),
                            "markerBytes": len(marker_raw), "markerSha256": digest(marker_raw),
                            "markerPath": marker_path, "markerLines": len(lines)})
            all_lines.extend(lines)
    return {"lines": all_lines, "streams": streams}

