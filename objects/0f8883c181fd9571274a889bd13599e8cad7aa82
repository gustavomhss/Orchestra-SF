class ReceiptFailure(Exception):
    def __init__(self, code):
        self.code = code
        super().__init__(code)

def need(value, code):
    if not value:
        raise ReceiptFailure(code)

def digest(data):
    return hashlib.sha256(data).hexdigest()

def canonical(value):
    return (json.dumps(value, ensure_ascii=True, sort_keys=True, indent=2) + "\n").encode("ascii")

def write_bytes(path, data):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with open(path, "xb") as handle:
        handle.write(data)

def save_json(relative, value):
    data = canonical(value)
    write_bytes(ROOT / relative, data)
    return {"path": relative, "bytes": len(data), "sha256": digest(data)}

def checked(code):
    RECEIPT["checks"].append(code)

def pending(code, detail=None):
    item = {"code": code}
    if detail is not None:
        item["detail"] = detail
    RECEIPT["pending"].append(item)

def wire_line(prefix, value):
    raw = (prefix + " " + json.dumps(value, ensure_ascii=True, separators=(",", ":")) + "\n").encode("ascii")
    need(len(raw) <= 32768, "LOG_LINE_EXCEEDS_32_KIB")
    return raw

def write_wire(raw):
    global LOG_BYTES
    need(isinstance(raw, bytes) and len(raw) <= 32768
         and LOG_BYTES + len(raw) <= CAP["logBytes"], "LOG_PREFLIGHT_BUDGET_CHANGED")
    written = sys.stdout.buffer.write(raw)
    need(written == len(raw), "LOG_SHORT_WRITE")
    sys.stdout.buffer.flush()
    LOG_BYTES += len(raw)

class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None

NO_REDIRECT = urllib.request.build_opener(NoRedirect())
TOKEN = os.environ.get("GH_TOKEN", "")

def bounded_read(handle, limit):
    chunks = []
    count = 0
    while True:
        block = handle.read(min(1024 * 1024, limit + 1 - count))
        if not block:
            break
        count += len(block)
        need(count <= limit, "HTTP_BODY_CAP")
        chunks.append(block)
    return b"".join(chunks)

def api(route, label):
    global API_COUNT
    need(route.startswith("/") and "\n" not in route, "API_ROUTE_INVALID")
    request = urllib.request.Request(
        "https://api.github.com/repos/" + REPO + route,
        headers={"Authorization": "Bearer " + TOKEN,
                 "Accept": "application/vnd.github+json",
                 "X-GitHub-Api-Version": "2022-11-28",
                 "User-Agent": "sf613-original-artifact-reader"},
    )
    try:
        with NO_REDIRECT.open(request, timeout=45) as response:
            need(response.status == 200, "API_STATUS")
            raw = bounded_read(response, CAP["apiBytes"])
    except urllib.error.HTTPError as error:
        raise ReceiptFailure("API_HTTP_" + str(error.code)) from None
    except (urllib.error.URLError, TimeoutError):
        raise ReceiptFailure("API_TRANSPORT") from None
    API_COUNT += 1
    write_bytes(ROOT / "api" / (label + ".json"), raw)
    try:
        return json.loads(raw)
    except (ValueError, UnicodeError):
        raise ReceiptFailure("API_JSON_INVALID") from None

def pages(route, key, prefix):
    all_rows = []
    total = None
    for number in range(1, 21):
        separator = "&" if "?" in route else "?"
        data = api(route + separator + "per_page=100&page=" + str(number), prefix + "-" + str(number))
        need(isinstance(data, dict) and isinstance(data.get(key), list), "API_COLLECTION_SHAPE")
        if total is None:
            total = data.get("total_count")
            need(isinstance(total, int) and 0 <= total <= 2000, "API_COLLECTION_TOTAL")
        need(data.get("total_count") == total, "API_COLLECTION_CHANGED")
        all_rows.extend(data[key])
        if len(all_rows) >= total:
            need(len(all_rows) == total, "API_COLLECTION_COUNT")
            return all_rows
        need(len(data[key]) == 100, "API_COLLECTION_INCOMPLETE")
    raise ReceiptFailure("API_COLLECTION_PAGE_CAP")

def ui_unique_object(pairs):
    value = {}
    for key, item in pairs:
        need(key not in value, "UI_JSON_DUPLICATE_KEY")
        value[key] = item
    return value

def ui_bad_constant(value):
    raise ReceiptFailure("UI_JSON_NONFINITE_NUMBER")

def ui_json(raw):
    try:
        return json.loads(raw, object_pairs_hook=ui_unique_object, parse_constant=ui_bad_constant)
    except (ValueError, UnicodeError):
        raise ReceiptFailure("UI_JSON_PARSE") from None

def check_original_and_reader():
    need(MODE == "ui42-44-complete-original-png-v1" and isinstance(UI_BINDING, dict)
         and UI_BINDING.get("complete") is True, "UI_CAPTURE_BINDINGS_UNBOUND")
    keys = {"complete", "readerBranch", "source", "sourceTree", "snapshot", "snapshotTree",
            "originalRun", "mainJob", "cleanupJob", "artifactId", "artifactName", "artifactBytes",
            "artifactSha256", "runConclusion", "mainConclusion", "testStepConclusion",
            "selectionMode", "caseStatuses", "analyticsMarkers", "mainIntake"}
    need(set(UI_BINDING) == keys, "UI_BINDING_FIELDS")
    need(isinstance(BRANCH, str) and re.fullmatch(r"sf613-artifact-png-[a-z0-9-]{1,48}", BRANCH)
         and "unbound" not in BRANCH.lower(), "UI_READER_BRANCH_UNBOUND")
    for field in ("source", "sourceTree", "snapshot", "snapshotTree"):
        need(isinstance(UI_BINDING[field], str)
             and re.fullmatch(r"[a-f0-9]{40}", UI_BINDING[field]), "UI_GIT_BINDING")
    for field in ("originalRun", "mainJob", "cleanupJob", "artifactId", "artifactBytes"):
        need(type(UI_BINDING[field]) is int and 0 < UI_BINDING[field] < 2 ** 53,
             "UI_INTEGER_BINDING")
    need(ARTIFACT_BYTES <= ORIGINAL_ZIP_CAP_BYTES, "UI_ORIGINAL_ZIP_SIZE_CAP")
    need(MAIN_JOB != CLEANUP_JOB and ARTIFACT_NAME == "playwright-ubuntu-24.04-1"
         and isinstance(ARTIFACT_SHA, str) and re.fullmatch(r"[a-f0-9]{64}", ARTIFACT_SHA),
         "UI_ARTIFACT_BINDING")
    need(ORIGINAL_CONCLUSION in ("success", "failure")
         and MAIN_CONCLUSION == ORIGINAL_CONCLUSION
         and TEST_STEP_CONCLUSION == MAIN_CONCLUSION, "UI_TERMINAL_BINDING")
    selection_mode = UI_BINDING["selectionMode"]
    need(selection_mode in REQUEST_OPTIONS, "UI_SELECTION_MODE")
    expected_cases = CASE_OPTIONS[:2] if selection_mode == "analytics-2" else CASE_OPTIONS
