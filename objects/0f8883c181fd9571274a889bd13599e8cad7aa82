    markers = UI_BINDING["analyticsMarkers"]
    need(isinstance(markers, dict) and set(markers) == {"bytes", "sha256", "counts"}
         and type(markers["bytes"]) is int and 0 < markers["bytes"] <= CAP["jsonBytes"]
         and isinstance(markers["sha256"], str) and re.fullmatch(r"[a-f0-9]{64}", markers["sha256"])
         and isinstance(markers["counts"], dict) and set(markers["counts"]) == set(SEMANTIC_PREFIXES)
