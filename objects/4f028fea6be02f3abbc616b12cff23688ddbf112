                        need(kind in (0, stat.S_IFDIR if directory else stat.S_IFREG),\n                             \"ZIP_SPECIAL_FILE_OR_SYMLINK\")\n                        need((entry.flag_bits & 1) == 0, \"ZIP_ENCRYPTED_ENTRY\")\n                        need(entry.compress_type in (zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED),\n                             \"ZIP_COMPRESSION_UNSUPPORTED\")\n                        need(0 <= entry.file_size <= CAP[\"entryBytes\"], \"ZIP_ENTRY_SIZE_CAP\")\n                        need(TOTAL_EXPANDED + entry.file_size <= CAP[\"expandedBytes\"], \"ZIP_EXPANDED_CAP\")\n                        destination = output_root.joinpath(*pieces)\n                        need(output_root == destination.parent or output_root in destination.parents,\n                             \"ZIP_DESTINATION_ESCAPE\")\n                        TOTAL_ENTRIES += 1\n                        file_id = len(FILES)\n                        item = {\n                            \"id\": file_id, \"archive\": archive_index, \"path\": name, \"directory\": directory,\n                            \"compressedBytes\": entry.compress_size, \"declaredBytes\": entry.file_size,\n                            \"expectedCrc32\": format(entry.CRC, \"08x\"),\n                            \"storedPath\": str(destination.relative_to(ROOT)),\n                        }\n                        FILES.append(item)\n                        if directory:\n                            need(entry.file_size == 0 and entry.CRC == 0, \"ZIP_DIRECTORY_PAYLOAD\")\n                            with source.open(entry, \"r\") as original:\n                                need(original.read(1) == b\"\", \"ZIP_DIRECTORY_PAYLOAD\")\n                            destination.mkdir(mode=0o700, parents=True, exist_ok=True)\n                            item.update({\"bytes\": 0, \"sha256\": digest(b\"\"), \"crc32\": \"00000000\", \"crcVerified\": True})\n                        else:\n                            destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)\n                            hasher = hashlib.sha256()\n                            crc = 0\n                            size = 0\n                            # zipfile checks the local header and EOF CRC as well; calculate independently.\n                            with source.open(entry, \"r\") as original, open(destination, \"xb\") as target:\n                                while True:\n                                    block = original.read(1024 * 1024)\n                                    if not block:\n                                        break\n                                    size += len(block)\n                                    TOTAL_EXPANDED += len(block)\n                                    need(size <= entry.file_size and size <= CAP[\"entryBytes\"]\n                                         and TOTAL_EXPANDED <= CAP[\"expandedBytes\"], \"ZIP_ACTUAL_EXPANSION_CAP\")\n                                    target.write(block)\n                                    hasher.update(block)\n                                    crc = zlib.crc32(block, crc)\n                            need(size == entry.file_size and (crc & 0xffffffff) == entry.CRC, \"ZIP_CRC_OR_SIZE\")\n                            item.update({\"bytes\": size, \"sha256\": hasher.hexdigest(),\n                                         \"crc32\": format(crc & 0xffffffff, \"08x\"), \"crcVerified\": True})\n                            with open(destination, \"rb\") as header:\n                                magic = header.read(4)\n                            if name.lower().endswith(\".zip\") or magic in (b\"PK\\x03\\x04\", b\"PK\\x05\\x06\"):\n                                nested.append((destination, \"zip-entry\", file_id))\n                        archive[\"entries\"] += 1\n                        archive[\"crcVerified\"] += 1\n                        archive[\"expandedBytes\"] += entry.file_size\n                archive[\"status\"] = \"CRC_VERIFIED\"\n                for destination, nested_label, file_id in nested:\n                    inspect_zip(destination, nested_label, depth + 1, file_id)\n                return archive_index\n            \n            def read_file(item, limit):\n                need(not item[\"directory\"] and item[\"bytes\"] <= limit, \"PARSER_INPUT_CAP\")\n                data = (ROOT / item[\"storedPath\"]).read_bytes()\n                need(len(data) == item[\"bytes\"] and digest(data) == item[\"sha256\"], \"EXTRACTED_FILE_CHANGED\")\n                return data\n            \n            def locate_suffix(suffix, outer_only=False):\n                rows = [row for row in FILES if not row[\"directory\"]\n                        and (not outer_only or row[\"archive\"] == 0)\n                        and (row[\"path\"] == suffix or row[\"path\"].endswith(\"/\" + suffix))]\n                return rows\n            \n            def one_original_json(suffix):\n                rows = locate_suffix(suffix, outer_only=True)\n                need(len(rows) == 1, \"ORIGINAL_JSON_CARDINALITY_\" + suffix.replace(\".\", \"_\"))\n                raw = read_file(rows[0], CAP[\"jsonBytes\"])\n                try:\n                    data = json.loads(raw)\n                except (ValueError, UnicodeError):\n                    raise ReceiptFailure(\"ORIGINAL_JSON_PARSE\") from None\n                return rows[0], raw, data\n            \n            def unpack_html_reports():\n                reports = locate_suffix(\"playwright-report/index.html\", outer_only=True)\n                if not reports:\n                    pending(\"HTML_REPORT_ABSENT\")\n                    return\n                parsed = []\n                for item in reports:\n                    raw = read_file(item, CAP[\"htmlBytes\"])\n                    text = raw.decode(\"utf-8\")\n                    # Read only the embedded archive string. No HTML/JavaScript is evaluated.\n                    found = re.findall(r'data:application/zip;base64,([A-Za-z0-9+/=\\r\\n]+)', text)\n                    if not found:\n                        assignments = re.findall(r'playwrightReportBase64\\s*=\\s*[\"\\x27]([A-Za-z0-9+/=\\r\\n]+)[\"\\x27]', text)\n                        found = assignments\n                    need(len(found) <= 1, \"HTML_REPORT_ARCHIVE_AMBIGUOUS\")\n                    if not found:\n                        pending(\"HTML_REPORT_EMBEDDED_ARCHIVE_UNRECOGNIZED\", {\"file\": item[\"id\"]})\n                        continue\n                    encoded = re.sub(r\"[\\r\\n]\", \"\", found[0])\n                    need(len(encoded) <= CAP[\"htmlBytes\"], \"HTML_REPORT_BASE64_CAP\")\n                    decoded = base64.b64decode(encoded, validate=True)\n                    need(len(decoded) <= CAP[\"htmlBytes\"] and decoded.startswith(b\"PK\"), \"HTML_REPORT_ZIP\")\n                    filename = ROOT / \"originals\" / (\"html-embedded-\" + str(item[\"id\"]) + \".zip\")\n                    write_bytes(filename, decoded)\n                    nested_id = inspect_zip(filename, \"html-report-embedded\", 1, item[\"id\"])\n                    parsed.append({\"htmlFile\": item[\"id\"], \"zipBytes\": len(decoded),\n                                   \"zipSha256\": digest(decoded), \"archive\": nested_id})\n                RECEIPT[\"parsers\"][\"htmlArchives\"] = parsed\n            \n            def tests_from_report(report):\n                tests = []\n                visited = 0\n                def visit(suite, trail, depth):\n                    nonlocal visited\n                    visited += 1\n                    need(visited <= 10000 and depth <= 32 and isinstance(suite, dict), \"REPORT_SUITE_CAP\")\n                    for spec in suite.get(\"specs\", []):\n                        need(isinstance(spec, dict), \"REPORT_SPEC_SHAPE\")\n                        for test in spec.get(\"tests\", []):\n                            need(isinstance(test, dict), \"