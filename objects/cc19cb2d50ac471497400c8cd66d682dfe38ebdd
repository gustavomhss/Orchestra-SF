read_file(rows[0], CAP[\"jsonBytes\"])\n                return rows[0], raw, ui_json(raw)\n            \n            def ui_report_file(value):\n                need(isinstance(value, str), \"UI_REPORT_FILE_TYPE\")\n                prefix = PRODUCER_E2E_ROOT + \"/\"\n                relative = value[len(prefix):] if value.startswith(prefix) else value\n                need(not relative.startswith(\"/\"), \"UI_REPORT_FILE_ROOT\")\n                return \"e2e/\" + \"/\".join(path_parts(relative, False))\n            \n            def ui_attachment_member(value):\n                need(isinstance(value, str) and value.startswith(PRODUCER_WORKSPACE + \"/\"),\n                     \"UI_ATTACHMENT_ABSOLUTE_WORKSPACE_PATH\")\n                relative = value[len(PRODUCER_WORKSPACE) + 1:]\n                normalized = \"/\".join(path_parts(relative, False))\n                need(normalized == relative and normalized.startswith(PNG_MEMBER_PREFIX),\n                     \"UI_ATTACHMENT_EXACT_TEST_RESULTS_PATH\")\n                return normalized\n            \n            def ui_png(raw, expected_width):\n                need(raw.startswith(b\"\\x89PNG\\r\\n\\x1a\\n\") and len(raw) >= 45\n                     and raw[8:12] == b\"\\0\\0\\0\\r\" and raw[12:16] == b\"IHDR\",\n                     \"UI_PNG_SIGNATURE_IHDR\")\n                width = int.from_bytes(raw[16:20], \"big\")\n                height = int.from_bytes(raw[20:24], \"big\")\n                need(0 < width <= 20000 and 0 < height <= 20000, \"UI_PNG_DIMENSIONS\")\n                if expected_width is not None:\n                    need(width == expected_width, \"UI_PNG_CAPTURE_VIEWPORT_WIDTH\")\n                offset, chunks, idat, ended = 8, 0, 0, False\n                while offset < len(raw):\n                    need(offset + 12 <= len(raw), \"UI_PNG_CHUNK_HEADER\")\n                    length = int.from_bytes(raw[offset:offset + 4], \"big\")\n                    kind = raw[offset + 4:offset + 8]\n       