{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@orchestra/client",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect.ts",
    "./contract": "./src/contract.ts",
    "./sucafina/context": "./src/sucafina/context.ts",
    "./sucafina/files": "./src/sucafina/files.ts",
    "./sucafina/transport": "./src/sucafina/transport.ts",
    "./sucafina/procurement": "./src/sucafina/procurement.ts",
    "./sucafina/planner": "./src/sucafina/planner.ts",
    "./sucafina/decisions": "./src/sucafina/decisions.ts",
    "./sucafina/portfolio": "./src/sucafina/portfolio.ts",
    "./sucafina/analyses": "./src/sucafina/analyses.ts",
    "./sucafina/bi": "./src/sucafina/bi.ts",
    "./sucafina/collaboration": "./src/sucafina/collaboration.ts",
    "./sucafina/domain": "./src/sucafina/domain.ts",
    "./sucafina/memory": "./src/sucafina/memory.ts",
    "./sucafina/operations": "./src/sucafina/operations.ts",
    "./sucafina/people": "./src/sucafina/people.ts",
    "./sucafina/reviews": "./src/sucafina/reviews.ts",
    "./sucafina/routines": "./src/sucafina/routines.ts",
    "./sucafina/work": "./src/sucafina/work.ts",
    "./sucafina/bindings": "./src/sucafina/bindings.ts"
  },
  "scripts": {
    "generate": "bun run script/build.ts",
    "check:generated": "bun run generate && git diff --exit-code -- src/generated src/generated-effect",
    "test": "bun test --timeout 5000",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@orchestra/schema": "workspace:*",
    "@orchestra/protocol": "workspace:*"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.83"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@orchestra/httpapi-codegen": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "effect": "catalog:"
  }
}
