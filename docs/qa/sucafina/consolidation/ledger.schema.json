{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gustavomhss/Orchestra-SF/docs/qa/sucafina/consolidation/ledger.schema.json",
  "title": "Orchestra-SF consolidation ledger record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "observed_at",
    "source_pr",
    "source_head",
    "source_branch",
    "source_base",
    "scope",
    "bundle",
    "disposition",
    "status",
    "owner",
    "evidence",
    "close_ready"
  ],
  "properties": {
    "schema_version": {
      "const": "orchestra-sf-consolidation-ledger-v1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^PR-[0-9]+:[A-Za-z0-9._/@+-]+(?::[A-Fa-f0-9]{8,64})?$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "base_observed": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Fa-f0-9]{40}$"
    },
    "source_pr": {
      "type": "integer",
      "minimum": 1
    },
    "source_title": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_head": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{40}$"
    },
    "source_branch": {
      "type": "string",
      "minLength": 1
    },
    "source_base": {
      "type": "string",
      "minLength": 1
    },
    "source_state": {
      "type": "string",
      "enum": [
        "OPEN",
        "CLOSED",
        "MERGED",
        "ABSENT"
      ]
    },
    "source_merge_base": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Fa-f0-9]{40}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hunk_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:)?[A-Fa-f0-9]{16,64}$"
        },
        "change_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ADD",
            "MODIFY",
            "DELETE",
            "RENAME",
            "MIXED",
            null
          ]
        }
      }
    },
    "bundle": {
      "type": "string",
      "enum": [
        "A",
        "B0",
        "B1",
        "B2",
        "B3",
        "FINAL",
        "NONE",
        "OWNER_DECISION"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "UNREVIEWED",
        "ABSORBED_ANCESTOR",
        "ABSORBED_BLOB",
        "ABSORBED_PATCH",
        "DUPLICATE_HEAD",
        "SUPERSEDED",
        "REPLAY",
        "DOCS_ONLY",
        "DROP_WITH_EVIDENCE",
        "BLOCKED_OWNER_DECISION",
        "BLOCKED_MISSING_BRANCH",
        "BLOCKED_SEMANTIC_CONFLICT",
        "PROMOTION_ONLY"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "SNAPSHOTTED",
        "CLASSIFIED",
        "PORTED",
        "CI_PENDING",
        "CI_GREEN",
        "MERGED",
        "CLOSE_READY",
        "CLOSED",
        "BLOCKED"
      ]
    },
    "owner": {
      "type": "string",
      "enum": [
        "inventory",
        "baseline",
        "platform-runtime",
        "business-product",
        "native-shell",
        "promotion",
        "owner",
        "unknown"
      ]
    },
    "canonical_pr": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "protected_path": {
      "type": "boolean",
      "default": false
    },
    "immutable_history": {
      "type": "boolean",
      "default": false
    },
    "owner_decision_required": {
      "type": "boolean",
      "default": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "detail"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "ANCESTRY",
              "EMPTY_DIFF",
              "BLOB_MATCH",
              "DELETION_MATCH",
              "PATCH_ID",
              "HUNK_MATCH",
              "HEAD_MATCH",
              "SEMANTIC_REVIEW",
              "OWNER_DECISION",
              "CI_RUN",
              "FILE_LIST",
              "OTHER"
            ]
          },
          "ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        }
      }
    },
    "bundle_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Fa-f0-9]{40}$"
    },
    "merged_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Fa-f0-9]{40}$"
    },
    "ci_runs": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true
    },
    "close_ready": {
      "type": "boolean"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "REPLAY"
          }
        }
      },
      "then": {
        "properties": {
          "bundle": {
            "enum": [
              "B0",
              "B1",
              "B2",
              "B3",
              "FINAL"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "close_ready": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "CLOSE_READY",
              "CLOSED"
            ]
          },
          "disposition": {
            "not": {
              "enum": [
                "UNREVIEWED",
                "REPLAY",
                "BLOCKED_OWNER_DECISION",
                "BLOCKED_MISSING_BRANCH",
                "BLOCKED_SEMANTIC_CONFLICT"
              ]
            }
          }
        }
      }
    }
  ]
}
