  "distinctIssues": [
    {
      "id": "R3-01",
      "area": "Settings / Permissions",
      "problem": "At 320px permission options are clipped and labels collapse to a narrow column.",
      "resolution": "Stack full-width copy above three equal 44px permission options within a narrow settings panel."
    },
    {
      "id": "R3-02",
      "area": "Settings / Models",
      "problem": "Model names and metadata overlap Set as default in English and Brazilian Portuguese.",
      "resolution": "Keep logo and complete identity on the first grid row, with default/action and visibility toggle below."
    },
    {
      "id": "R3-03",
      "area": "Settings / keyboard focus",
      "problem": "The permission segment clips the external focus outline, leaving mostly vertical traces.",
      "resolution": "Use an inset native focus outline on the radios and regenerate the corresponding palette overrides; preserve keyboard order and locked states."
    },
    {
      "id": "R3-04",
      "area": "Providers / connection dialog",
      "problem": "Connection dialog frame, title and header targets differ from the native dialog scale.",
      "resolution": "Scope native 16px radius, 20px title, 28px header actions and visible focus to this dialog; preserve existing glass."
    },
    {
      "id": "R3-05",
      "area": "Planner / native selects",
      "problem": "Selected source/target version text paints under the native select arrow at 320px.",
      "resolution": "Reserve 32px of logical end padding for the native arrow; retain full option values."
    },
    {
      "id": "R3-06",
      "area": "Decisions / Assumptions filter",
      "problem": "The all-state option is labeled Assumption under State.",
      "resolution": "Reuse the existing All/Todos key for value=all."
    },
    {
      "id": "R3-07",
      "area": "Decisions / filtered-empty state",
      "problem": "Filtering out existing assumptions says no assumptions are recorded.",
      "resolution": "Use the existing filtered-empty message only for the filtered-empty state."
    },
    {
      "id": "R3-08",
      "area": "Decisions / return links",
      "problem": "Back to case stretches across the entire work grid on three routes.",
      "resolution": "Reuse the existing start-aligned return class on Alternatives, Assumptions and Questions."
    },
    {
      "id": "R3-09",
      "area": "Decisions / selected-case context",
      "problem": "Prepared changes and Receipts say Choose an existing case when a case is already selected.",
      "resolution": "Reuse Current case/Caso atual while preserving the exact source objective."
    },
    {
      "id": "R3-10",
      "area": "Providers / catalog refresh",
      "problem": "Closing Configure cancels an older bootstrap query and surfaces the expected cancellation as a reload failure.",
      "resolution": "Ignore only the actual TanStack CancelledError in that bootstrap catch; preserve ordinary errors, refreshed data and disconnect failures."
    }
  ],
