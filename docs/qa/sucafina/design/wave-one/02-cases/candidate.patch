--- /dev/null
+++ b/packages/app-shell/src/orchestra/chapters/sucafina/decisions/cases/cases.css
@@ -0,0 +1,366 @@
+/* UI33 only: native Orchestra fill steps, hairlines and type.
+   n24.css is shared by other decision surfaces and stays unchanged. */
+.sf-cases {
+  --sf-cases-space-xs: 6px;
+  --sf-cases-space-sm: 10px;
+  --sf-cases-space-md: 14px;
+  --sf-cases-space-lg: 20px;
+  --sf-cases-space-xl: 28px;
+  --sf-cases-hairline: 1px;
+  --sf-cases-focus: 2px;
+  --sf-cases-control: 44px;
+  --sf-cases-search-max: 36rem;
+  display: grid;
+  gap: var(--sf-cases-space-xl);
+  min-inline-size: 0;
+  inline-size: 100%;
+  color: var(--orchestra-body);
+  font-family: var(--mx-sans);
+  font-size: var(--orchestra-font-size-md);
+  line-height: 1.6;
+}
+
+.sf-cases :is(h2, h3, h4) {
+  margin: 0;
+  color: var(--mx-strong);
+  font-family: var(--mx-emphasis);
+  font-weight: 600;
+  overflow-wrap: anywhere;
+}
+.sf-cases h2 {
+  font-size: var(--orchestra-font-size-xl);
+  line-height: 1.5;
+}
+
+.sf-cases .sf-cases-list {
+  display: grid;
+  gap: var(--sf-cases-space-md);
+  min-inline-size: 0;
+}
+.sf-cases .sf-cases-list-head {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
+  align-items: end;
+  gap: var(--sf-cases-space-md) var(--sf-cases-space-lg);
+}
+.sf-cases .sf-cases-list-head h2 {
+  padding-block: var(--sf-cases-space-sm);
+}
+.sf-cases .sf-n24-toolbar {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  align-items: end;
+  gap: var(--sf-cases-space-sm);
+  inline-size: 100%;
+  max-inline-size: var(--sf-cases-search-max);
+  justify-self: end;
+}
+
+.sf-cases .sf-n24-field {
+  gap: var(--sf-cases-space-xs);
+}
+.sf-cases .sf-n24-field > span {
+  color: var(--mx-dim);
+  font-family: var(--mx-emphasis);
+  font-size: var(--orchestra-font-size-sm);
+  font-weight: 600;
+  line-height: 1.5;
+  overflow-wrap: anywhere;
+}
+.sf-cases .sf-n24-field :is(input, textarea) {
+  min-inline-size: 0;
+  min-block-size: var(--sf-cases-control);
+  padding: var(--sf-cases-space-sm);
+  border: var(--sf-cases-hairline) solid var(--mx-line);
+  border-radius: var(--orchestra-radius-sm);
+  background: var(--mx-raised);
+  color: var(--mx-strong);
+  font-family: var(--mx-sans);
+  font-size: var(--orchestra-font-size-md);
+  line-height: 1.6;
+}
+.sf-cases .sf-n24-field :is(input, textarea):hover:not(:disabled) {
+  border-color: var(--mx-rim);
+}
+.sf-cases .sf-n24-field :is(input, textarea):focus {
+  border-color: var(--orchestra-accent);
+}
+.sf-cases .sf-n24-field :is(input, textarea)::placeholder {
+  color: var(--mx-dim);
+  opacity: 1;
+}
+.sf-cases .sf-n24-field :is(input, textarea):disabled {
+  background: var(--mx-soft);
+  color: var(--mx-dim);
+  opacity: 1;
+}
+
+.sf-cases .mx-btn {
+  min-inline-size: 0;
+  max-inline-size: 100%;
+  min-block-size: var(--sf-cases-control);
+  padding: var(--sf-cases-space-sm) var(--sf-cases-space-md);
+  font-family: var(--mx-sans);
+  font-size: var(--orchestra-font-size-sm);
+  line-height: 1.5;
+  white-space: normal;
+  overflow-wrap: anywhere;
+  text-align: center;
+}
+.sf-cases .mx-btn:not(.primary) {
+  background: transparent;
+}
+.sf-cases .mx-btn:not(.primary):hover:not(:disabled) {
+  background: var(--orchestra-surface-hover);
+  border-color: var(--mx-rim);
+}
+.sf-cases :is(a, button, input, textarea):focus-visible {
+  outline: var(--sf-cases-focus) solid var(--orchestra-accent);
+  outline-offset: var(--sf-cases-focus);
+}
+
+/* A single list surface gives each record the same columns and breathing room.
+   Rows keep their own accessible link; the row is not a simulated click target. */
+.sf-cases .sf-cases-records {
+  gap: 0;
+  border: var(--sf-cases-hairline) solid var(--mx-line);
+  border-radius: var(--orchestra-radius-lg);
+  background: var(--mx-raised);
+  box-shadow: var(--mx-card-shadow);
+}
+.sf-cases .sf-cases-records:focus-within {
+  border-color: var(--mx-rim);
+}
+.sf-cases .sf-cases-row {
+  padding: var(--sf-cases-space-md) var(--sf-cases-space-lg);
+  border: 0;
+  border-radius: 0;
+  background: transparent;
+  box-shadow: none;
+  transition: background var(--orchestra-duration-fast) var(--orchestra-ease-out);
+}
+.sf-cases .sf-cases-row + .sf-cases-row {
+  border-block-start: var(--sf-cases-hairline) solid var(--mx-line);
+}
+.sf-cases .sf-cases-row:first-child {
+  border-start-start-radius: inherit;
+  border-start-end-radius: inherit;
+}
+.sf-cases .sf-cases-row:last-child {
+  border-end-start-radius: inherit;
+  border-end-end-radius: inherit;
+}
+.sf-cases .sf-cases-row:hover,
+.sf-cases .sf-cases-row:focus-within {
+  background: var(--mx-soft);
+  box-shadow: none;
+}
+.sf-cases .sf-n24-record {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, max-content) minmax(0, max-content);
+  align-items: center;
+  gap: var(--sf-cases-space-md) var(--sf-cases-space-lg);
+  min-block-size: var(--sf-cases-control);
+}
+.sf-cases .sf-n24-record-main {
+  gap: var(--sf-cases-space-xs);
+}
+.sf-cases .sf-n24-record-main strong {
+  color: var(--mx-strong);
+  font-family: var(--mx-emphasis);
+  font-size: var(--orchestra-font-size-lg);
+  font-weight: 600;
+  line-height: 1.5;
+}
+.sf-cases .sf-n24-record-main small {
+  color: var(--mx-dim);
+  font-family: var(--mx-mono);
+  font-size: var(--orchestra-font-size-sm);
+  line-height: 1.6;
+  opacity: 1;
+}
+.sf-cases .sf-cases-version {
+  min-inline-size: 0;
+  color: var(--mx-dim);
+  font-size: var(--orchestra-font-size-sm);
+  font-variant-numeric: tabular-nums;
+  overflow-wrap: anywhere;
+}
+.sf-cases .sf-cases-open {
+  justify-self: end;
+}
+
+/* The real creation flow is inline. No dialog, focus trap or extra glass layer. */
+.sf-cases .sf-n24-create {
+  gap: var(--sf-cases-space-lg);
+  padding: var(--sf-cases-space-lg);
+}
+.sf-cases .sf-cases-form {
+  display: grid;
+  gap: var(--sf-cases-space-lg);
+  min-inline-size: 0;
+}
+.sf-cases .sf-n24-form-grid,
+.sf-cases .sf-cases-review-details {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--sf-cases-space-md) var(--sf-cases-space-lg);
+  min-inline-size: 0;
+  margin: 0;
+}
+.sf-cases .sf-cases-objective {
+  grid-column: 1 / -1;
+  min-inline-size: 0;
+}
+.sf-cases .sf-n24-create .sf-n24-field :is(input, textarea) {
+  background: var(--mx-soft);
+}
+.sf-cases .sf-n24-review {
+  display: grid;
+  gap: var(--sf-cases-space-md);
+  margin: 0;
+  padding: var(--sf-cases-space-lg);
+  border: var(--sf-cases-hairline) solid var(--mx-line);
+  border-radius: var(--orchestra-radius-md);
+  background: var(--mx-soft);
+}
+.sf-cases .sf-n24-review h3 {
+  font-size: var(--orchestra-font-size-lg);
+  line-height: 1.5;
+}
+.sf-cases .sf-cases-review-details > div {
+  display: grid;
+  align-content: start;
+  gap: var(--sf-cases-space-xs);
+  min-inline-size: 0;
+}
+.sf-cases .sf-cases-review-details dt,
+.sf-cases .sf-cases-review-criteria h4 {
+  color: var(--mx-dim);
+  font-family: var(--mx-emphasis);
+  font-size: var(--orchestra-font-size-sm);
+  font-weight: 600;
+  line-height: 1.5;
+}
+.sf-cases .sf-cases-review-details dd {
+  margin: 0;
+  color: var(--mx-strong);
+  font-variant-numeric: tabular-nums;
+  overflow-wrap: anywhere;
+}
+.sf-cases .sf-cases-review-criteria {
+  min-inline-size: 0;
+}
+.sf-cases .sf-cases-review-criteria ol {
+  display: grid;
+  gap: var(--sf-cases-space-xs);
+  margin: var(--sf-cases-space-sm) 0 0;
+  padding-inline-start: var(--sf-cases-space-lg);
+}
+.sf-cases .sf-cases-review-criteria li {
+  padding-inline-start: var(--sf-cases-space-xs);
+  overflow-wrap: anywhere;
+}
+.sf-cases .sf-cases-source-note {
+  margin: 0;
+  color: var(--mx-dim);
+}
+.sf-cases .sf-cases-source-note code {
+  font-family: var(--mx-mono);
+  font-size: var(--orchestra-font-size-sm);
+}
+.sf-cases .sf-cases-status {
+  margin: 0;
+  padding: var(--sf-cases-space-md);
+  border: var(--sf-cases-hairline) solid var(--mx-line);
+  border-radius: var(--orchestra-radius-md);
+  background: var(--mx-soft);
+  color: var(--mx-strong);
+  font-size: var(--orchestra-font-size-md);
+  line-height: 1.6;
+  overflow-wrap: anywhere;
+}
+.sf-cases .sf-n24-actions {
+  display: flex;
+  flex-direction: row;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--sf-cases-space-sm);
+}
+.sf-cases .sf-n24-actions > * {
+  inline-size: auto;
+}
+.sf-cases .sf-state-message {
+  margin: 0;
+  padding: var(--sf-cases-space-lg);
+  border-radius: var(--orchestra-radius-lg);
+}
+.sf-cases .sf-state-title {
+  font-size: var(--orchestra-font-size-md);
+  line-height: 1.6;
+}
+
+/* Retain the actual header trigger and its focus. Only its visual priority
+   changes while UI33's existing create panel is present. */
+.sf-page-frame:has(.sf-cases[data-sf-creating="true"]) [data-sf-action="new-case"] .sf-action-button.primary {
+  background: transparent;
+  color: var(--mx-strong);
+  border-color: var(--mx-line);
+}
+.sf-page-frame:has(.sf-cases[data-sf-creating="true"]) [data-sf-action="new-case"] .sf-action-button.primary:hover:not(:disabled) {
+  background: var(--orchestra-surface-hover);
+  border-color: var(--mx-rim);
+}
+
+/* Named frame queries follow the usable workspace after sidebar and zoom. */
+@container sf-frame (max-width: 767px) {
+  .sf-cases .sf-cases-list-head {
+    grid-template-columns: minmax(0, 1fr);
+  }
+  .sf-cases .sf-cases-list-head h2 {
+    padding-block: 0;
+  }
+  .sf-cases .sf-n24-toolbar {
+    max-inline-size: 100%;
+  }
+  .sf-cases .sf-n24-record {
+    grid-template-columns: minmax(0, 1fr) minmax(0, max-content);
+  }
+  .sf-cases .sf-n24-record-main {
+    grid-column: 1 / -1;
+  }
+  .sf-cases .sf-n24-form-grid,
+  .sf-cases .sf-cases-review-details {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+@container sf-frame (max-width: 479px) {
+  .sf-cases {
+    gap: var(--sf-cases-space-lg);
+  }
+  .sf-cases .sf-cases-row,
+  .sf-cases .sf-n24-create,
+  .sf-cases .sf-n24-review,
+  .sf-cases .sf-state-message {
+    padding: var(--sf-cases-space-md);
+  }
+  .sf-cases .sf-n24-record {
+    grid-template-columns: minmax(0, 1fr);
+    gap: var(--sf-cases-space-sm);
+  }
+  .sf-cases .sf-cases-open {
+    justify-self: stretch;
+  }
+  .sf-cases .sf-n24-actions {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr);
+  }
+  .sf-cases .sf-n24-actions > * {
+    inline-size: 100%;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .sf-cases .sf-cases-row {
+    transition: none;
+  }
+}
