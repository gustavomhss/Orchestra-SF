+  line-height: var(--sf-exec-line-height);
+  overflow-wrap: anywhere;
+}
+
+.sf-u02-page[data-sf-surface="CAP01"] .sf-u02-section > :last-child {
+  margin-block-end: 0;
+}
+
+.sf-u02-page[data-sf-surface="CAP01"] .sf-u02-controls {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  align-items: end;
+  gap: var(--sf-exec-space-lg);
+}
