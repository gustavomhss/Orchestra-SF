+/* CAP01 only. CAP03 keeps the shared u02.css and SfU02Edit unchanged. */
+.sf-u02-page[data-sf-surface="CAP01"] {
+  --sf-exec-space-sm: 6px;
+  --sf-exec-space-md: 10px;
+  --sf-exec-space-lg: 14px;
+  --sf-exec-space-xl: 20px;
+  --sf-exec-space-2xl: 24px;
+  --sf-exec-rule: 1px;
+  --sf-exec-focus-width: 2px;
+  --sf-exec-focus-offset: 2px;
+  --sf-exec-control-height: 44px;
+  --sf-exec-metric-min: 140px;
+  --sf-exec-editor-min: 280px;
+  --sf-exec-financial-table-min: 480px;
+  --sf-exec-signals-table-min: 640px;
+  --sf-exec-copy-measure: 68ch;
+  --sf-exec-line-height: 1.6;
+  --sf-exec-heading-line: 1.4;
+  --sf-exec-label-lines: 2;
+  --sf-exec-value-line: 1.25;
+  --sf-exec-value-tracking: -0.035em;
+  --sf-exec-scroll-fade: 20px;
+  --sf-exec-scroll-shadow: 12px;
+  display: grid;
+  gap: var(--sf-exec-space-xl);
+  min-inline-size: 0;
+  max-inline-size: 100%;
+  color: var(--mx-strong);
+  font-family: var(--mx-sans);
+  font-size: var(--orchestra-font-size-md);
+  line-height: var(--sf-exec-line-height);
+}
+
+.sf-u02-page[data-sf-surface="CAP01"] *,
+.sf-u02-page[data-sf-surface="CAP01"] *::before,
+.sf-u02-page[data-sf-surface="CAP01"] *::after {
+  box-sizing: border-box;
+}
+
+/* The native state wrapper continues to control disclosure and confidentiality. */
+.sf-u02-page[data-sf-surface="CAP01"] > .sf-state-panel > .sf-state-content {
+  display: grid;
+  gap: var(--sf-exec-space-xl);
+  min-inline-size: 0;
+}
+
+.sf-u02-page[data-sf-surface="CAP01"] .sf-u02-crosslinks {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-start;
+  gap: var(--sf-exec-space-sm) var(--sf-exec-space-md);
+}
+
+.sf-u02-page[data-sf-surface="CAP01"] .sf-u02-crosslinks > div {
+  min-inline-size: 0;
+  max-inline-size: 100%;
+}
+
+.sf-u02-page[data-sf-surface="CAP01"] .mx-btn {
+  min-block-size: var(--sf-exec-control-height);
+  max-inline-size: 100%;
+  margin: 0;
+  white-space: normal;
+  overflow-wrap: anywhere;
+  font-family: var(--mx-sans);
+  font-size: var(--orchestra-font-size-sm);
+  line-height: var(--sf-exec-heading-line);
+}
+
+.sf-u02-page[data-sf-surface="CAP01"] .mx-btn:not(.primary),
+.sf-u02-page[data-sf-surface="CAP01"] [data-sf-u02-edit] > .mx-btn.primary {
+  color: var(--mx-strong);
+  background: transparent;
+  border-color: var(--mx-line);
+}
+
+.sf-u02-page[data-sf-surface="CAP01"] .mx-btn:not(:disabled):not(.primary):hover,
+.sf-u02-page[data-sf-surface="CAP01"] [data-sf-u02-edit] > .mx-btn.primary:not(:disabled):hover {
+  background: var(--orchestra-surface-hover);
+  border-color: var(--mx-rim);
+}
+
+.sf-u02-page[data-sf-surface="CAP01"] .sf-u02-section {
+  min-inline-size: 0;
+  padding: var(--sf-exec-space-xl);
+  border: var(--sf-exec-rule) solid var(--mx-line);
+  border-radius: var(--orchestra-radius-lg);
+  background: var(--mx-raised);
+  box-shadow: var(--mx-card-shadow);
+}
+
+.sf-u02-page[data-sf-surface="CAP01"] .sf-u02-section > h2 {
+  margin: 0 0 var(--sf-exec-space-lg);
+  color: var(--mx-strong);
+  font-family: var(--mx-emphasis);
+  font-size: var(--orchestra-font-size-xl);
+  font-weight: 600;
+  line-height: var(--sf-exec-heading-line);
