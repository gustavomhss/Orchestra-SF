+  border-radius: var(--orchestra-radius-sm);
+  background: var(--orchestra-surface);
+  color: var(--mx-strong);
+  font: inherit;
+  font-size: var(--orchestra-font-size-md);
+  font-variant-numeric: tabular-nums;
+}
+
+.sf-u02-page[data-sf-surface="CAP01"] .sf-u02-controls option {
+  background: var(--mx-modal);
+  color: var(--mx-strong);
