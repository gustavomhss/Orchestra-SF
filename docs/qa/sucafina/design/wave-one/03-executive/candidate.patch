+  margin: 0;
+}
+
+.sf-u02-page[data-sf-surface="CAP01"] :is(.sf-u02-financial-metrics, .sf-u02-variance .sf-u02-stats) {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+}
