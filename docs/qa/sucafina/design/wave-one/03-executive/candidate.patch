+.sf-u02-page[data-sf-surface="CAP01"] .sf-u02-stats.sf-u02-people-metrics {
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  grid-auto-rows: auto;
+}
+
+.sf-u02-page[data-sf-surface="CAP01"] .sf-u02-stat {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: var(--sf-exec-space-sm);
+  min-inline-size: 0;
+  min-block-size: 0;
+  padding: var(--sf-exec-space-sm) 0;
+  border: 0;
+  border-radius: initial;
+  background: transparent;
+}
+
+.sf-u02-page[data-sf-surface="CAP01"] .sf-u02-stat dt {
+  min-block-size: calc(var(--orchestra-font-size-sm) * var(--sf-exec-line-height) * var(--sf-exec-label-lines));
+  color: var(--mx-dim);
+  font-size: var(--orchestra-font-size-sm);
+  line-height: var(--sf-exec-line-height);
+  opacity: 1;
+  overflow-wrap: anywhere;
+}
+
+.sf-u02-page[data-sf-surface="CAP01"] .sf-u02-stat dd {
+  margin: 0;
+  color: var(--mx-strong);
+  font-family: var(--mx-emphasis);
+  font-size: var(--orchestra-font-size-3xl);
+  font-weight: 600;
+  line-height: var(--sf-exec-value-line);
+  letter-spacing: var(--sf-exec-value-tracking);
+  font-variant-numeric: tabular-nums;
+  overflow-wrap: anywhere;
+}
+
+/* Availability text retains its meaning and uses body hierarchy, never a hero number. */
+.sf-u02-page[data-sf-surface="CAP01"] .sf-u02-stat:is([data-sf-scope="unscoped"], [data-sf-value="missing"]) dd {
+  color: var(--mx-dim);
