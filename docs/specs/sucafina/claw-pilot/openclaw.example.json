{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": { "mode": "token" }
  },
  "agents": {
    "defaults": {
      "subagents": {
        "maxSpawnDepth": 1
      },
      "systemAgent": {
        "agentId": "maestro"
      },
      "authInheritance": {
        "agentId": "maestro"
      },
      "heartbeat": {
        "agentId": "maestro",
        "every": "0m"
      }
    },
    "entries": {
      "maestro": {
        "name": "Maestro",
        "subagents": {
          "allowAgents": [
            "sf_operations",
            "sf_planning",
            "sf_execution",
            "sf_evidence"
          ]
        },
        "tools": {
          "profile": "minimal",
          "alsoAllow": [
            "sessions_spawn",
            "sessions_yield",
            "sucafina__sf_pendencias",
            "read",
            "exec"
          ]
        }
      },
      "sf_operations": {
        "tools": {
          "profile": "minimal",
          "alsoAllow": [
            "read"
          ]
        }
      },
      "sf_planning": {
        "tools": {
          "profile": "minimal",
          "alsoAllow": [
            "read"
          ]
        }
      },
      "sf_execution": {
        "tools": {
          "profile": "minimal",
          "alsoAllow": [
            "read"
          ]
        }
      },
      "sf_evidence": {
        "tools": {
          "profile": "minimal",
          "alsoAllow": [
            "read"
          ]
        }
      }
    },
    "ownership": "explicit"
  },
  "mcp": {
    "servers": {
      "sucafina": {
        "enabled": false,
        "url": "https://sf.invalid/sucafina/api/claw/mcp",
        "transport": "streamable-http",
        "toolFilter": {
          "include": [
            "sf_pendencias"
          ]
        }
      }
    }
  },
  "tools": {
    "fs": {
      "workspaceOnly": true
    },
    "exec": {
      "host": "gateway",
      "security": "allowlist",
      "ask": "off",
      "safeBins": []
    },
    "deny": [
      "message",
      "browser"
    ]
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  }
}
