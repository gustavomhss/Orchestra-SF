2026-11-14T10:12:54.2514679Z [36;1mif [ "$RUNNER_OS" = "Windows" ]; then[0m
2026-11-14T10:12:54.2514903Z [36;1m  # Bun can leave a patched package directory half-renamed on Windows.[0m
2026-11-14T10:12:54.2515225Z [36;1m  # The hoisted layout nests several copies of a patched package (e.g. @ai-sdk/openai-compatible),[0m
2026-11-14T10:12:54.2515578Z [36;1m  # and Bun applies the patch once per copy; concurrent renames into the same cache entry race[0m
2026-11-14T10:12:54.2515948Z [36;1m  # with ENOTEMPTY. Every attempt starts from an empty cache because the loser may leave it partial.[0m
2026-11-14T10:12:54.2516225Z [36;1m  cache_dir="$PWD/.bun-install-cache"[0m
2026-11-14T10:12:54.2516402Z [36;1m  trap 'rm -rf "$cache_dir"' EXIT[0m
2026-11-14T10:12:54.2516562Z [36;1m  for attempt in 1 2 3 4 5; do[0m
2026-11-14T10:12:54.2516713Z [36;1m    rm -rf "$cache_dir"[0m
2026-11-14T10:12:54.2516853Z [36;1m    rm -rf node_modules[0m
2026-11-14T10:12:54.2517062Z [36;1m    if bun install --no-cache --cache-dir "$cache_dir" --linker hoisted ; then[0m
2026-11-14T10:12:54.2517280Z [36;1m      exit 0[0m
2026-11-14T10:12:54.2517397Z [36;1m    fi[0m
2026-11-14T10:12:54.2517615Z [36;1m    echo "::warning::bun install attempt $attempt failed on Windows; retrying from an empty cache"[0m
2026-11-14T10:12:54.2517860Z [36;1m  done[0m
2026-11-14T10:12:54.2517967Z [36;1m  exit 1[0m
2026-11-14T10:12:54.2518075Z [36;1melse[0m
2026-11-14T10:12:54.2518186Z [36;1m  bun install [0m
2026-11-14T10:12:54.2518458Z [36;1mfi[0m
