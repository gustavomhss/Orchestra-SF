{
  "scope": "Direct ClamD provisioning controls, not the product adapter or browser journeys",
  "controls": [
    {
      "kind": "main",
      "clean": "stream: OK",
      "eicar": "stream: Eicar-Test-Signature FOUND",
      "cleanAfter": "stream: OK"
    },
    {
      "kind": "error",
      "clean": "stream: OK",
      "eicar": "stream: Eicar-Test-Signature FOUND",
      "cleanAfter": "stream: OK"
    }
  ],
  "sizeError": "INSTREAM size limit exceeded. ERROR"
}
