2026-11-14T09:29:22.1305575Z [36;1m  # Bun can leave a patched package directory half-renamed on Windows.[0m
2026-11-14T09:29:22.1306136Z [36;1m  # The hoisted layout nests several copies of a patched package (e.g. @ai-sdk/openai-compatible),[0m
2026-11-14T09:29:22.1306969Z [36;1m  # and Bun applies the patch once per copy; concurrent renames into the same cache entry race[0m
2026-11-14T09:29:22.1307617Z [36;1m  # with ENOTEMPTY. Every attempt starts from an empty cache because the loser may leave it partial.[0m
2026-11-14T09:29:22.1308070Z [36;1m  cache_dir="$PWD/.bun-install-cache"[0m
2026-11-14T09:29:22.1308359Z [36;1m  trap 'rm -rf "$cache_dir"' EXIT[0m
2026-11-14T09:29:22.1308619Z [36;1m  for attempt in 1 2 3 4 5; do[0m
2026-11-14T09:29:22.1308848Z [36;1m    rm -rf "$cache_dir"[0m
2026-11-14T09:29:22.1309075Z [36;1m    rm -rf node_modules[0m
2026-11-14T09:29:22.1309630Z [36;1m    if bun install --no-cache --cache-dir "$cache_dir" --linker hoisted ; then[0m
2026-11-14T09:29:22.1309991Z [36;1m      exit 0[0m
2026-11-14T09:29:22.1310175Z [36;1m    fi[0m
2026-11-14T09:29:22.1310524Z [36;1m    echo "::warning::bun install attempt $attempt failed on Windows; retrying from an empty cache"[0m
2026-11-14T09:29:22.1310937Z [36;1m  done[0m
2026-11-14T09:29:22.1311119Z [36;1m  exit 1[0m
2026-11-14T09:29:22.1311309Z [36;1melse[0m
