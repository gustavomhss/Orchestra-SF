2026-11-14T09:23:24.5963992Z [36;1m    rm -rf "$cache_dir"[0m
2026-11-14T09:23:24.5964294Z [36;1m    rm -rf node_modules[0m
2026-11-14T09:23:24.5964632Z [36;1m    if bun install --no-cache --cache-dir "$cache_dir" --linker hoisted ; then[0m
2026-11-14T09:23:24.5965004Z [36;1m      exit 0[0m
2026-11-14T09:23:24.5965237Z [36;1m    fi[0m
2026-11-14T09:23:24.5965613Z [36;1m    echo "::warning::bun install attempt $attempt failed on Windows; retrying from an empty cache"[0m
