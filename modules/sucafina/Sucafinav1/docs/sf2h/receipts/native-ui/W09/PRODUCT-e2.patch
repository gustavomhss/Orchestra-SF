+/* Orchestra Mx design tokens, responsive without a separate surface identity. */
+.sf-s04 { min-inline-size: 0; display: grid; gap: 16px; }
+.sf-s04-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
+.sf-s04-head h2, .sf-s04 h3 { margin: 0; color: var(--mx-strong); }
+.sf-s04-layout { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,2fr); gap: 16px; min-inline-size: 0; }
+.sf-s04-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
+.sf-s04-row { border: 1px solid var(--mx-line); background: var(--mx-raised); padding: 12px; border-radius: 10px; min-inline-size: 0; }
+.sf-s04-row button { inline-size: 100%; min-inline-size: 0; text-align: start; white-space: normal; overflow-wrap: anywhere; }
+.sf-s04-row [aria-pressed="true"] { outline: 2px solid var(--mx-blue); outline-offset: 2px; }
+.sf-s04-detail { min-inline-size: 0; }
+.sf-s04-detail dl { display: grid; grid-template-columns: minmax(8rem,1fr) minmax(0,2fr); column-gap: 16px; row-gap: 8px; }
+.sf-s04-detail dt, .sf-s04-muted { color: var(--mx-dim); }
+.sf-s04-detail dd { min-inline-size: 0; margin: 0; overflow-wrap: anywhere; }
+.sf-s04-excerpt { white-space: pre-wrap; overflow-wrap: anywhere; border-inline-start: 2px solid var(--mx-line); padding-inline-start: 12px; }
+.sf-s04-actions { display: flex; flex-wrap: wrap; gap: 8px; }
+.sf-s04-file { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; min-inline-size: 0; }
+.sf-s04-file-name { min-inline-size: 0; overflow-wrap: anywhere; unicode-bidi: isolate; }
+.sf-s04-status { overflow-wrap: anywhere; }
+@media (max-width: 768px) {
+  .sf-s04-layout { grid-template-columns: minmax(0,1fr); }
+  .sf-s04-detail dl { grid-template-columns: minmax(0,1fr); }
+}
+@media (prefers-reduced-motion: reduce) { .sf-s04 * { scroll-behavior: auto; } }

diff --git a/packages/app-shell/src/orchestra/chapters/sucafina/shared/attachments/guards.ts b/packages/app-shell/src/orchestra/chapters/sucafina/shared/attachments/guards.ts
