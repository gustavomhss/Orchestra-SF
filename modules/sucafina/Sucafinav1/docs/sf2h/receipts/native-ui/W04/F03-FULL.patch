+.sf-state-skeleton span { display: block; block-size: 12px; background: var(--mx-line); border-radius: var(--orchestra-radius-xs); }
+.sf-state-skeleton span:nth-child(2) { inline-size: 83%; }
+.sf-state-skeleton span:nth-child(3) { inline-size: 61%; }
+.sf-run-state {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  padding: 16px;
+  border: 1px solid var(--mx-line);
+  background: var(--mx-raised);
+  border-radius: var(--orchestra-radius-lg);
+}
+.sf-run-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; min-inline-size: 0; }
+.sf-run-header h3 { margin: 0; min-inline-size: 0; font-size: var(--orchestra-font-size-lg); overflow-wrap: anywhere; }
+.sf-run-phase {
+  display: inline-flex;
+  flex-shrink: 0;
+  border: 1px solid var(--mx-line);
+  border-radius: var(--orchestra-radius-full);
+  padding: 4px 10px;
+  color: var(--mx-strong);
+  background: var(--mx-soft);
+  font-size: var(--orchestra-font-size-xs);
+}
+.sf-run-state[data-sf-run-state="failed"] .sf-run-phase,
+.sf-run-state[data-sf-run-state="unavailable"] .sf-run-phase { border-color: var(--mx-bad); }
+.sf-run-state[data-sf-run-state="complete"] .sf-run-phase { border-color: var(--mx-good); }
+.sf-run-model { margin: 0; color: var(--mx-dim); font-size: var(--orchestra-font-size-sm); overflow-wrap: anywhere; }
+.sf-run-progress p { margin: 0 0 6px; color: var(--mx-dim); }
+.sf-run-progress progress {
+  display: block;
+  inline-size: 100%;
+  block-size: 10px;
+  accent-color: var(--mx-blue);
+}
+.sf-run-result { min-inline-size: 0; padding-block: 10px; border-block-start: 1px solid var(--mx-line); }
+.sf-run-result > p { overflow-wrap: anywhere; }
+.sf-run-source { display: flex; flex-wrap: wrap; gap: 12px 20px; margin: 0; }
+.sf-run-source > div { min-inline-size: 0; }
+.sf-run-source dt { color: var(--mx-dim); font-size: var(--orchestra-font-size-sm); }
+.sf-run-source dd { margin: 4px 0 0; overflow-wrap: anywhere; }
+.sf-run-result > .mx-btn { min-block-size: 44px; }
+.sf-run-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-start; }
+.sf-run-state :is(button, a):focus-visible,
+.sf-state-panel :is(button, a):focus-visible {
+  outline: 2px solid var(--mx-blue);
+  outline-offset: 2px;
+}
+@container sf-frame (max-width: 767px) {
+  .sf-run-state { padding: 12px; }
+  .sf-run-actions, .sf-state-actions { flex-direction: column; align-items: stretch; }
+  .sf-run-actions .sf-action, .sf-run-actions button, .sf-state-actions button { inline-size: 100%; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .sf-state-skeleton *, .sf-run-state * { animation: none; transition: none; }
+}
