+import type { createSfBusinessServices } from "./business-services.ts"
+import type { createCollaborationHost } from "../../../../modules/sucafina/Sucafinav1/product/collaboration/host.ts"
+import { createRecipientAwareThreadReads } from "../../../../modules/sucafina/Sucafinav1/product/collaboration/thread-reads.ts"
+import type { ReviewCompositionInput } from "../../../../modules/sucafina/Sucafinav1/product/reviews/composition.ts"
+
+/** Inject the canonical producers; selected source association remains an explicit host authority. */
+export function createSfReviewProducerBindings(input: {
+  business: Pick<ReturnType<typeof createSfBusinessServices>, "dashboardAgenda" | "planner" | "procurement">
+  collaboration: Pick<ReturnType<typeof createCollaborationHost>, "threads" | "recipientThread" | "threadHistory">
+  authorizeSourceMapping: ReviewCompositionInput["collaboration"]["authorizeSourceMapping"]
+  maxMessages: number
+  extensions?: Pick<ReviewCompositionInput["ports"], "readBiPresentation" | "captureBiReviewChart" | "reviewOutcome">
+}): Pick<ReviewCompositionInput, "ports" | "collaboration"> {
+  const history = input.collaboration.threadHistory
+  if (!history) throw new Error("SF_REVIEW_THREAD_HISTORY_UNAVAILABLE")
+  return {
+    ports: {
+      ...input.extensions,
+      selectDashboardAgenda: input.business.dashboardAgenda,
+      planner: input.business.planner,
+      procurement: input.business.procurement,
+    },
+    collaboration: {
+      threads: createRecipientAwareThreadReads(input.collaboration.threads, input.collaboration.recipientThread),
+      history: { readVersion: history.readVersion },
+      authorizeSourceMapping: input.authorizeSourceMapping,
+      maxMessages: input.maxMessages,
+    },
+  }
+}
