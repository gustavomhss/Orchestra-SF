+import type { SfHostServices } from "../contracts/host-context.ts"
+import type { PortResult } from "../contracts/ports.ts"
+import { isSfPeriod } from "../contracts/validation.ts"
+import type { PlannerOverviewRequest } from "../planner/overview-host.ts"
+import { renderPlannerOverview } from "../planner/overview.ts"
+import { validPlannerVersionRequest } from "../planner/versions.ts"
+import type { PlannerVersionRequest } from "../planner/versions.ts"
+
+type Input = { action: "overview"; input: PlannerOverviewRequest }
+  | { action: "versions"; input: { selectedId?: string } }
+  | { action: "preview" | "apply"; input: PlannerVersionRequest }
+
+/** Private human transport. The producer owns source resolution and financial output. */
+export async function handleSfPlannerVersions(request: Request, origin: string, runtime: SfHostServices) {
+  const reply = (value: unknown, status: number) => Response.json(value, { status, headers: { "Cache-Control": "no-store", "X-Content-Type-Options": "nosniff" } })
+  if (request.method !== "POST") return reply({ status: "denied" }, 405)
+  if (new URL(request.url).origin !== origin || request.headers.get("origin") !== origin || request.headers.get("sec-fetch-site") === "cross-site") return reply({ status: "denied" }, 403)
+  if (!request.headers.get("content-type")?.toLowerCase().startsWith("application/json") || !/^[A-Za-z0-9._:-]{8,128}$/.test(request.headers.get("idempotency-key") ?? "")) return reply({ status: "invalid" }, 400)
+  const body = await request.text()
+  if (new TextEncoder().encode(body).byteLength > 65536) return reply({ status: "invalid" }, 413)
+  const parsed = decode(await Promise.resolve().then(() => JSON.parse(body)).catch(() => undefined))
+  if (!parsed) return reply({ status: "invalid" }, 400)
+  if (parsed.action === "overview" ? !runtime.plannerOverview : !runtime.plannerVersions) return reply({ status: "unavailable" }, 503)
+  const action = parsed.action === "overview" || parsed.action === "versions" ? "planner.read" : parsed.action === "preview" ? "planner.preview" : "planner.apply"
+  const admitted = await runtime.human.admit(request, action, parsed.input)
+  if (admitted.status !== "ok") return reply({ status: admitted.status }, admitted.status === "unavailable" ? 503 : 403)
+  const respond = async (result: PortResult<unknown> | undefined, html?: string) => {
+    if (!result) return reply({ status: "unavailable" }, 503)
+    if (result.status !== "ok") return reply(result, result.status === "denied" ? 403 : result.status === "stale" || result.status === "conflict" ? 409 : result.status === "needs-input" ? 400 : 503)
+    if (!await runtime.ui.revalidate(admitted.value)) return reply({ status: "denied" }, 403)
+    return reply({ status: "ok", value: result.value, ...(html === undefined ? {} : { html }) }, 200)
+  }
+  try {
+    if (parsed.action === "overview") {
+      const result = await runtime.plannerOverview!.read(admitted.value, parsed.input).catch(() => undefined)
+      return await respond(result, result?.status === "ok" ? renderPlannerOverview(result.value) : undefined)
+    }
+    if (parsed.action === "versions") return await respond(await runtime.plannerVersions!.read(admitted.value, parsed.input).catch(() => undefined))
+    return await respond(await runtime.plannerVersions![parsed.action](admitted.value, parsed.input).catch(() => undefined))
+  } finally { runtime.human.finish(admitted.value) }
+}
+
+function record(value: unknown): value is Record<string, unknown> {
+  return !!value && typeof value === "object" && !Array.isArray(value)
+}
+
+function decode(value: unknown): Input | undefined {
+  if (!record(value) || Object.keys(value).length !== 2 || Object.keys(value).some((key) => key !== "action" && key !== "input") || !record(value.input)) return undefined
+  const input = value.input
+  if (value.action === "overview") {
+    if (Object.keys(input).length !== 3 || Object.keys(input).some((key) => !["baseVersionId", "candidateVersionId", "period"].includes(key)) || typeof input.baseVersionId !== "string" || !input.baseVersionId.trim() || typeof input.candidateVersionId !== "string" || !input.candidateVersionId.trim() || !isSfPeriod(input.period)) return undefined
+    return { action: "overview", input: { baseVersionId: input.baseVersionId, candidateVersionId: input.candidateVersionId, period: input.period } }
+  }
+  if (value.action === "versions") {
+    if (Object.keys(input).some((key) => key !== "selectedId") || input.selectedId !== undefined && (typeof input.selectedId !== "string" || !input.selectedId.trim())) return undefined
+    return { action: "versions", input: typeof input.selectedId === "string" ? { selectedId: input.selectedId } : {} }
+  }
+  return (value.action === "preview" || value.action === "apply") && validPlannerVersionRequest(input) ? { action: value.action, input } : undefined
+}
