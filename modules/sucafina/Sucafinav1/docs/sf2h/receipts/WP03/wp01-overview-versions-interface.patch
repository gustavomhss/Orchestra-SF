+export const plannerOverviewWidget = '<section data-planner-comparison-control><h2>Compare plan versions</h2><p>Choose a baseline and a candidate for the same fiscal year. The comparison keeps changes from baseline separate from budget variances.</p><form data-planner-comparison-form><label>Baseline version<select name="baseVersion" required><option value="">Choose a baseline</option></select></label><label>Candidate version<select name="version" required><option value="">Choose a candidate</option></select></label><button type="submit">Compare versions</button></form><p data-planner-status role="status" aria-live="polite">Loading authorized versions…</p><div data-planner-comparison-result></div></section>'
+
+export const plannerVersionsWidget = '<section data-planner-version-review><h2>Review version changes</h2><p>Version changes are previewed before you apply them. Your entries remain available when a conflict requires review.</p><p data-planner-status role="status" aria-live="polite">Loading authorized versions…</p></section>'
+
+/** Attach to the existing authorized Planner pages and retain the original revision. */
+export const plannerOverviewVersionsScript = String.raw`
+(() => {
+  const send = async (action, input, key = crypto.randomUUID()) => {
+    const url = new URL(location.href); url.search = '?sf=workbench-planner-versions'
+    const response = await fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'Idempotency-Key': key }, body: JSON.stringify({ action, input }) })
+    const result = await response.json()
+    if (!response.ok || result.status !== 'ok') throw new Error(result.reason || result.status || 'unavailable')
+    return result
+  }
+  const selectUrl = (values) => {
+    const url = new URL(location.href)
+    Object.entries(values).forEach(([key, value]) => { if (value) url.searchParams.set(key, value); else url.searchParams.delete(key) })
+    history.replaceState(null, '', url)
+  }
+  document.querySelectorAll('[data-planner-comparison-control]').forEach((section) => {
+    if (section.dataset.sfPlannerReady) return; section.dataset.sfPlannerReady = 'true'
+    const form = section.querySelector('form'); const status = section.querySelector('[data-planner-status]'); const output = section.querySelector('[data-planner-comparison-result]')
+    const base = form.elements.baseVersion; const candidate = form.elements.version; const button = form.querySelector('button')
+    const wanted = new URL(location.href).searchParams
+    let versions = []
+    button.disabled = true
+    send('versions', {}).then(({ value }) => {
+      if (!section.isConnected) return
+      versions = value.versions
+      ;[base, candidate].forEach((select) => {
+        versions.forEach((version) => { const option = document.createElement('option'); option.value = version.id; option.textContent = version.name + ' · ' + version.year + ' · ' + version.state; select.append(option) })
+        const selected = wanted.get(select.name)
+        if (selected && !versions.some((version) => version.id === selected)) { const missing = document.createElement('option'); missing.value = selected; missing.textContent = 'Saved selection unavailable'; select.append(missing) }
+        select.value = selected || ''
+      })
+      button.disabled = false
+      status.textContent = [base, candidate].some((select) => select.value && !versions.some((version) => version.id === select.value)) ? 'A saved selection is unavailable. Choose an accessible version to compare.' : 'Choose both versions, then compare.'
+    }).catch(() => { status.textContent = 'Version discovery is unavailable. Existing selections have not been replaced.' })
+    form.addEventListener('change', () => { output.replaceChildren(); selectUrl({ baseVersion: base.value, version: candidate.value }) })
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault()
+      const selected = versions.find((version) => version.id === candidate.value)
+      const baseline = versions.find((version) => version.id === base.value)
+      output.replaceChildren()
+      if (!selected || !baseline || selected.year !== baseline.year) { status.textContent = 'Choose accessible versions in the same fiscal year.'; return }
+      const request = { baseVersionId: baseline.id, candidateVersionId: selected.id, period: { start: selected.year + '-01-01', end: selected.year + '-12-31' } }
+      selectUrl({ baseVersion: baseline.id, version: selected.id, year: String(selected.year) })
+      button.disabled = true; base.disabled = true; candidate.disabled = true; status.textContent = 'Checking current sources…'
+      try {
+        const result = await send('overview', request)
+        if (!section.isConnected || typeof result.html !== 'string') return
+        output.innerHTML = result.html
+        status.textContent = 'Comparison loaded from the current authorized sources.'
+      } catch { status.textContent = 'Comparison is unavailable or its sources changed. Your selections are preserved.' }
+      finally { button.disabled = false; base.disabled = false; candidate.disabled = false }
+    })
+  })
+  document.querySelectorAll('[data-planner-version-review]').forEach((section) => {
+    const status = section.querySelector('[data-planner-status]')
+    if (!section.dataset.sfPlannerReady) {
+      section.dataset.sfPlannerReady = 'true'
+      const selectedId = new URL(location.href).searchParams.get('version')
+      send('versions', selectedId ? { selectedId } : {}).then(({ value }) => {
+        if (!section.isConnected) return
+        const selected = value.versions.find((version) => version.id === value.selectedId)
+        status.textContent = value.selectionState === 'unavailable' ? 'The saved version selection is unavailable.' : selected ? 'Selected version: ' + selected.name + ' · ' + selected.year + '.' : 'Choose Manage on a version to preview a change.'
+      }).catch(() => { status.textContent = 'Version discovery is unavailable.' })
+    }
+    document.querySelectorAll('form[data-page="Versions"][data-command]').forEach((form) => {
+      if (form.dataset.sfVersionBound) return; form.dataset.sfVersionBound = 'true'
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault(); event.stopImmediatePropagation()
+        const action = form.dataset.command; const id = form.dataset.record; const revision = Number(form.dataset.version)
+        if (!['save', 'copy', 'lock', 'unlock', 'official', 'delete'].includes(action) || !Number.isSafeInteger(revision) || revision < 0) return
+        const original = Object.fromEntries(new FormData(form))
+        const fingerprint = JSON.stringify(original)
+        const submit = form.querySelector('button[type=submit]')
+        const previousDirty = form.dataset.dirty
+        form.dataset.dirty = 'true'; submit.disabled = true
+        form.querySelector('[data-sf-version-review]')?.remove()
+        const box = document.createElement('div'); box.dataset.sfVersionReview = 'true'
+        const message = document.createElement('p'); message.setAttribute('role', 'status'); message.setAttribute('aria-live', 'polite'); message.textContent = 'Preparing preview…'; box.append(message); form.append(box)
+        const details = (title, value) => { const heading = document.createElement('p'); heading.textContent = title; const body = document.createElement('pre'); body.textContent = JSON.stringify(value, null, 2); box.append(heading, body) }
