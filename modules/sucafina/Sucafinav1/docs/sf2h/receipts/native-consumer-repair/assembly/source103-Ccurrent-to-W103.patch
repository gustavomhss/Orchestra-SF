+++ b/modules/sucafina/Sucafinav1/test/product/native-consumer-repair/deadline.test.ts
@@ -0,0 +1,61 @@
+import { expect, test } from "bun:test"
+import { Effect } from "effect"
+import { createSfRoutineNativeOrigin } from "../../../../../../apps/cli/src/sucafina-product/routine-native-origin.ts"
+import type { SfRoutineNativeOriginalAdmission } from "../../../../../../apps/cli/src/sucafina-product/routine-native-origin.ts"
+import type { SfRoutineNativeHistoricalAuthority } from "../../../../../../apps/cli/src/sucafina-product/routine-native-registry.ts"
+import { ids } from "../routine-native-owner-binding/fixture.ts"
+import { withAdmissionFixture } from "../native-admission-closure/fixture.ts"
+
+// The original Request/lease must bound pending attestations, before any binding is published.
+test("pending native admission expires during the first unresolved C15 reader", () =>
+  withAdmissionFixture((f) => Effect.gen(function* () {
+    const beganAt = Date.now()
+    f.state.now = beganAt
+    const context = { ...f.uiContext, binding: {
+      ...f.uiContext.binding, expiresAt: new Date(beganAt + 400).toISOString(),
+    } }
+    f.state.context = context
+    const bridge = createSfRoutineNativeOrigin({
+      ready: () => true,
+      resources: () => f.state.resources,
+      requestFor: (incoming) => incoming === context ? f.state.request : undefined,
+      authorize: async (incoming) => incoming === context && f.state.authorized,
+      authorizeIntent: async () => true,
+      generation: async () => f.state.generation,
+      now: () => f.state.now,
+    })
+    yield* Effect.addFinalizer(() => Effect.sync(bridge.dispose))
+    const blocked = new Promise<boolean>(() => {})
+    const source: SfRoutineNativeOriginalAdmission = {
+      request: f.state.request, context, authoritySessionID: ids.parent,
+      intent: f.expectedIntent, signal: f.nativeController.signal,
+      current: async () => blocked,
+      nativePolicy: { signal: new AbortController().signal, current: async () => true },
+    }
+    expect(yield* Effect.promise(() => bridge.admit(source))).toBeUndefined()
+    expect(yield* Effect.promise(() => bridge.origin.resolve(f.invocation))).toBeUndefined()
+  })))
+
+test("pending historical read expires before attestation, with zero egress or Task authority", () =>
+  withAdmissionFixture((f) => Effect.gen(function* () {
+    const beganAt = Date.now()
+    f.state.now = beganAt
+    const request = new Request("https://sf-fixture.invalid/routines/history", { method: "GET" })
+    const context = { ...f.ui(), binding: {
+      ...f.binding, expiresAt: new Date(beganAt + 400).toISOString(),
+    } }
+    f.state.request = request
+    f.state.context = context
+    const blocked = new Promise<boolean>(() => {})
+    const evidence: SfRoutineNativeHistoricalAuthority = {
+      authoritySessionID: ids.parent, signal: new AbortController().signal,
+      current: async () => blocked,
+    }
+    let exposed = false
+    const result = yield* Effect.promise(() => f.registry.withReauthenticatedRead(context, request, evidence,
+      async () => { exposed = true; return "restricted" }))
+    expect(result).toBeUndefined()
+    expect(exposed).toBe(false)
+    expect(f.registry.owners.available()).toBe(false)
+    expect(yield* Effect.promise(() => f.registry.owners.resolve(context, request))).toBeUndefined()
+  })))

diff --git a/modules/sucafina/Sucafinav1/test/product/native-consumer-repair/observe.test.ts b/modules/sucafina/Sucafinav1/test/product/native-consumer-repair/observe.test.ts
new file mode 100644
index 0000000..4a61983
--- /dev/null
+++ b/modules/sucafina/Sucafinav1/test/product/native-consumer-repair/observe.test.ts
@@ -0,0 +1,68 @@
+import { expect, test } from "bun:test"
+import { observeSfRoutineNative } from "../../../../../../apps/cli/src/sucafina-product/routine-native-origin.ts"
+
+// Component only: this observes async boundaries; it cannot certify a native C15 producer.
+test("native observe exports a working bounded read and rejects reader exceptions", async () => {
+  const signal = new AbortController().signal
+  const value = { authorization: "synthetic-value" }
+  expect(await observeSfRoutineNative(async () => value, signal)).toBe(value)
+  expect(await observeSfRoutineNative(async () => { throw new Error("untrusted reader") }, signal))
+    .toBeUndefined()
+})
+
+test("invalid, infinite and oversized budgets fail closed before touching the reader", async () => {
+  let calls = 0
+  const read = async () => { calls++; return "forbidden" }
+  const signal = new AbortController().signal
+  for (const budget of [0, -1, NaN, Infinity, 30_001, 0.5])
+    expect(await observeSfRoutineNative(read, signal, budget)).toBeUndefined()
+  expect(calls).toBe(0)
+})
+
+test("pre-aborted and same-turn-aborted signals never start queued native callbacks", async () => {
+  const cancelled = new AbortController()
+  cancelled.abort()
+  let calls = 0
+  const read = async () => { calls++; return "forbidden" }
+  expect(await observeSfRoutineNative(read, cancelled.signal)).toBeUndefined()
+  const late = new AbortController()
+  const pending = observeSfRoutineNative(read, late.signal)
+  late.abort()
+  expect(await pending).toBeUndefined()
+  expect(calls).toBe(0)
+})
+
+test("revocation wins against an in-flight read and its late completion cannot escape", async () => {
+  const controller = new AbortController()
+  let release: (value: string) => void = () => {}
+  const held = new Promise<string>((resolve) => { release = resolve })
+  let entered: () => void = () => {}
+  const enteredPromise = new Promise<void>((resolve) => { entered = resolve })
+  const pending = observeSfRoutineNative(() => { entered(); return held }, controller.signal)
+  await enteredPromise
+  controller.abort()
+  expect(await pending).toBeUndefined()
+  release("late-restricted-result")
+  await Promise.resolve()
+  expect(controller.signal.aborted).toBe(true)
+})
+
+test("a never-settling reader ends on its explicit deadline, without infinite timeout", async () => {
+  const signal = new AbortController().signal
+  let calls = 0
+  const value = await observeSfRoutineNative(() => {
+    calls++
+    return new Promise<string>(() => {})
+  }, signal, 20)
+  expect(value).toBeUndefined()
+  expect(calls).toBe(1)
+})
+
+test("revocation during the reader prevents its synchronous result escaping", async () => {
+  const controller = new AbortController()
+  const value = await observeSfRoutineNative(async () => {
+    controller.abort()
+    return { confidential: "not-for-egress" }
+  }, controller.signal)
+  expect(value).toBeUndefined()
+})
