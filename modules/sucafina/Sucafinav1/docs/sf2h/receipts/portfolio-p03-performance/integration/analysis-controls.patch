+test("new comparison binds once; exact retry retains C08 and every analysis observation", async () => {
+  const proof = await createProof("one-binding")
+  try {
+    const first = await proof.analysis.evaluate(proof.world.analysisRequest, proof.context)
+    expect(first.status).toBe("ok")
+    if (first.status !== "ok") throw new Error(JSON.stringify(first))
+    expect(proof.counts.binds).toBe(1)
+    expect(first.value.analysis.scenarioResultRef).toBe(proof.world.selectedRef)
+    expect(first.value.analysis.comparison.baselineResultRef).toBe(proof.world.baselineRef)
+    expect(first.value.analysis.comparison.alternativeResultRef).toBe(proof.world.selectedRef)
+    expect(first.value.constraints.map((criterion) => criterion.ref)).toEqual(proof.world.analysisRequest.portfolio.constraints)
+    const allocated = proof.world.ids.value
+    const durable = await proof.snapshots()
+    proof.resetCounts()
+    expect(await proof.analysis.revalidate(first.value.analysis, proof.context)).toBe(true)
+    // Direct analysis boundaries, excluding the canonical producers' internal calls.
+    expect(proof.counts).toEqual({ binds: 0, bindingReads: 2, comparisonReads: 2, scenarioReads: 4, replays: 1 })
+    expect(await proof.snapshots()).toEqual(durable)
+    console.info("[mission54-discriminant]", JSON.stringify({ firstEvaluationBinds: 1, revalidation: proof.counts }))
+    proof.resetCounts()
+    const retried = await proof.analysis.evaluate(proof.world.analysisRequest, proof.context)
+    expect(retried.status).toBe("ok")
+    if (retried.status !== "ok") throw new Error(JSON.stringify(retried))
+    expect(retried.value).toEqual(first.value)
+    expect(retried.value.analysis.comparisonRef).toBe(first.value.analysis.comparisonRef)
+    expect(proof.counts.binds).toBe(0)
+    expect(proof.world.ids.value).toBe(allocated)
+    expect(await proof.snapshots()).toEqual(durable)
+  } finally { await proof.cleanup() }
+}, 30000)
