+test("new binding reuse observes a canonical rule CAS committed inside its read callback", async () => {
+  const proof = await createProof("binding-rule-cas")
+  try {
+    let revisionStatus: string | undefined
+    proof.controls.afterBindingRead = async (number) => {
+      if (number !== 2) return
+      proof.world.ruleOperation.id = "mission54-binding-rule-cas"
+      const changed = await proof.world.rules.register({ caseRef: proof.world.caseRef, criterionId: "renewal-difference", metricRef: "planner:known-subtotal-difference", operator: "gte", value: 1, unit: "USD", period: proof.world.analysisRequest.portfolio.scope.horizon, evidenceRefs: [proof.world.evidence], expectedRuleVersion: 1, sensitivity: proof.world.issuedUnits }, proof.context)
+      revisionStatus = changed.status
+    }
+    const evaluated = await proof.analysis.evaluate(proof.world.analysisRequest, proof.context)
+    expect(revisionStatus).toBe("ok")
+    expect(evaluated.status).not.toBe("ok")
+    expect(proof.counts.binds).toBe(1)
+    expect(proof.counts.bindingReads).toBe(3)
+    expect(await proof.ui.revalidate(proof.context)).toBe(true)
+  } finally { await proof.cleanup() }
+}, 30000)
