+test("newly persisted binding reuse refuses UI revocation before its independent final read", async () => {
+  const proof = await createProof("new-binding-revoked")
+  try {
+    const allocated = proof.world.ids.value
+    let revoked = false
+    proof.controls.afterBindingRead = (number) => {
+      // Persistence's final read is first; analysis's new read-before-bind is second.
+      if (number !== 2) return
+      revoked = true
+      proof.ui.finish(proof.context)
+    }
+    const evaluated = await proof.analysis.evaluate(proof.world.analysisRequest, proof.context)
+    expect(evaluated.status).not.toBe("ok")
+    expect(revoked).toBe(true)
+    expect(proof.counts.binds).toBe(1)
+    expect(proof.counts.bindingReads).toBe(3)
+    expect(proof.world.ids.value).toBe(allocated + 1)
+    expect(await proof.ui.revalidate(proof.context)).toBe(false)
+    expect(proof.ui.requestFor(proof.context)).toBeUndefined()
+  } finally { await proof.cleanup() }
+}, 30000)
