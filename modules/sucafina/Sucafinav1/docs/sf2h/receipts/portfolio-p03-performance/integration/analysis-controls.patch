+/** Real LocalStore/C08/Planner/rule services with the existing fixture's
+ * synthetic source/metric boundary; every operation uses actual consumed UI admission. */
+async function createProof(label: string) {
+  const world = await createWp13AnalysisFixture()
+  try {
+    const key = "mission54-read-before-bind:" + label
+    const authorization = "mission54:" + label
+    world.request.headers.set("authorization", authorization)
+    const identity = { installationId: world.context.binding.installationId, projectId: world.context.binding.projectId, principalRef: world.context.binding.principalRef, policyVersion: world.context.binding.policyVersion, accessRevision: world.context.binding.accessRevision }
+    const operation = "sf_portfolio_evaluate"
+    const inputDigest = digestSfValue(world.analysisRequest.portfolio)
+    const ui = createSfUiAuthority({
+      authorize: async (request, requestedOperation, requestedDigest) => world.access.allowed && request === world.request && request.headers.get("authorization") === authorization && requestedOperation === operation && requestedDigest === inputDigest ? identity : undefined,
+      commandIdentity: async () => key, createId: () => key + ":request", now: () => Date.parse("2026-11-13T00:00:00Z"),
+    })
+    const admitted = await ui.admit(world.request, operation, inputDigest)
+    if (admitted.status !== "ok") throw new Error(JSON.stringify(admitted))
+    const context = admitted.value
+    if (!await ui.validate(context, operation, inputDigest)) throw new Error("Exact UI admission was not consumed")
+    world.host.requestFor = (trusted) => trusted.kind === "ui" ? ui.requestFor(trusted) : undefined
+    world.host.revalidate = (trusted) => trusted.kind === "ui" ? ui.revalidate(trusted) : Promise.resolve(false)
+    const selected = await world.selection.register({ caseRef: world.caseRef, baselineAlternativeId: "baseline", alternativeId: "selected", criteria: world.analysisRequest.portfolio.constraints, expectedVersion: 0 }, context)
+    if (selected.status !== "ok") throw new Error(JSON.stringify(selected))
+    const counts = { binds: 0, bindingReads: 0, comparisonReads: 0, scenarioReads: 0, replays: 0 }
+    const controls: { failNextBind: boolean; afterBindingRead?: (number: number) => void | Promise<void> } = { failNextBind: false }
+    const results = { ...world.results,
+      read: async (...args: Parameters<typeof world.results.read>) => { counts.comparisonReads++; return world.results.read(...args) },
+      readHistoricalScenario: async (...args: Parameters<typeof world.results.readHistoricalScenario>) => { counts.scenarioReads++; return world.results.readHistoricalScenario(...args) },
+    }
+    const planner = { ...world.plannerWithCriteria, compareScenarios: async (...args: Parameters<typeof world.plannerWithCriteria.compareScenarios>) => { counts.replays++; return world.plannerWithCriteria.compareScenarios(...args) } }
+    const bindings = { ...world.comparisonBindings,
+      bind: async (...args: Parameters<typeof world.comparisonBindings.bind>) => {
+        counts.binds++
+        if (controls.failNextBind) { controls.failNextBind = false; return { status: "unavailable" as const, reason: "injected-before-binding-commit" } }
+        return world.comparisonBindings.bind(...args)
+      },
+      read: async (...args: Parameters<typeof world.comparisonBindings.read>) => {
+        const number = ++counts.bindingReads
+        const value = await world.comparisonBindings.read(...args)
+        if (value.status === "ok") await controls.afterBindingRead?.(number)
+        return value
+      },
+    }
+    const analysis = createPortfolioAnalysis({ planner, results, bindings, persist: createPlannerResultPersistence({ store: results, scenarios: world.scenarios, comparisonBindings: bindings, replay: planner, resolveCase: async () => ({ status: "ok", value: world.caseRef }) }), select: world.selectPortfolio, idempotencyKey: async () => key })
+    const transactionAll = world.store.transactionAll?.bind(world.store)
+    if (!transactionAll) throw new Error("Real multi-surface LocalStore unavailable")
+    return { world, context, ui, key, analysis, counts, controls,
+      resetCounts: () => { counts.binds = 0; counts.bindingReads = 0; counts.comparisonReads = 0; counts.scenarioReads = 0; counts.replays = 0 },
+      snapshots: () => transactionAll(async (snapshots) => ({ commit: false, value: structuredClone(snapshots) })),
+      cleanup: async () => { ui.finish(context); await world.cleanup() },
+    }
+  } catch (error) { await world.cleanup(); throw error }
+}
