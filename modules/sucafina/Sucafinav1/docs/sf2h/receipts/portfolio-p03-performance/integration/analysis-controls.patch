+for (const mode of ["finish", "request-header", "replaced-context"] as const) {
+  test("analysis refuses " + mode + " after its second canonical binding observation", async () => {
+    const proof = await createProof("late-" + mode)
+    try {
+      const evaluated = await proof.analysis.evaluate(proof.world.analysisRequest, proof.context)
+      expect(evaluated.status).toBe("ok")
+      if (evaluated.status !== "ok") throw new Error(JSON.stringify(evaluated))
+      const durable = await proof.snapshots()
+      const allocated = proof.world.ids.value
+      const replacement = { ...proof.context, lease: Object.freeze({}) } as typeof proof.context
+      const requestFor = proof.world.host.requestFor
+      const revalidate = proof.world.host.revalidate
+      let changed = false
+      proof.resetCounts()
+      proof.controls.afterBindingRead = (number) => {
+        if (number !== 2) return
+        changed = true
+        if (mode === "finish") proof.ui.finish(proof.context)
+        if (mode === "request-header") proof.world.request.headers.delete("authorization")
+        if (mode === "replaced-context") {
+          proof.world.host.requestFor = (trusted) => requestFor(trusted === proof.context ? replacement : trusted)
+          proof.world.host.revalidate = (trusted) => revalidate(trusted === proof.context ? replacement : trusted)
+        }
+      }
+      expect(await proof.analysis.revalidate(evaluated.value.analysis, proof.context)).toBe(false)
+      expect(changed).toBe(true)
+      expect(proof.counts.bindingReads).toBe(2)
+      expect(proof.counts.replays).toBe(1)
+      expect(proof.world.ids.value).toBe(allocated)
+      expect(await proof.snapshots()).toEqual(durable)
+      expect(await proof.ui.revalidate(proof.context)).toBe(mode === "replaced-context")
+      expect(proof.ui.requestFor(proof.context)).toBe(mode === "replaced-context" ? proof.world.request : undefined)
+      expect(replacement.binding).toBe(proof.context.binding)
+      expect(replacement.lease).not.toBe(proof.context.lease)
+      expect(await proof.ui.revalidate(replacement)).toBe(false)
+      expect(proof.ui.requestFor(replacement)).toBeUndefined()
+    } finally { await proof.cleanup() }
+  }, 30000)
