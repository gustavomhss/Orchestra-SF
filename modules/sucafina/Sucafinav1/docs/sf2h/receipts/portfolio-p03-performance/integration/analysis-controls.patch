+test("a partial C08 recovers its missing binding once without another result", async () => {
+  const proof = await createProof("partial")
+  try {
+    proof.controls.failNextBind = true
+    expect(await proof.analysis.evaluate(proof.world.analysisRequest, proof.context)).toEqual({ status: "unavailable", reason: "comparison-persisted-but-binding-unavailable" })
+    const comparison = { scenarioRefs: [proof.world.baselineRef, proof.world.selectedRef], criteria: proof.world.analysisRequest.portfolio.constraints }
+    const requestDigest = digestSfValue(comparison)
+    const partial = await proof.world.results.readByRequest({ caseRef: proof.world.caseRef, kind: "comparison", idempotencyKey: "portfolio-comparison:" + proof.key + ":" + requestDigest, requestDigest }, proof.context)
+    expect(partial.status === "ok" && partial.value.state).toBe("found")
+    if (partial.status !== "ok" || partial.value.state !== "found") throw new Error(JSON.stringify(partial))
+    const resultRef = partial.value.result.resultRef
+    const resultDigest = partial.value.result.resultDigest
+    const allocated = proof.world.ids.value
+    expect((await proof.world.comparisonBindings.read({ caseRef: proof.world.caseRef, resultRef }, proof.context)).status).toBe("unavailable")
+    expect(proof.counts.binds).toBe(1)
+    const recovered = await proof.analysis.evaluate(proof.world.analysisRequest, proof.context)
+    expect(recovered.status).toBe("ok")
+    if (recovered.status !== "ok") throw new Error(JSON.stringify(recovered))
+    expect(recovered.value.analysis.comparisonRef).toBe(resultRef)
+    expect(digestSfValue(recovered.value.analysis.comparison)).toBe(resultDigest)
+    expect(proof.world.ids.value).toBe(allocated)
+    expect(proof.counts.binds).toBe(2)
+    const durable = await proof.snapshots()
+    const retried = await proof.analysis.evaluate(proof.world.analysisRequest, proof.context)
+    expect(retried.status).toBe("ok")
+    if (retried.status !== "ok") throw new Error(JSON.stringify(retried))
+    expect(retried.value).toEqual(recovered.value)
+    expect(proof.counts.binds).toBe(2)
+    expect(proof.world.ids.value).toBe(allocated)
+    expect(await proof.snapshots()).toEqual(durable)
+  } finally { await proof.cleanup() }
+}, 30000)
