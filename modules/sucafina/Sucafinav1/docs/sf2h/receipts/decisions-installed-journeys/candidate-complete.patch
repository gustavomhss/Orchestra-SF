+async function fixture(options: { complete?: boolean; amounts?: readonly [readonly (number | null)[], readonly (number | null)[]]; reuseReplies?: boolean } = {}) {
+  const identity = { installationId: "metric-install", projectId: "metric-project", principalRef: "metric-reader", accessRevision: "access-1", policyVersion: "policy-1" }
+  const abort = new AbortController()
