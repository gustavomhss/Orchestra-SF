+// Surgical adapter contracts: real UI leases, canonical coverage and comparison math.
+// Data/read-port fixtures below are explicit unit observations, not an installed
+// journey, a C08 durability claim, seeds for E2E, or a substitute for the five UI cases.
+type StoredScenario = Extract<StoredDecisionResult, { kind: "scenario" }>
+type PlannerRecord = Extract<BusinessEvidenceRef, { kind: "record" }>
+type MetricResult = Awaited<ReturnType<ReturnType<typeof createSfKnownSubtotalMetric>>>
+type Stage = "history" | "case" | "projection" | "source" | "coverage"
+type Boundary = { stage: Stage; count: number; key: string; args: unknown[]; value: unknown }
+type Hook = (point: Boundary) => void | Promise<void>
+const at = "2026-11-15T03:00:00.000Z"
+const period = { start: "2027-01-01", end: "2027-12-31" }
+const caseRef = { id: "metric-case", incarnation: "metric-case-inc", version: 4 }
+const references = ["stored:baseline", "stored:candidate"] as const
+
+async function fixture(options: { complete?: boolean; amounts?: readonly [readonly (number | null)[], readonly (number | null)[]]; reuseReplies?: boolean } = {}) {
+  const identity = { installationId: "metric-install", projectId: "metric-project", principalRef: "metric-reader", accessRevision: "access-1", policyVersion: "policy-1" }
+  const abort = new AbortController()
+  const transport = new Request("https://example.test/sucafina/planner?sf=decision-compare", {
+    method: "POST", headers: { origin: "https://example.test", "content-type": "application/json" }, signal: abort.signal,
+  })
+  const state = { allowed: true, identity: { ...identity }, now: Date.parse(at), serial: 0, hook: undefined as Hook | undefined,
+    requestOverride: undefined as Request | undefined, counts: { history: 0, case: 0, projection: 0, source: 0, coverage: 0 },
+    events: [] as { stage: Stage; key: string }[], reuseReplies: options.reuseReplies === true, replies: new Map<Stage, object>(),
+    legacyBatches: [] as string[][], legacyScalar: [] as string[], writes: 0 }
+  const ui = createSfUiAuthority({ authorize: async (request) => request === transport && state.allowed ? { ...state.identity } : undefined,
+    commandIdentity: async () => "metric-contract", createId: () => `metric-admission-${++state.serial}`, now: () => state.now })
+  const request: KnownSubtotalMetricRequest = { caseRef: { ...caseRef }, criterionId: "cost", ruleRef: "rule:cost", ruleVersion: 1,
+    metricRef: "planner:known-subtotal-difference", baselineRef: references[0], scenarioRef: references[1] }
+  const digest = digestSfValue(request)
+  const admitted = await ui.admit(transport, "sf_scenario_compare", digest)
+  if (admitted.status !== "ok" || !await ui.validate(admitted.value, "sf_scenario_compare", digest)) throw new Error("Real UI admission failed")
+  const context = admitted.value
+  // The canonical helper explicitly retains independent-port behavior when no
+  // persistence adapter is supplied. SQLite/root semantics have separate59 tests.
+  const host: DomainPortHost = { persistence: undefined as unknown as DomainPortHost["persistence"],
+    authenticate: async () => undefined,
+    environment: async () => { throw new Error("Environment is not consumed by this metric fixture") },
+    requestFor: (call) => state.requestOverride ?? (call.kind === "ui" ? ui.requestFor(call) : undefined),
+    revalidate: (call) => call.kind === "ui" ? ui.revalidate(call) : Promise.resolve(false) }
+  const records: PlannerRecord[] = ["v0", "v1"].map((id) => {
+    const value: PlannerRecord = { schema: "sf-evidence-v1", kind: "record", refId: `planner-source:${id}`,
+      installationId: identity.installationId, projectId: identity.projectId, refDigest: "", evidenceLevel: "observed",
+      target: { surface: "planner", recordType: "planner-version", recordId: id, incarnation: `${id}-inc`, version: 1,
+        fields: ["lines"], period, projectionDigest: digestSfValue({ versionId: id, fixture: "authorized projection" }) } }
+    return { ...value, refDigest: digestSfEvidenceRef(value) }
+  })
+  const basis: CostCoverageBasis = { id: "metric-coverage", version: 1, decisionType: "renewal-transition-v1",
+    categoryIds: [...RENEWAL_TRANSITION_CATEGORIES], additionalCategoryIds: [], sourceRefs: records }
+  const projections: Record<string, DomainProjection> = {}
+  const alternatives: DecisionCase["alternatives"][number][] = []
+  for (const [index, source] of records.entries()) {
+    const record: SourceRef = { surface: "planner", type: "planner-version", id: source.target.recordId,
+      incarnation: source.target.incarnation, version: source.target.version, fields: source.target.fields, period, observedAt: at }
+    const amounts = options.amounts?.[index] ?? [index === 0 ? 1200 : 2400]
+    const projection: DomainProjection = { context: { ...identity, surface: "planner", period, currency: "USD", sourceRefs: [record], capabilities: [] },
+      version: 1, engineVersion: "planner-contract-v1", values: [],
+      components: amounts.map((amount, component) => ({ id: `service-${component}`, amount, currency: "USD", period,
+        sourceRefs: [record], evidenceState: amount === null ? "absent" : "confirmed" })),
+      missing: amounts.some((amount) => amount === null) ? [{ field: "service", reason: "missing" }] : [] }
+    projections[source.target.recordId] = projection
+    const id = index === 0 ? "baseline" : "candidate"
+    const entries: CostCoverageEntry[] = RENEWAL_TRANSITION_CATEGORIES.map((categoryId) => categoryId === "service"
+      ? { categoryId, status: "included", componentRefs: projection.components.map((component) => component.id), evidenceRefs: [source], scopeNote: "Authorized fixture service amounts" }
+      : categoryId === "training" && !options.complete
+        ? { categoryId, status: "pending", reason: "Authorized training source is still absent" }
+        : { categoryId, status: "not-applicable", justification: `Explicit unit fixture scope excludes ${categoryId}`, evidenceRefs: [source] })
+    // Coverage authorization is the explicit port fixture; the inventory,
+    // monetary separation, pending classification and completeness checks are real.
+    const assessment = assessCostCoverage({ basis, alternativeId: id, alternativeVersion: 1, currency: "USD", horizon: period,
+      entries, components: projection.components,
+      evidence: records.map((ref) => ({ ref, state: "fresh", accessRevision: identity.accessRevision, checkedAt: at })), supports: () => true })
+    const subtotal = projection.components.some((component) => component.amount !== null)
+      ? plannerKnownSubtotal(projection.components.map((component) => component.amount)) : null
+    const common = { id: `source-scenario:${id}`, version: 1, components: structuredClone(projection.components), currency: "USD", horizon: period,
+      sourceRefs: [source], restrictions: [] }
+    const complete = assessment.coverageState === "complete" && subtotal !== null && plannerCoverageComplete(basis, assessment, projection, source)
+    const result: ScenarioResult = complete && assessment.coverageState === "complete" && subtotal !== null
+      ? { ...common, comparisonStatus: "complete", knownSubtotal: subtotal, total: subtotal, costCoverage: assessment, unresolvedConditions: [] }
+      : { ...common, comparisonStatus: "conditioned", knownSubtotal: subtotal, total: null, costCoverage: assessment,
+        unresolvedConditions: assessment.entries.flatMap((entry) => entry.status === "pending" ? [`coverage:${entry.categoryId}:${entry.reason}`] : []) }
+    alternatives.push({ id, version: 1, title: id, scenario: { baseRef: source.refId, operations: [], assumptions: [] }, result })
+  }
+  const data = { decision: { ...caseRef, state: "comparing", objective: "Contract fixture for two current Planner alternatives", currency: "USD", horizon: period,
+    criteria: [{ id: "cost", description: "Known subtotal difference", required: true }], participants: [identity.principalRef], sourceRefs: records,
+    alternatives, costCoverageBases: [basis], assumptions: [], questions: [], choices: [], preparedChanges: [], receipts: [], ledger: [] } as DecisionCase,
+    stored: {} as Record<string, StoredScenario>, projections,
+    sources: Object.fromEntries(records.map((source) => [source.refId, { versionId: source.target.recordId, evidence: structuredClone(source) }])) as Record<string, { versionId: string; evidence: PlannerRecord }>,
+    coverage: {} as Record<string, Extract<Awaited<ReturnType<PlannerSourceHost["resolveForecastCoverage"]>>, { status: "ok" }>["value"]> }
+  for (const [index, alternative] of alternatives.entries()) {
+    data.stored[references[index]!] = { schema: "sf-decision-result-v1", kind: "scenario", resultRef: references[index]!,
+      caseRef: { ...caseRef, version: index === 0 ? 3 : 4 }, principalRef: identity.principalRef, accessRevision: identity.accessRevision,
+      policyVersion: identity.policyVersion, requestDigest: digestSfValue(alternative.scenario), resultDigest: digestSfValue(alternative.result),
+      sourceRefs: structuredClone(alternative.result.sourceRefs), result: structuredClone(alternative.result), createdAt: at }
+    const coverageRef = decisionCoverageRef(caseRef, alternative.id, alternative.version)
+    data.coverage[coverageRef] = { coverageRef, basis: structuredClone(basis), assessment: structuredClone(alternative.result.costCoverage) }
+  }
+  const emit = async <T extends object>(stage: Stage, key: string, args: unknown[], incoming: T): Promise<T> => {
+    let value = incoming
+    if (state.reuseReplies) {
+      const prior = state.replies.get(stage)
+      if (prior) { for (const name of Object.keys(prior)) delete (prior as Record<string, unknown>)[name]; Object.assign(prior, incoming); value = prior as T }
+      else state.replies.set(stage, value)
+    }
+    state.events.push({ stage, key })
+    const count = ++state.counts[stage]
+    await state.hook?.({ stage, count, key, args, value })
+    return value
+  }
+  const business: KnownSubtotalMetricDependencies["business"] = {
+    results: {
+      read: async () => { throw new Error("Historical scenario reads must retain their canonical reader") },
+      readHistoricalScenario: async (selector, call) => {
+        if (call !== context) return { status: "denied", reason: "fixture-context-mismatch" }
+        const value = data.stored[selector.resultRef]
+        return emit("history", selector.resultRef, [selector, call], value
+          ? { status: "ok" as const, value: structuredClone(value) }
+          : { status: "unavailable" as const, reason: "fixture-result-missing" })
+      },
+    },
+    cases: { read: async (selector, call) => {
+      if (call !== context || selector.caseRef !== encodeCaseRef(caseRef)) return { status: "denied", reason: "fixture-case-scope-mismatch" }
+      const value: AuthorizedCaseProjection = { context: { ...identity, kind: "ui" },
+        case: { ...structuredClone(data.decision), preparedChanges: [], receipts: [] }, events: [], evidenceRefs: records, checkedAt: at }
+      return emit("case", selector.caseRef, [selector, call], { status: "ok" as const, value })
+    } },
+    plannerSources: {
+      resolveForecastSource: async (reference, call) => {
+        if (call !== context) return { status: "denied", reason: "fixture-context-mismatch" }
+        const value = data.sources[reference]
+        return emit("source", reference, [reference, call], value
+          ? { status: "ok" as const, value: structuredClone(value) }
+          : { status: "unavailable" as const, reason: "fixture-source-missing" })
+      },
+      resolveForecastCoverage: async (reference, call) => {
+        if (call !== context) return { status: "denied", reason: "fixture-context-mismatch" }
+        const value = data.coverage[reference]
+        return emit("coverage", reference, [reference, call], value
+          ? { status: "ok" as const, value: structuredClone(value) }
+          : { status: "unavailable" as const, reason: "fixture-coverage-missing" })
+      },
+    },
+    projectPlannerEvidence: async (source, call, selected) => {
+      if (call !== context) return { status: "denied", reason: "fixture-context-mismatch" }
+      const value = data.projections[source.target.recordId]
+      return emit("projection", source.target.recordId, [source, call, selected], value
+        ? { status: "ok" as const, value: structuredClone(value) }
+        : { status: "unavailable" as const, reason: "fixture-projection-missing" })
+    },
+  }
+  const input: KnownSubtotalMetricDependencies = { host, business }
+  const changeAlternative = (index: number, change: (value: DecisionCase["alternatives"][number]) => DecisionCase["alternatives"][number]) => {
+    const alternative = change(structuredClone(data.decision.alternatives[index]!))
+    data.decision.alternatives = data.decision.alternatives.map((value, selected) => selected === index ? alternative : value)
+    const previous = data.stored[references[index]!]!
+    data.stored[references[index]!] = { ...previous, requestDigest: digestSfValue(alternative.scenario), resultDigest: digestSfValue(alternative.result),
+      result: structuredClone(alternative.result), sourceRefs: structuredClone(alternative.result.sourceRefs) }
+  }
+  const resolved = (reference: string): PortResult<ResolvedScenario> => {
+    const index = references.indexOf(reference as typeof references[number])
+    if (index < 0) return { status: "unavailable", reason: "fixture-result-missing" }
+    const alternative = data.decision.alternatives[index]!, source = records[index]!
+    return { status: "ok", value: structuredClone({ result: alternative.result, source, basis,
+      coverageRef: decisionCoverageRef(caseRef, alternative.id, alternative.version), projection: data.projections[source.target.recordId]! }) }
+  }
+  return { input, host, business, context, ui, request, transport, abort, state, data, records, basis, resolved, changeAlternative,
+    read: createSfKnownSubtotalMetric(input), close: () => ui.finish(context) }
+}
+type Fixture = Awaited<ReturnType<typeof fixture>>
+
+function metric(result: MetricResult): CriterionMetric {
+  expect(result).not.toBe(knownSubtotalMetricNotApplicable)
+  if (typeof result === "symbol" || result.status !== "ok") throw new Error("Expected a proved metric")
+  return result.value
+}
+function refused(result: MetricResult, status?: Exclude<PortResult<unknown>["status"], "ok">) {
+  expect(result).not.toBe(knownSubtotalMetricNotApplicable)
+  if (typeof result === "symbol") throw new Error("A failed eligible proof must not select legacy fallback")
+  expect(result.status).not.toBe("ok")
+  if (status) expect(result.status).toBe(status)
+}
+function afterFirstProjection(f: Fixture, mutate: (value: Fixture) => void) {
+  f.state.hook = ({ stage, count }) => { if (stage === "projection" && count === 1) mutate(f) }
+}
+
+function wired(f: Fixture) {
+  const scenarios: PlannerScenarioHost = {
+    resolve: async (reference, call) => { expect(call).toBe(f.context); f.state.legacyScalar.push(reference); return f.resolved(reference) },
+    resolveMany: async (incoming, call) => { expect(call).toBe(f.context); f.state.legacyBatches.push([...incoming]); return incoming.map(f.resolved) },
+  }
+  const unexpected = () => { f.state.writes++; throw new Error("Unrelated Portfolio operation entered by metric contract") }
+  // Only the readMetric dependency path is exercised. All unrelated services
+  // fail explicitly; this is not a fake complete installed Portfolio host.
+  const services = { ...f.business, plannerProduct: { scenarios }, planner: {}, operationIdentity: () => "metric-contract",
+    readSourceFences: unexpected, lockedSourceFences: unexpected, context: { context: unexpected }, selectedCase: unexpected, resolveCase: unexpected }
+  const authority = { host: f.host, ui: f.ui, human: { authorize: unexpected }, state: { read: unexpected, transaction: unexpected } }
+  return createSfPortfolioAuthority({ authority, business: services, proposalCoverageWrites: new WeakSet<object>(), proof: () => undefined } as unknown as Parameters<typeof createSfPortfolioAuthority>[0]).readMetric
+}
