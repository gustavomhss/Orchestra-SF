+test("known subtotal metric preserves USD 1200, pending coverage and null totals through two independent observations", async () => {
+  const f = await fixture()
+  try {
+    const before = structuredClone(f.data)
+    expect(metric(await f.read(f.request, f.context))).toEqual({ ...f.request, value: 1200, unit: "USD", period,
+      evidenceRefs: f.records, state: "conditioned", engineVersion: "planner-contract-v1" })
+    expect(f.data.decision.alternatives.map((value) => value.result.total)).toEqual([null, null])
+    expect(f.data.decision.alternatives.every((value) => value.result.costCoverage.coverageState === "pending")).toBe(true)
+    expect(f.state.events.filter((event) => event.stage === "history").map((event) => event.key)).toEqual([...references, ...references])
+    expect(f.state.events.filter((event) => event.stage === "projection").map((event) => event.key)).toEqual(["v0", "v1", "v0", "v1"])
+    expect(f.state.counts).toEqual({ history: 4, case: 2, projection: 4, source: 4, coverage: 4 })
+    expect(f.data).toEqual(before)
+  } finally { f.close() }
+})
