+test("only actual canonical complete coverage yields a confirmed metric", async () => {
+  const f = await fixture({ complete: true })
+  try {
+    const baseline = f.resolved(references[0]), candidate = f.resolved(references[1])
+    if (baseline.status !== "ok" || candidate.status !== "ok") throw new Error("Fixture observations unavailable")
+    const oracle = comparePlannerScenarios({ baselineRef: references[0], alternativeRef: references[1],
+      baselineCoverageRef: baseline.value.coverageRef, alternativeCoverageRef: candidate.value.coverageRef,
+      baseline: baseline.value.result, alternative: candidate.value.result, baselineProof: baseline.value, alternativeProof: candidate.value })
+    expect(oracle.comparisonStatus).toBe("complete")
+    expect(oracle.completeDifference).toBe(1200)
+    expect(metric(await f.read(f.request, f.context))).toMatchObject({ value: 1200, state: "confirmed", unit: "USD" })
+  } finally { f.close() }
+})
