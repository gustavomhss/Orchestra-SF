+  // Read the original admitted save outcome. This never registers a draft and never
+  // guesses from its title, target or position. The host resolves operationIdentity
+  // from the original Idempotency-Key under the same decisions.edit admission.
+  const lookup = async (incoming: { caseRef: CaseRef }, context: TrustedDomainContext): Promise<PortResult<{ draftRef: string; version: number }>> => {
+    try {
+      const request = structuredClone(incoming)
+      const source = input.host.requestFor(context)
+      const operation = input.operationIdentity(context)
+      if (context.kind !== "ui" || !source || !operation || !await input.authorizeLookup?.(request, context) || !await input.host.revalidate(context))
+        return { status: "denied", reason: "hot-topic-draft-outcome-access-unavailable" }
+      const readCase = () => input.state.read(source, "cases", (state, authority) => sameAuthority(authority, context) ? state.cases[request.caseRef.id] : undefined)
+      const readOutcome = () => input.state.read(source, "preferences", (state, authority) => sameAuthority(authority, context)
+        ? state.transactions[JSON.stringify([authority.principalRef, "preferences", request.caseRef.id, `hot-topic-draft:${operation}`])] : undefined)
+      const current = await readCase()
+      if (current.status !== "ok" || !current.value || current.value.incarnation !== request.caseRef.incarnation || current.value.version < request.caseRef.version ||
+        !current.value.participants.includes(context.binding.principalRef) || !await input.authorizeCase(current.value, context))
+        return { status: "denied", reason: "hot-topic-draft-outcome-access-unavailable" }
+      const outcome = await readOutcome()
+      // Missing evidence is not permission to issue a new intent: the first request
+      // could still be in flight or the old installation could lack the record.
+      if (outcome.status !== "ok" || !outcome.value || outcome.value.namespace !== "preferences" || outcome.value.incarnation !== outcome.incarnation ||
+        outcome.value.principalRef !== context.binding.principalRef || outcome.value.targetRef !== request.caseRef.id || outcome.value.targetIncarnation !== request.caseRef.incarnation)
+        return { status: "unavailable", reason: "hot-topic-draft-outcome-unconfirmed" }
+      const saved = outcome.value.value
+      if (!saved || typeof saved !== "object" || Array.isArray(saved) || Object.keys(saved).sort().join(",") !== "draftRef,version" ||
+        !("draftRef" in saved) || typeof saved.draftRef !== "string" || !("version" in saved) || typeof saved.version !== "number" || !Number.isSafeInteger(saved.version))
+        return { status: "unavailable", reason: "hot-topic-draft-outcome-unconfirmed" }
+      const caseRef = { id: current.value.id, incarnation: current.value.incarnation, version: current.value.version }
+      const checked = await readCurrent({ caseRef, draftRef: saved.draftRef }, context)
+      if (checked.status !== "ok" || checked.value.principalRef !== context.binding.principalRef || checked.value.version !== saved.version)
+        return { status: "unavailable", reason: "hot-topic-draft-outcome-unconfirmed" }
+      const again = await readCase()
+      const outcomeAgain = await readOutcome()
+      if (again.status !== "ok" || digestSfValue(again.value) !== digestSfValue(current.value) || outcomeAgain.status !== "ok" ||
+        digestSfValue(outcomeAgain.value) !== digestSfValue(outcome.value) || !await input.authorizeCase(current.value, context) ||
+        !await input.verifySources(checked.value, context) || !await input.authorizeLookup?.(request, context) || source.signal.aborted || !await input.host.revalidate(context))
+        return { status: "unavailable", reason: "hot-topic-draft-outcome-unconfirmed" }
+      return { status: "ok", value: { draftRef: saved.draftRef, version: saved.version } }
+    } catch { return { status: "unavailable", reason: "hot-topic-draft-outcome-unconfirmed" } }
+  }
+  return { register, readCurrent, list, lookup }
 }
 
