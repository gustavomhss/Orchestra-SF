@@ -0,0 +1,246 @@
+import { Schema } from "effect"
+import { NonNegativeInt, PositiveInt, optional } from "../../schema"
+
+/**
+ * A06 source-locked public file shapes. The private product remains the sole
+ * authority for admission, scanner verdicts, version CAS and financial math.
+ * Never import product/runtime sources into the browser contract.
+ */
+export const SfFileSurface = Schema.Literals(["dashboard", "planner", "procurement"])
+export const SfImportSurface = Schema.Literals(["dashboard", "planner"])
+export const SfAssetSurface = Schema.Literals(["dashboard", "procurement"])
+export const SfFilePeriod = Schema.Struct({ start: Schema.String, end: Schema.String })
+export const SfFileFields = Schema.Array(Schema.String)
+export const SfFileDigest = Schema.Struct({
+  algorithm: Schema.Literal("sha256"),
+  value: Schema.String,
+})
+export const SfDocumentRef = Schema.Struct({
+  schema: Schema.Literal("sf-evidence-v1"),
+  kind: Schema.Literal("document"),
+  refId: Schema.String,
+  installationId: Schema.String,
+  projectId: Schema.String,
+  refDigest: Schema.String,
+  evidenceLevel: Schema.Literals(["observed", "claim", "assumption", "proposal", "decision"]),
+  target: Schema.Struct({
+    documentId: Schema.String,
+    incarnation: Schema.String,
+    revision: PositiveInt,
+    blobDigest: SfFileDigest,
+    segment: Schema.Struct({
+      start: NonNegativeInt,
+      end: NonNegativeInt,
+      unit: Schema.Literal("utf16"),
+      textDigest: SfFileDigest,
+    }),
+    ragSourceId: Schema.String.pipe(optional),
+    ragRevisionId: Schema.String.pipe(optional),
+    ragSourceHash: Schema.Struct({ algorithm: Schema.Literal("blake3"), value: Schema.String }).pipe(optional),
+    fieldCandidateId: Schema.String.pipe(optional),
+    confirmationVersion: PositiveInt.pipe(optional),
+  }),
+}).annotate({ identifier: "SfFiles.DocumentRef" })
+export interface SfDocumentRef extends Schema.Schema.Type<typeof SfDocumentRef> {}
+
+export const SfDocumentEvidence = Schema.Struct({
+  id: Schema.String,
+  fileRef: Schema.String,
+  version: PositiveInt,
+  location: Schema.String,
+  textRange: Schema.Struct({ start: NonNegativeInt, end: NonNegativeInt, unit: Schema.Literal("utf16") }),
+  fieldCandidate: Schema.String,
+  value: Schema.Union([Schema.String, Schema.Finite, Schema.Boolean, Schema.Null]),
+  unit: Schema.String.pipe(optional),
+  status: Schema.Literals(["extracted", "confirmed", "rejected", "stale"]),
+  ref: SfDocumentRef,
+}).annotate({ identifier: "SfFiles.DocumentEvidence" })
+export interface SfDocumentEvidence extends Schema.Schema.Type<typeof SfDocumentEvidence> {}
+
+export const SfDocumentField = Schema.Struct({
+  id: Schema.String,
+  type: Schema.Literals(["string", "number", "boolean", "date"]),
+  unit: Schema.String.pipe(optional),
+})
+export const SfDocumentFieldDefinition = Schema.Struct({
+  documentRef: Schema.String,
+  fields: Schema.Array(SfDocumentField),
+  id: Schema.String.pipe(optional),
+  expectedVersion: PositiveInt.pipe(optional),
+})
+export const SfDocumentFieldRecord = Schema.Struct({
+  id: Schema.String,
+  version: PositiveInt,
+  ref: Schema.String,
+  fields: Schema.Array(SfDocumentField),
+})
+export const SfImportPreviewOptions = Schema.Struct({
+  sheet: Schema.String.pipe(optional),
+  replace: Schema.Boolean.pipe(optional),
+  headerRow: PositiveInt.pipe(optional),
+})
+export const SfImportOptions = Schema.Struct({
+  newVersion: Schema.Boolean,
+  removeMissing: Schema.Boolean,
+  preview: SfImportPreviewOptions,
+})
+export const SfImportSourceRef = Schema.Struct({
+  surface: SfFileSurface,
+  type: Schema.String,
+  id: Schema.String,
+  incarnation: Schema.String,
+  version: NonNegativeInt,
+  fields: SfFileFields,
+  period: SfFilePeriod,
+  observedAt: Schema.String,
+})
+export const SfImportContext = Schema.Struct({
+  installationId: Schema.String,
+  projectId: Schema.String,
+  principalRef: Schema.String,
+  accessRevision: Schema.String,
+  policyVersion: Schema.String,
+  surface: SfFileSurface,
+  period: SfFilePeriod,
+  currency: Schema.String,
+  sourceRefs: Schema.Array(SfImportSourceRef),
+  capabilities: Schema.Array(Schema.String),
+})
+export const SfImportProjectionComponent = Schema.Struct({
+  id: Schema.String,
+  amount: Schema.NullOr(Schema.Finite),
+  currency: Schema.String,
+  period: SfFilePeriod,
+  sourceRefs: Schema.Array(SfImportSourceRef),
+  evidenceState: Schema.Literals(["confirmed", "estimated", "hypothetical", "absent"]),
+})
+// Domain projections/decision analysis are maintained by other domain contracts.
+// Their rich nested decisions are opaque to this file adapter: no computation or
+// authorizing decisions from this field is permitted by A06.
+export const SfImportDomainProjection = Schema.Struct({
+  context: SfImportContext,
+  version: NonNegativeInt,
+  engineVersion: Schema.String,
+  components: Schema.Array(SfImportProjectionComponent),
+  values: Schema.Array(Schema.Struct({
+    id: Schema.String,
+    value: Schema.Union([Schema.String, Schema.Finite, Schema.Boolean, Schema.Null]),
+    unit: Schema.String.pipe(optional),
+    currency: Schema.String.pipe(optional),
+    period: SfFilePeriod,
+    granularity: Schema.Literals(["record", "month", "year", "aggregate"]),
+    sourceRefs: Schema.Array(Schema.Json),
+    drilldown: Schema.NullOr(Schema.Json),
+    evidenceState: Schema.Literals(["confirmed", "estimated", "hypothetical", "absent"]),
+  })),
+  missing: Schema.Array(Schema.Struct({
+    field: Schema.String,
+    reason: Schema.Literals(["missing","unavailable","restricted","not-applicable","incompatible-currency","missing-fx","missing-rate","unconfirmed"]),
+  })),
+  comparison: Schema.Json.pipe(optional),
+  decision: Schema.Json.pipe(optional),
+})
+export const SfImportReceipt = Schema.Struct({
+  id: Schema.String,
+  idempotencyKey: Schema.String,
+  commandDigest: Schema.String,
+  targetIncarnation: Schema.String,
+  principalRef: Schema.String,
+  surface: SfFileSurface,
+  version: NonNegativeInt,
+  at: Schema.String,
+  status: Schema.Literals(["applied", "awaiting-approval", "conflict", "failed", "cancelled"]),
+  resultRef: Schema.String.pipe(optional),
+  errors: Schema.Array(Schema.String),
+})
+export const SfImportManifest = Schema.Struct({
+  id: Schema.String,
+  version: PositiveInt,
+  sourceDigest: Schema.String,
+  format: Schema.String,
+  context: SfImportContext,
+  baseIdentity: Schema.Array(SfImportSourceRef),
+  commands: Schema.Array(Schema.Struct({
+    id: Schema.String,
+    target: SfImportSourceRef,
+    idempotencyKey: Schema.String,
+    commandDigest: Schema.String,
+    expectedVersion: NonNegativeInt,
+    requiredAuthority: Schema.Array(Schema.String),
+    preview: SfImportDomainProjection,
+    action: Schema.String,
+    operationRef: Schema.String,
+    receiptRef: Schema.String.pipe(optional),
+  })),
+  issues: Schema.Array(Schema.Struct({ row: PositiveInt, field: Schema.String, reason: Schema.String })),
+  state: Schema.Literals(["preview", "stale", "blocked", "applied"]),
+  domainApplied: Schema.Boolean,
+  receipts: Schema.Array(SfImportReceipt),
+}).annotate({ identifier: "SfFiles.ImportManifest" })
+
+export const SfImportDetail = Schema.Struct({
+  manifestId: Schema.String,
+  version: PositiveInt,
+  sourceDigest: Schema.String,
+  changes: Schema.Array(Schema.Struct({
+    path: Schema.String,
+    kind: Schema.Literals(["added", "changed", "removed", "unchanged", "ignored", "rejected"]),
+    before: Schema.Union([
+      Schema.Struct({ state: Schema.Literals(["absent", "undefined"]) }),
+      Schema.Struct({ state: Schema.Literal("present"), value: Schema.Json }),
+    ]),
+    after: Schema.Union([
+      Schema.Struct({ state: Schema.Literals(["absent", "undefined"]) }),
+      Schema.Struct({ state: Schema.Literal("present"), value: Schema.Json }),
+    ]),
+    source: Schema.Union([
+      Schema.Struct({
+        kind: Schema.Literal("file"),
+        sheet: Schema.String,
+        row: PositiveInt,
+        column: PositiveInt,
+        address: Schema.String,
+        field: Schema.String,
+      }),
+      Schema.Struct({ kind: Schema.Literal("domain"), reference: Schema.String }),
+    ]),
+    reason: Schema.String.pipe(optional),
+  })),
+})
+export const SfImportReceiptSummary = Schema.Struct({
+  receiptId: Schema.String,
+  manifestId: Schema.String,
+  idempotencyKey: Schema.String,
+  commandDigest: Schema.String,
+  outcome: Schema.Literals(["applied", "unchanged", "rejected"]),
+  changedFields: NonNegativeInt,
+})
+export const SfFilesFailure = Schema.Struct({
+  status: Schema.Literals(["denied", "unavailable", "stale", "conflict", "needs-input", "invalid", "provider-conflict", "failed"]),
+  reason: Schema.String.pipe(optional),
+})
+export const SfFilesLegacyFailure = Schema.Struct({
+  ok: Schema.Literal(false),
+  status: Schema.Int,
+  errors: Schema.Array(Schema.String).pipe(optional),
+})
+export const SfFilesPortResult = <S extends Schema.Top>(value: S) => Schema.Union([
+  Schema.Struct({ status: Schema.Literal("ok"), value }),
+  SfFilesFailure,
+])
+
+export const SfImportReadReference = Schema.Struct({
+  manifest: SfImportManifest,
+  detail: SfImportDetail,
+  digest: Schema.String,
+  receipt: SfImportReceiptSummary.pipe(optional),
+})
+export const SfImportReadDetail = Schema.Struct({
+  digest: Schema.String,
+  detail: SfImportDetail,
+  receipt: SfImportReceiptSummary.pipe(optional),
+})
+
+export const SfFilesDownloadBytes = Schema.Uint8ArrayFromSelf.annotate({ identifier: "SfFiles.DownloadBytes" })
+/** Bytes are never represented as JSON, a local pathname, a detached link or a fake clean-scan status. */
+export const SfFilesUploadBytes = Schema.Uint8ArrayFromSelf.annotate({ identifier: "SfFiles.UploadBytes" })

diff --git a/modules/sucafina/Sucafinav1/test/native-ui-contract/files.test.ts b/modules/sucafina/Sucafinav1/test/native-ui-contract/files.test.ts
new file mode 100644
index 0000000..1c4d58aaf184a277ca2dd04b263ce0ad500a66d6
--- /dev/null
+++ b/modules/sucafina/Sucafinav1/test/native-ui-contract/files.test.ts
@@ -0,0 +1,156 @@
+import { describe, expect, test } from "bun:test"
+import { SfFiles } from "@orchestra/schema/sucafina/files"
+import type { SfTransport } from "@orchestra/client/sucafina/transport"
+import { createSfFilesClient, readSfFilesSignedAssetQuery } from "@orchestra/client/sucafina/files"
+import { createSfFilesHostBindings } from "../../../../../apps/cli/src/sucafina-product/native-ui/files"
+
+const uuid = "123e4567-e89b-42d3-a456-426614174000"
+function fixture() {
+  const operations: string[] = []
+  const transport: SfTransport = {
+    async execute(operation) {
+      operations.push(operation.operationId)
+      return { kind: "transport-error", reason: "contract-unavailable" }
+    },
+  }
+  return { operations, client: createSfFilesClient(transport) }
+}
+const options = () => ({ signal: new AbortController().signal, idempotencyKey: uuid })
+
+describe("A06 source-bound files contracts (component-only; NOT installed E2E)", () => {
+  test("each of 25 catalogued operation names is literal and unique", () => {
+    const ids = Object.keys(SfFiles.operations)
+    expect(ids).toHaveLength(25)
+    expect(new Set(ids).size).toBe(25)
+    expect(ids.every((id) => id.startsWith("files."))).toBe(true)
+    for (const id of ids) {
+      expect(SfFiles.operations[id as keyof typeof SfFiles.operations].operationId).toBe(id)
+    }
+  })
+
+  test("import upload is staged only via existing producer, and scanner failure is never inferred clean", async () => {
+    const { client, operations } = fixture()
+    const result = await client["files.import-admit"]({
+      surface: "planner", selectionRef: "selection-1",
+      options: { newVersion: false, removeMissing: false, preview: {} },
+      fileName: "budget.xlsx", mediaType: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+      bytes: new Uint8Array([1, 2, 3]),
+    }, options())
+    expect(result).toEqual({ kind: "transport-error", reason: "contract-unavailable" })
+    expect(operations).toEqual(["files.import-admit"])
+  })
+
+  test("invalid binary, extension, options and missing idempotency do not reach transport", async () => {
+    const { client, operations } = fixture()
+    const base = {
+      surface: "planner" as const, selectionRef: "selection-1",
+      options: { newVersion: false, removeMissing: false, preview: {} },
+      fileName: "budget.xlsx", mediaType: "application/octet-stream",
+      bytes: new Uint8Array([1]),
+    }
+    const invalid = [
+      { ...base, bytes: new Uint8Array() },
+      { ...base, fileName: "budget.exe" },
+      { ...base, options: { ...base.options, ownerOverride: true } },
+      { ...base, bytes: new Uint8Array(16 * 1024 * 1024 + 1) },
+    ]
+    for (const input of invalid) {
+      const result = await client["files.import-admit"](input as never, options())
+      expect(result).toEqual({ kind: "transport-error", reason: "contract-mismatch" })
+    }
+    expect(await client["files.import-admit"](base, {
+      signal: new AbortController().signal,
+    })).toEqual({ kind: "transport-error", reason: "contract-mismatch" })
+    expect(operations).toEqual([])
+  })
+
+  test("preview/apply are distinct, and prepare does not invent an apply receipt", async () => {
+    const { client, operations } = fixture()
+    await client["files.import-preview"]({
+      surface: "planner", admittedFileRef: "staged-ref", format: "xlsx", options: {},
+    }, options())
+    await client["files.import-apply"]({
+      surface: "planner", manifestId: "manifest-1", version: 1,
+    }, options())
+    expect(operations).toEqual(["files.import-preview", "files.import-apply"])
+  })
+
+  test("an incomplete or inverted period is not dispatched", async () => {
+    const { client, operations } = fixture()
+    const signals = options()
+    expect(await client["files.import-targets"]({
+      surface: "planner", start: "2026-11-01",
+    }, signals)).toEqual({ kind: "transport-error", reason: "contract-mismatch" })
+    expect(await client["files.import-targets"]({
+      surface: "planner", start: "2026-12-01", end: "2026-11-01",
+    }, signals)).toEqual({ kind: "transport-error", reason: "contract-mismatch" })
+    expect(operations).toEqual([])
+  })
+
+  test("document extraction cannot be confirmed with a pending/partial response", async () => {
+    const { client, operations } = fixture()
+    const fake = { id: "candidate-1", status: "stale" }
+    const result = await client["files.document-confirm"]({
+      surface: "dashboard", evidence: fake as never,
+    }, options())
+    expect(result).toEqual({ kind: "transport-error", reason: "contract-mismatch" })
+    expect(operations).toEqual([])
+  })
+
+  test("document schema validation preserves version CAS and disallows duplicate field IDs", async () => {
+    const { client, operations } = fixture()
+    const input = {
+      surface: "dashboard" as const, documentRef: "doc-1",
+      fields: [{ id: "amount", type: "number" as const }, { id: "amount", type: "number" as const }],
+    }
+    expect(await client["files.document-schema"](input, options())).toEqual({
+      kind: "transport-error", reason: "contract-mismatch",
+    })
+    expect(operations).toEqual([])
+  })
+
+  test("assets carry raw bytes to original server, never a local scanner flag or path", async () => {
+    const { client, operations } = fixture()
+    const mismatched = {
+      surface: "dashboard" as const, upload: "supplier" as const,
+      record: "supplier-1", recordVersion: 0,
+      name: "supplier.pdf", page: "Vendor Contracts",
+      mediaType: "application/pdf", bytes: new Uint8Array([10]),
+    }
+    expect(await client["files.asset.upload"](mismatched, options())).toEqual({
+      kind: "transport-error", reason: "contract-mismatch",
+    })
+    expect(operations).toEqual([])
+  })
+
+  test("signed asset query parsing accepts only exactly one of each server field", () => {
+    const signature = "a".repeat(64)
+    const good = "asset=record42&expires=1797000000000&signature=" + signature
+    expect(readSfFilesSignedAssetQuery(good)).toEqual({
+      assetId: "record42", expires: 1797000000000, signature,
+    })
+    expect(readSfFilesSignedAssetQuery(good + "&asset=attacker")).toBeUndefined()
+    expect(readSfFilesSignedAssetQuery(good + "&url=https://evil.invalid")).toBeUndefined()
+    expect(readSfFilesSignedAssetQuery("?" + good)).toBeUndefined()
+    expect(readSfFilesSignedAssetQuery("asset=r&expires=0&signature=" + signature)).toBeUndefined()
+  })
+
+  test("server-only delegates preserve original Response including streamed bytes and refusal", async () => {
+    const denial = Response.json({ status: "denied" }, { status: 403 })
+    const bytes = new Response(new Uint8Array([12, 13]), {
+      status: 200, headers: { "Content-Type": "application/octet-stream" },
+    })
+    const bindings = createSfFilesHostBindings({
+      documents: async () => denial,
+      application: async () => bytes,
+    })
+    const req = new Request("https://installation.invalid/sf/dashboard?sf=document-open")
+    const denied = await bindings["files.document-open"](req, "dashboard")
+    expect(denied).toBe(denial)
+    expect(denied.status).toBe(403)
+    const downloaded = await bindings["files.asset.download"](req, "dashboard")
+    expect(downloaded).toBe(bytes)
+    expect(downloaded.headers.get("content-type")).toBe("application/octet-stream")
+    expect(await bindings["files.import-admit"](req, "planner")).toHaveProperty("status", 503)
+  })
+})

