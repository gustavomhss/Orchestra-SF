  "static_boundary_observations": [
    {
      "id": "manifest-policy-and-bytes",
      "sources": [
        "modules/sucafina/Sucafinav1/product/ai/resident.ts"
      ],
      "observation": "createResidentAiBundle requires the full 5/18 catalog unless the exact Finance probe shape is selected; rejects duplicate IDs, unknown profiles/skills, missing source/schema/routes and policy differences. Realpath containment covers manifest and source bytes. Profiles match normative definitions and their complete JSON definitions; skill source and parsed instruction digests are verified before native registration."
    },
    {
      "id": "portfolio-output-alignment",
      "sources": [
        "modules/sucafina/Sucafinav1/product/ai/profiles/sf_portfolio.json",
        "modules/sucafina/Sucafinav1/product/ai/skills/sf-compor-portfolio/SKILL.md",
        "modules/sucafina/Sucafinav1/product/ai/manifests/resident.json",
        "modules/sucafina/Sucafinav1/product/contracts/normative-contracts.json"
      ],
      "observation": "Current profile outputTypes and sf-compor-portfolio outputSchemaRefs both include PortfolioComparison and AlternativeDraft, matching the published shared contract. The older immutable plan primary lists did not enumerate AlternativeDraft here; the current published additive contract and explicit user direction to preserve it are recorded separately. No approved plan was edited. The skill permits AlternativeDraft only from real sf_alternative_draft and forbids applying or approving it. This adds a typed proposed output, not a new operation or domain authority."
    },
    {
      "id": "watch-effective-grant",
      "sources": [
        "modules/sucafina/Sucafinav1/product/ai/resident.ts",
        "apps/cli/src/sucafina-product/host-context.ts",
        "modules/sucafina/Sucafinav1/product/host-binding/resident-agents.ts",
        "modules/sucafina/Sucafinav1/product/host-binding/execution-context.ts"
      ],
      "observation": "sf_maestro retains sf_watch_prepare only in its normative permission ceiling. None of its distributed allowed skills grants the operation, so both bundle selection and actual host selection exclude it. sf_portfolio/sf-reavaliar-compromissos remains the named allowed route. registerSfResidentAgents installs deny-* plus only selected skill resources and selected operations; native lease requires selected scope, profile ceiling, a loaded skill receipt and normative skill grant."
    },
    {
      "id": "native-session-loading",
      "sources": [
        "apps/cli/src/sucafina-product/contribution.ts",
        "apps/cli/src/sucafina-product/native-host.ts",
        "modules/sucafina/Sucafinav1/product/host-binding/resident-agents.ts",
        "modules/sucafina/Sucafinav1/product/host-binding/skill-loader.ts"
      ],
      "observation": "Actual host contribution registers in the owning Location after config-agent, reserves the distributed source and retains an opaque source capability. Native host resolves an existing configured model, creates a fresh Session, calls loadSfSkill and narrows the Session before binding or prompt execution. loadSfSkill observes the uniquely added SessionV2.skill synthetic message, checks content/path and source bytes before and after load, and returns SkillLoadReceipt tied to run/session/profile/manifest/source."
    },
    {
      "id": "revocation-and-receipt-binding",
      "sources": [
        "modules/sucafina/Sucafinav1/product/host-binding/resident-agents.ts",
        "modules/sucafina/Sucafinav1/product/host-binding/skill-loader.ts",
        "modules/sucafina/Sucafinav1/product/host-binding/execution-context.ts",
        "apps/cli/src/sucafina-product/host-context.ts"
      ],
      "observation": "Source capability identity is Location-bound and revoked on scope finalization. Altered grants do not match its cloned registered selections. Native bindings clone/freeze admissions, bind the observed message and current source bytes, reject duplicate native Sessions and revalidate authority at call boundaries. Metadata-only declarations do not supply the private capability or observed receipt."
    },
    {
      "id": "probe-remains-partial",
      "sources": [
        "modules/sucafina/Sucafinav1/product/ai/manifests/native-probe.json",
        "modules/sucafina/Sucafinav1/product/ai/resident.ts"
      ],
      "observation": "native-probe advertises only sf_finance, sf-explicar-forecast and the sf_forecast_compare route. Its richer profile ceiling and skill definition do not grant absent pack operations. Actual createSfHostRuntime explicitly reads manifests/resident.json."
    }
  ],
