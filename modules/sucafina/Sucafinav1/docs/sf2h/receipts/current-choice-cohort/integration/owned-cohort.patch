+    expect(digestSfValue(decision.choices[0])).toBe(digestSfValue(fixture.choice))
+    expect(decision.alternatives[0]!.version).toBe(2)
+    expect(decision.alternatives[0]!.scenario).toEqual(fixture.promotion.scenario)
