+      { id: "covered-zero", name: "Explicit zero contract exit, internal and other relevant costs", amount: 0 },
+      ...(training === "omitted" ? [] : [{ id: "training", name: "Separately priced training", amount: training === "confirmed" ? 40000 : training === "zero" ? 0 : null }])],
+  ]
+  const monthly = (amount: number | null) => Array.from({ length: 12 }, (_, month) => month === 10 ? amount : 0)
+  await persistence.transaction("planner", async (snapshot) => {
+    snapshot.data.versions = rows.map((lines, index) => ({ id: `installed-training-${index}-${training}`,
+      name: index ? `Transition: training ${training}` : "Renewal quote", year: 2027, closed: 0,
+      lines: lines.map((line) => ({ id: line.id, name: line.name, sec: "opex", el: "licenses", cur: "USD",
+        b: monthly(line.amount), a: Array(12).fill(null), f: monthly(line.amount) })),
+      fx: [], hc: { positions: [], rates: [], hrAF: {} }, projects: [], lists: {} }))
+    return { commit: true, value: undefined }
+  })
+  await persistence.transaction("procurement", async (snapshot) => {
+    snapshot.data.store = { requests: {}, suppliers: [], settings: { currency: "USD" } }
+    return { commit: true, value: undefined }
+  })
+  await persistence.initializeSources("planner")
+  const call = await fixture.read()
+  deadline.own(() => authority.ui.finish(call))
+  const sources: BaselineCoverageRequest["source"][] = []
+  const forecasts: Awaited<ReturnType<typeof business.planner.compareForecast>>[] = []
+  for (const index of [0, 1]) {
+    const issued = ok(await deadline.phase(`source.${index}`, () => business.plannerProduct.issueSource(`installed-training-${index}-${training}`, call)), "Issue training source")
+    sources.push(issued.evidence)
+    forecasts.push(await deadline.phase(`forecast.${index}`, () => business.planner.compareForecast({
+      baseRef: issued.evidence.refId, candidateRef: issued.evidence.refId, period: trainingHorizon, currency: "USD",
+    }, call)))
+  }
+  const initialRef = { id: "installed-training-case", incarnation: `installed-training-${training}`, version: 1 }
+  const basis: BaselineCoverageRequest["basis"] = { id: "installed-training-renewal", version: 1, decisionType: "renewal-transition-v1",
+    categoryIds: [...RENEWAL_TRANSITION_CATEGORIES], additionalCategoryIds: [], sourceRefs: sources }
+  const initial: DecisionCase = { ...initialRef, state: "draft", objective: "Compare declared renewal and transition quotes", horizon: trainingHorizon, currency: "USD",
+    criteria: [{ id: "minimum-known-advantage", description: "Known transition cost must remain at least 20000 USD below renewal", required: true }], participants: ["person"], sourceRefs: sources, alternatives: [], costCoverageBases: [basis], assumptions: [], questions: [], choices: [], preparedChanges: [], receipts: [], ledger: [] }
+  const seeded = await authority.state.transaction(fixture.request("training-empty-case"), { namespace: "cases", expectedStorageVersion: 0,
+    targetRef: authority.creationTarget.ref, targetIncarnation: authority.creationTarget.incarnation,
+    idempotencyKey: "training-empty-case", commandDigest: digestSfValue(initial) }, async (state) => {
+    state.cases[initial.id] = initial
+    return { commit: true, value: true }
+  })
+  if (seeded.status !== "ok") throw new Error(`Empty training case: ${JSON.stringify(seeded)}`)
+  const coverageRequests: BaselineCoverageRequest[] = []
+  const coverageRefs: string[] = []
+  for (const [index, source] of sources.entries()) {
+    const forecast = ok(forecasts[index]!, "Training source forecast")
+    const componentRefs = (line: string) => forecast.baseline.components.filter((component) => component.id.startsWith(`${line}:`)).map((component) => component.id)
+    const entries = RENEWAL_TRANSITION_CATEGORIES.flatMap((categoryId): CostCoverageEntry[] => {
+      if (index === 1 && categoryId === "training" && training === "omitted") return []
+      if (index === 1 && categoryId === "training" && training === "null")
+        return [{ categoryId, status: "pending", reason: "missing-value-and-evidence" }]
+      const line = index === 0 ? categoryId === "service" || categoryId === "taxes" ? "renewal" : "covered-zero"
+        : categoryId === "service" ? "new-service" : categoryId === "service_overlap" ? "bridge"
+          : categoryId === "implementation" || categoryId === "migration" ? "implementation"
+            : categoryId === "training" ? "training" : "covered-zero"
+      return [{ categoryId, status: "included", componentRefs: categoryId === "taxes" && index === 1
+        ? forecast.baseline.components.filter((component) => training !== "null" || !component.id.startsWith("training:")).map((component) => component.id)
+        : componentRefs(line), evidenceRefs: [source],
+        scopeNote: categoryId === "taxes" ? "All supplied prices are final including taxes; no second monetary contribution"
+          : categoryId === "migration" && index === 1 ? "Migration shares the implementation component, whose price excludes training"
+            : line === "covered-zero" ? "The separate source quote explicitly confirms zero additional charges for this category"
+              : `Human classification of the explicit ${line} quote` }]
+    })
+    const coverage: BaselineCoverageRequest = { caseRef: initialRef, source, basis, expectedVersion: 0, entries }
+    coverageRequests.push(coverage)
+    const human = ok(await authority.human.admit(fixture.request(`training-coverage-${index}`), "decisions.coverage", coverage), "Admit training coverage")
+    try {
+      const registered = ok(await deadline.phase(`coverage.${index}`, () => business.withCase(human, initialRef, {}, () =>
+        business.baselineCoverage.register(coverage, human))), "Register training coverage")
+      coverageRefs.push(registered.coverageRef)
+    } finally { authority.human.finish(human) }
+  }
+  const scenarios: ScenarioRequest[] = sources.map((source) => ({ baseRef: source.refId, operations: [], assumptions: [] }))
+  const mutationHttp = portfolio.http({ origin: "https://example.test", mount: "/product" })
+  const promote = async (index: number, caseRef: typeof initialRef) => {
+    const payload = { caseRef, title: index ? `Transition with ${training} training` : "Renewal", scenario: scenarios[index]!, coverageRef: coverageRefs[index]! }
+    const response = await deadline.phase(`promotion.${index}`, () => mutationHttp(new Request("https://example.test/product/planner?sf=decision-promote", {
+      method: "POST", signal: deadline.signal, headers: { origin: "https://example.test", "content-type": "application/json", "x-operation": `training-promote-${index}` }, body: JSON.stringify(payload),
+    }), "planner"))
+    if (response?.status !== 200) throw new Error(`Training promotion ${index}: ${response?.status} ${response ? await response.text() : "no response"}`)
+    const receipt = ok(await response.json() as PortResult<{ caseRef: typeof initialRef; resultRef?: string }>, "Persist training scenario")
+    if (!receipt.resultRef) throw new Error("Training promotion did not persist its scenario")
+    return { caseRef: receipt.caseRef, resultRef: receipt.resultRef }
+  }
+  const baseline = await promote(0, initialRef)
+  const candidate = await promote(1, baseline.caseRef)
+  const snapshot = await authority.state.read(fixture.request(), "cases", (state) => state.cases[initialRef.id])
+  if (snapshot.status !== "ok" || !snapshot.value || snapshot.value.alternatives.length !== 2) throw new Error("Training alternatives unavailable")
+  const caseValue = snapshot.value
+  const registerRule = async (caseRef = candidate.caseRef, evidenceRefs: BaselineCoverageRequest["basis"]["sourceRefs"] = sources, expectedRuleVersion = 0) => {
+    const rule = { caseRef, criterionId: "minimum-known-advantage", metricRef: "planner:known-subtotal-difference", operator: "lte" as const,
+      value: -20000, unit: "USD", period: trainingHorizon, evidenceRefs, expectedRuleVersion }
+    const human = ok(await authority.human.admit(fixture.request(`training-minimum-rule-${caseRef.version}`), "decisions.criteria", rule), "Admit minimum advantage rule")
+    try { return ok(await deadline.phase("criterion.register", () => business.withCase(human, caseRef, {}, () => portfolio.rules.register(rule, human))), "Register minimum advantage rule") }
+    finally { authority.human.finish(human) }
+  }
+  return { ...fixture, call, sources, basis, coverageRequests, coverageRefs, scenarios, caseRef: candidate.caseRef, caseValue,
+    baseline, candidate, mutationHttp, registerRule }
+}
+
+/** Enter a later raw quote through Planner's copy/save commands. Keep the old
+ * source intact; coverage and alternative revisions go through human APIs. */
+export async function resolveTrainingAfterChoice(fixture: Awaited<ReturnType<typeof trainingHistoryFixture>>,
+  deadline: ReturnType<typeof compositionTestDeadline>, caseRef: BaselineCoverageRequest["caseRef"]) {
+  if (fixture.caseValue.alternatives[1]!.result.components.some((component) => component.id.startsWith("training:")))
+    throw new Error("History revision requires genuinely omitted training")
+  const original = fixture.sources[1]!
+  const transport = fixture.request("training-confirmed-quote")
+  const environment = await fixture.authority.host.environment(transport)
+  const versionId = await deadline.phase("source.copy-and-confirm-training", () => fixture.persistence.transaction("planner", async (snapshot) => {
+    const principal = await fixture.authority.host.authenticate(transport, { surface: "planner", roleMap: roleMap(snapshot, "planner") })
+    const actor = plannerSourceActor(snapshot, principal, "person")
+    if (!actor) throw new Error("Authenticated quote author unavailable")
+    const before = projectPlannerSource(snapshot, actor, original.target.recordId)
+    if (!before) throw new Error("Original quote unavailable")
+    const copied = domain.execute(snapshot, actor, { page: "Versions", action: "copy", id: original.target.recordId,
+      version: snapshot.versions[`versions:${original.target.recordId}`]?.version ?? 0, values: { name: "Transition with separately confirmed training" } }, environment)
+    if (!copied.ok || typeof copied.value !== "string") throw new Error(`Planner quote copy rejected: ${JSON.stringify(copied)}`)
+    const values = { versionId: copied.value, el: "licenses", cur: "USD", annual: 0,
+      f0: 0, f1: 0, f2: 0, f3: 0, f4: 0, f5: 0, f6: 0, f7: 0, f8: 0, f9: 0, f10: 40000, f11: 0 }
+    const saved = domain.execute(snapshot, actor, { page: "OPEX", action: "save", id: "training",
+      version: snapshot.versions[`${copied.value}:lines:training`]?.version ?? 0, values }, environment)
+    if (!saved.ok) throw new Error(`Planner training quote rejected: ${JSON.stringify(saved)}`)
+    if (digestSfValue(projectPlannerSource(snapshot, actor, original.target.recordId)) !== digestSfValue(before))
+      throw new Error("Training quote revision modified the original source")
+    return { commit: true, value: copied.value }
+  }))
+  const source = ok(await deadline.phase("source.issue-training-revision", () => fixture.business.plannerProduct.issueSource(versionId, fixture.call)), "Issue revised actual source").evidence
+  const basis: BaselineCoverageRequest["basis"] = { ...fixture.basis, version: fixture.basis.version + 1, sourceRefs: [...fixture.sources, source] }
+  const forecast = ok(await deadline.phase("forecast.training-revision", () => fixture.business.withCase(fixture.call, caseRef, {}, () =>
+    fixture.business.planner.compareForecast({ baseRef: source.refId, candidateRef: source.refId, period: trainingHorizon, currency: "USD" }, fixture.call))), "Project revised training source")
+  const trainingRefs = forecast.candidate.components.filter((component) => component.id.startsWith("training:")).map((component) => component.id)
+  if (trainingRefs.length !== 12) throw new Error("Revised quote did not supply its annual training components")
+  const candidateEntries: CostCoverageEntry[] = fixture.coverageRequests[1]!.entries.map((entry) => entry.status === "included"
+    ? { ...entry, evidenceRefs: [source], componentRefs: entry.categoryId === "taxes" ? [...entry.componentRefs, ...trainingRefs] : entry.componentRefs }
+    : entry)
+  candidateEntries.push({ categoryId: "training", status: "included", componentRefs: trainingRefs, evidenceRefs: [source],
+    scopeNote: "The later separate quote confirms 40000 in November and zero training charges in the other months" })
+  const requests: BaselineCoverageRequest[] = [
+    { ...fixture.coverageRequests[0]!, caseRef, basis, expectedVersion: 1 },
+    { caseRef, source, basis, entries: candidateEntries, expectedVersion: 0 },
+  ]
+  const coverageRefs: string[] = []
+  for (const [index, request] of requests.entries()) {
+    const human = ok(await fixture.authority.human.admit(fixture.request(`history-coverage-revision-${index}`), "decisions.coverage", request), "Admit revised coverage")
+    try {
+      coverageRefs.push(ok(await deadline.phase(`coverage.revision.${index}`, () => fixture.business.withCase(human, caseRef, {}, () =>
+        fixture.business.baselineCoverage.register(request, human))), "Register revised coverage").coverageRef)
+    } finally { fixture.authority.human.finish(human) }
+  }
+  let current = caseRef
+  const promoted: { caseRef: typeof caseRef; resultRef: string }[] = []
+  for (const index of [0, 1]) {
+    const alternative = fixture.caseValue.alternatives[index]!
+    const scenario: ScenarioRequest = index === 0 ? alternative.scenario : { baseRef: source.refId, operations: [], assumptions: [] }
+    const request = { caseRef: current, title: alternative.title, scenario, coverageRef: coverageRefs[index]!,
+      alternativeRef: { id: alternative.id, version: alternative.version } }
+    const response = await deadline.phase(`promotion.revision.${index}`, () => fixture.mutationHttp(new Request("https://example.test/product/planner?sf=decision-promote", {
+      method: "POST", signal: deadline.signal, headers: { origin: "https://example.test", "content-type": "application/json", "x-operation": `history-promote-revision-${index}` }, body: JSON.stringify(request),
+    }), "planner"))
+    if (response?.status !== 200) throw new Error(`History revision ${index}: ${response?.status} ${response ? await response.text() : "no response"}`)
+    const receipt = ok(await response.json() as PortResult<{ caseRef: typeof caseRef; resultRef?: string }>, "Persist revised alternative")
+    if (!receipt.resultRef) throw new Error("Revised alternative was not persisted")
+    current = receipt.caseRef
+    promoted.push({ caseRef: receipt.caseRef, resultRef: receipt.resultRef })
+  }
+  return { caseRef: current, baseline: promoted[0]!, candidate: promoted[1]!, source, basis, forecast: forecast.candidate }
+}
