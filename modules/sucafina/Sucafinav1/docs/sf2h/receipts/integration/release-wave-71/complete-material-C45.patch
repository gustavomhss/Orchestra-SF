+function frozenSourcing(approved = 28000 * 1.08) {
+  return snapshot({
+    status: "src_pending",
+    pr: { title: "Synthetic EUR sourcing", estAmount: 28000, recurring: false, expenseType: "OPEX" },
+    sourcing: {
+      selectedId: "quote73", approvalBaseCurrency: "USD", fxSnapshot: { USD: 1, EUR: 1.08 },
