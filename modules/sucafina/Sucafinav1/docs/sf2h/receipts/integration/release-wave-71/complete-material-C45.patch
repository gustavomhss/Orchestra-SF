+        lines: [{ id: "foreign", name: "Quoted EUR service", sec: "opex", el: "licenses", cur: "EUR", b: amount, a: Array(12).fill(null), f: amount }],
+        fx: [{ cur: "EUR", rate }], hc: { positions: [], rates: [], hrAF: {} }, projects: [], lists: {} }))
