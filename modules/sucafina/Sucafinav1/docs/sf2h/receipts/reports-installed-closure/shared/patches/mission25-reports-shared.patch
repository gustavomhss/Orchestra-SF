+    checkAtCommit: (recipient, basis, call) => {
+      const lease = recipientLeases.get(call)?.get(recipientKey(recipient, basis, call))
+      if (!lease || !lease.access.check()) return false
+      if (recipient === call.binding.principalRef) return true
