# FLAMENGO demo: paths only; install privately as root:root 0600 after review.
SF_FQDN=orchsf-spug5rxxyqkdw.swedencentral.cloudapp.azure.com
SUCAFINA_MICROSOFT_CONFIG=/var/lib/orchestra-sf/home/flamengo-config/installation.json
ORCHESTRA_CONFIG_DIR=/var/lib/orchestra-sf/home/flamengo-config/host-config
ORCHESTRA_DB=/var/lib/orchestra-sf/home/flamengo-config/host-data/orchestra.db
ORCHESTRA_CREDENTIAL_KEY_FILE=/var/lib/orchestra-sf/home/flamengo-config/host-credential.key
ORCHESTRA_INHERIT_CREDENTIALS=0
ORCHESTRA_DISABLE_PROJECT_CONFIG=1
ORCHESTRA_EXPERIMENTAL_DISABLE_FILEWATCHER=true
XDG_DATA_HOME=/var/lib/orchestra-sf/home/flamengo-config/host-data
XDG_CONFIG_HOME=/var/lib/orchestra-sf/home/flamengo-config/host-config
XDG_CACHE_HOME=/var/lib/orchestra-sf/home/flamengo-config/host-cache
XDG_STATE_HOME=/var/lib/orchestra-sf/home/flamengo-config/host-state
TMPDIR=/var/lib/orchestra-sf/home/flamengo-config/host-tmp
