[Unit]
Description=Orchestra-SF Linux x64 factory and Web (managed identity)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/orchestra-sf
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=orchestra-sf
Group=orchestra-sf
WorkingDirectory=/var/lib/orchestra-sf/home
EnvironmentFile=/etc/orchestra-sf/runtime.env
Environment=HOME=/var/lib/orchestra-sf/home
Environment=ORCHESTRA_WEB_UI_DIR=/opt/orchestra-sf/current/bin/web
UMask=0077
# '+' applies root privileges ONLY to the prestart secret materializer.
ExecStartPre=+/usr/local/libexec/orchestra-sf/materialize-entra-secret.sh
ExecStart=/opt/orchestra-sf/current/bin/orchestra serve --hostname 127.0.0.1 --port 4096 --allowed-host ${SF_FQDN} --installation /opt/orchestra-sf/current/bin/local/entry.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/orchestra-sf

[Install]
WantedBy=multi-user.target
