[Unit]
Description=Orchestra-SF Sucafina service (Microsoft Entra)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/orchestra-sf
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=orchestra-sf
Group=orchestra-sf
WorkingDirectory=/var/lib/orchestra-sf/home
EnvironmentFile=/etc/orchestra-sf/runtime.env
Environment=HOME=/var/lib/orchestra-sf/home
UMask=0077
ExecStart=/opt/orchestra-sf/current/bin/orchestra serve --hostname 127.0.0.1 --port 4096 --installation /opt/orchestra-sf/current/bin/local/entry.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/orchestra-sf

[Install]
WantedBy=multi-user.target
