# managed-orchestra-sf-mode: proxy
# Render __SF_FQDN__ with approved public HTTPS hostname.
__SF_FQDN__ {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000"
    }
    # No handle_path, rewrite, strip_prefix or URI manipulation.
    # /sucafina/* and built Web assets reach the same native CLI.
    reverse_proxy 127.0.0.1:4096 {
        header_up Host {host}
        header_up -Forwarded
    }
}
