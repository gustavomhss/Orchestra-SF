# COPY ONLY AFTER A8 PROVIDES THE REAL CONFIG. No secret values here.
# On VM: /etc/orchestra-sf/runtime.env, root:root 0600.
SF_FQDN=REQUIRES_PUBLIC_FQDN
SUCAFINA_MICROSOFT_CONFIG=/var/lib/orchestra-sf/home/REQUIRES_PRIVATE_CONFIG_DIR/installation.json
ORCHESTRA_CONFIG_DIR=/var/lib/orchestra-sf/home/REQUIRES_PRIVATE_CONFIG_DIR/host-config
ORCHESTRA_DB=/var/lib/orchestra-sf/home/REQUIRES_PRIVATE_CONFIG_DIR/host-data/orchestra.db
ORCHESTRA_CREDENTIAL_KEY_FILE=/var/lib/orchestra-sf/home/REQUIRES_PRIVATE_CONFIG_DIR/host-credential.key
ORCHESTRA_INHERIT_CREDENTIALS=0
ORCHESTRA_DISABLE_PROJECT_CONFIG=1
ORCHESTRA_EXPERIMENTAL_DISABLE_FILEWATCHER=true
XDG_DATA_HOME=/var/lib/orchestra-sf/home/REQUIRES_PRIVATE_CONFIG_DIR/host-data
XDG_CONFIG_HOME=/var/lib/orchestra-sf/home/REQUIRES_PRIVATE_CONFIG_DIR/host-config
XDG_CACHE_HOME=/var/lib/orchestra-sf/home/REQUIRES_PRIVATE_CONFIG_DIR/host-cache
XDG_STATE_HOME=/var/lib/orchestra-sf/home/REQUIRES_PRIVATE_CONFIG_DIR/host-state
TMPDIR=/var/lib/orchestra-sf/home/REQUIRES_PRIVATE_CONFIG_DIR/host-tmp
