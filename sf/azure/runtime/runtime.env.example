# Install as /etc/orchestra-sf/runtime.env (root:root, mode 0600).
# Use the private installation directory provisioned for the orchestra-sf service user.
SUCAFINA_MICROSOFT_CONFIG=/var/lib/orchestra-sf/home/installation/installation.json
ORCHESTRA_CONFIG_DIR=/var/lib/orchestra-sf/home/installation/host-config
ORCHESTRA_DB=/var/lib/orchestra-sf/home/installation/host-data/orchestra.db
ORCHESTRA_CREDENTIAL_KEY_FILE=/var/lib/orchestra-sf/home/installation/host-credential.key
ORCHESTRA_INHERIT_CREDENTIALS=0
ORCHESTRA_DISABLE_PROJECT_CONFIG=1
ORCHESTRA_EXPERIMENTAL_DISABLE_FILEWATCHER=true
XDG_DATA_HOME=/var/lib/orchestra-sf/home/installation/host-data
XDG_CONFIG_HOME=/var/lib/orchestra-sf/home/installation/host-config
XDG_CACHE_HOME=/var/lib/orchestra-sf/home/installation/host-cache
XDG_STATE_HOME=/var/lib/orchestra-sf/home/installation/host-state
TMPDIR=/var/lib/orchestra-sf/home/installation/host-tmp
